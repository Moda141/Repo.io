<mvc:View controllerName="repoio.proto.controller.Domains"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:f="sap.f" xmlns:core="sap.ui.core">
	<!-- SAP Datasphere "Space Management" layout: one card per domain -->
	<f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="true" class="repoioDsp">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="{i18n>nav.domains}" level="H1"/></f:heading>
				<f:snappedContent><Text text="{view>/domains/summary}"/></f:snappedContent>
				<f:actions>
					<ObjectStatus text="{i18n>common.sample}" state="Warning" inverted="true"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<FlexBox wrap="Wrap" alignItems="End">
					<HBox alignItems="Center" class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
						<Label text="{i18n>domains.kpi.domains}" class="sapUiTinyMarginEnd"/>
						<Title text="{view>/domains/count}" level="H3" class="sapUiSmallMarginEnd"/>
						<core:Icon src="sap-icon://group" color="#0a6ed1" class="sapUiTinyMarginEnd" tooltip="{i18n>domain.owner}"/>
						<Text text="{view>/domains/owners}" class="sapUiSmallMarginEnd"/>
						<core:Icon src="sap-icon://sys-enter-2" color="#107e3e" class="sapUiTinyMarginEnd" tooltip="{i18n>health.healthy}"/>
						<Text text="{view>/domains/healthy}" class="sapUiSmallMarginEnd"/>
						<core:Icon src="sap-icon://alert" color="#e9730c" class="sapUiTinyMarginEnd" tooltip="{i18n>health.attention}"/>
						<Text text="{view>/domains/attention}" class="sapUiSmallMarginEnd"/>
						<core:Icon src="sap-icon://border" color="#6a6d70" class="sapUiTinyMarginEnd" tooltip="{i18n>domains.noRepo}"/>
						<Text text="{view>/domains/empty}"/>
					</HBox>
					<VBox width="10.5rem" class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
						<Label text="{i18n>space.goldenUsed}"/>
						<ProgressIndicator percentValue="{view>/domains/capPct}" displayValue="{view>/domains/capText}" state="Information" displayOnly="true" height="1rem"/>
					</VBox>
					<VBox width="10.5rem" class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
						<Label text="{i18n>dsp.reposPublished}"/>
						<ProgressIndicator percentValue="{view>/domains/pubPct}" displayValue="{view>/domains/pubText}" state="Success" displayOnly="true" height="1rem"/>
					</VBox>
					<VBox width="10.5rem" class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
						<Label text="{i18n>domain.avgQuality}"/>
						<ProgressIndicator percentValue="{view>/domains/quality}" displayValue="{view>/domains/qualityText}" state="Warning" displayOnly="true" height="1rem"/>
					</VBox>
					<VBox width="10.5rem" class="sapUiSmallMarginBottom">
						<Label text="{i18n>space.sourcesUsed}"/>
						<ProgressIndicator percentValue="{view>/domains/srcPct}" displayValue="{view>/domains/srcText}" state="Information" displayOnly="true" height="1rem"/>
					</VBox>
				</FlexBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox>
				<OverflowToolbar style="Clear" class="sapUiSmallMarginBottom">
					<ToolbarSpacer/>
					<Button text="{i18n>common.create}" type="Transparent" press=".onCreate"/>
					<Button text="{i18n>common.edit}" type="Transparent" enabled="{= ${view>/domains/selected} === 1 }" press=".onEdit"/>
					<Button text="{i18n>common.delete}" type="Transparent" enabled="{= ${view>/domains/selected} > 0 }" press=".onDelete"/>
					<Button text="{i18n>dsp.lock}" type="Transparent" enabled="{= ${view>/domains/selected} > 0 }"/>
					<Button text="{i18n>dsp.unlock}" type="Transparent" enabled="{= ${view>/domains/selected} > 0 }"/>
					<Button text="{i18n>space.monitor}" type="Transparent" press=".onMonitor"/>
					<ToolbarSeparator/>
					<SegmentedButton selectedKey="{view>/domains/mode}">
						<items>
							<SegmentedButtonItem key="cards" icon="sap-icon://grid" tooltip="{i18n>domain.cards}"/>
							<SegmentedButtonItem key="table" icon="sap-icon://list" tooltip="{i18n>domain.table}"/>
						</items>
					</SegmentedButton>
					<SearchField width="14rem" liveChange=".onSearch" placeholder="{i18n>common.search}"/>
				</OverflowToolbar>

				<f:GridContainer items="{view>/domains/items}" visible="{= ${view>/domains/mode} === 'cards' }">
					<f:layout><f:GridContainerSettings rowSize="5rem" columnSize="3.75rem" gap="0.75rem"/></f:layout>
					<f:items>
						<f:Card>
							<f:layoutData><f:GridContainerItemLayoutData columns="4" minRows="4"/></f:layoutData>
							<f:content>
								<VBox class="repoioSpaceCard" width="100%">
									<HBox justifyContent="SpaceBetween" alignItems="Start">
										<VBox>
											<Link text="{view>techName}" press=".onDomainPress" class="repoioSpaceCode"/>
											<Label text="{view>title}"/>
										</VBox>
										<CheckBox selected="{view>selected}" select=".onCardSelect"/>
									</HBox>
									<core:HTML content="&lt;div class='repoioSpaceDivider'&gt;&lt;/div&gt;"/>
									<ObjectStatus text="{view>healthText}" state="{view>healthState}" icon="{view>healthIcon}"/>
									<Text text="{view>updatedText}" class="sapUiTinyMarginTop sapUiSmallMarginBottom"/>
									<Label text="{i18n>domains.col.golden}:"/>
									<ProgressIndicator percentValue="{view>capPct}" displayValue="{view>capText}" state="Information" displayOnly="true" height="0.875rem" class="sapUiSmallMarginBottom"/>
									<Label text="{i18n>domains.col.quality}:"/>
									<ProgressIndicator percentValue="{= ${view>quality} || 0 }" displayValue="{path: 'view>quality', formatter: '.fmt.pct'}" state="{view>qualityState}" displayOnly="true" height="0.875rem" class="sapUiSmallMarginBottom"/>
									<HBox><GenericTag text="{view>teamText}" design="StatusIconHidden"/></HBox>
									<HBox justifyContent="SpaceBetween" alignItems="Center" class="repoioSpaceFoot">
										<HBox alignItems="Center">
											<core:Icon src="sap-icon://badge" class="sapUiTinyMarginEnd" tooltip="{i18n>domains.col.repos}"/><Text text="{view>repoCount}" class="sapUiSmallMarginEnd"/>
											<core:Icon src="sap-icon://connected" class="sapUiTinyMarginEnd" tooltip="{i18n>domains.col.sources}"/><Text text="{view>sourceCount}" class="sapUiSmallMarginEnd"/>
											<core:Icon src="sap-icon://group" class="sapUiTinyMarginEnd" tooltip="{i18n>repo.owners}"/><Text text="{view>ownerCount}"/>
										</HBox>
										<Button text="{i18n>common.edit}" press=".onDomainPress"/>
									</HBox>
								</VBox>
							</f:content>
						</f:Card>
					</f:items>
				</f:GridContainer>

				<Table id="domainsTable" items="{view>/domains/items}" mode="MultiSelect" popinLayout="GridSmall" selectionChange=".onTableSelect"
					visible="{= ${view>/domains/mode} === 'table' }">
					<columns>
						<Column width="22%"><Text text="{i18n>dsp.technicalName}"/></Column>
						<Column><Text text="{i18n>dsp.businessName}"/></Column>
						<Column><Text text="{i18n>domains.col.status}"/></Column>
						<Column hAlign="End"><Text text="{i18n>domains.col.repos}"/></Column>
						<Column minScreenWidth="Tablet" demandPopin="true" width="16%"><Text text="{i18n>domains.col.golden}"/></Column>
						<Column hAlign="End"><Text text="{i18n>domains.col.quality}"/></Column>
						<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>domains.col.team}"/></Column>
						<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>domains.col.updated}"/></Column>
					</columns>
					<items>
						<ColumnListItem type="Navigation" press=".onDomainPress">
							<Link text="{view>techName}" press=".onDomainPress" class="repoioIdLink"/>
							<Text text="{view>title}"/>
							<ObjectStatus text="{view>healthText}" state="{view>healthState}" icon="{view>healthIcon}"/>
							<Text text="{view>repoCount}"/>
							<ProgressIndicator percentValue="{view>capPct}" displayValue="{view>capText}" state="Information" displayOnly="true" height="0.875rem"/>
							<ObjectNumber number="{path: 'view>quality', formatter: '.fmt.pct'}" state="{view>qualityState}"/>
							<Text text="{view>teamText}"/>
							<Text text="{view>updated}"/>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
