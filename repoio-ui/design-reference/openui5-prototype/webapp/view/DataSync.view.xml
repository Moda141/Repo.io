<mvc:View controllerName="repoio.proto.controller.DataSync"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" height="100%">
	<!-- J15: replication flow editor, laid out like the SAP Datasphere replication flow editor:
	     grouped toolbar (General / Edit / Tools, Details); three columns: source (connection, container,
	     objects) · Projections / Settings · target (repository, model, objects); properties panel on Details. -->
	<VBox height="100%" renderType="Bare" class="repoioDsRf">
		<!-- Toolbar with labelled groups -->
		<HBox class="repoioDsTb" alignItems="Start" renderType="Bare">
			<Button icon="sap-icon://nav-back" type="Transparent" tooltip="{i18n>common.back}" press=".onBack" class="repoioDsBack"/>
			<VBox class="repoioDsTbGrp" renderType="Bare">
				<Text text="{i18n>ds.tb.general}" class="repoioDsTbLbl"/>
				<HBox>
					<Button icon="sap-icon://save" type="Transparent" tooltip="{i18n>common.save}" press=".onSave" enabled="{view>/sf/dirty}"/>
					<Button icon="sap-icon://upload-to-cloud" type="Transparent" tooltip="{i18n>ds.deploy}" press=".onDeploy" enabled="{= !${view>/sf/isNew} &amp;&amp; (${view>/sf/status} !== 'deployed' || ${view>/sf/dirty}) }"/>
					<Button icon="sap-icon://media-play" type="Transparent" tooltip="{i18n>ds.run}" press=".onRun" enabled="{= ${view>/sf/status} === 'deployed' || ${view>/sf/status} === 'changed' }"/>
				</HBox>
			</VBox>
			<VBox class="repoioDsTbGrp" renderType="Bare">
				<Text text="{i18n>ds.tb.edit}" class="repoioDsTbLbl"/>
				<HBox>
					<Button text="{i18n>ds.addProjection}" type="Transparent" press=".onProjection" enabled="{= ${view>/sf/selIdx} > -1 &amp;&amp; !${view>/sf/o/projection} }"/>
				</HBox>
			</VBox>
			<VBox class="repoioDsTbGrp" renderType="Bare">
				<Text text="{i18n>ds.tb.tools}" class="repoioDsTbLbl"/>
				<HBox>
					<Button icon="sap-icon://validate" type="Transparent" tooltip="{i18n>ds.validate}" press=".onValidate"/>
					<Button id="sfMsgBtn" icon="sap-icon://message-popup" text="{view>/sf/msgCount}" type="{view>/sf/msgType}" press=".onMessages" visible="{= ${view>/sf/msgs}.length > 0 }"/>
					<Button icon="sap-icon://inspection" type="Transparent" tooltip="{i18n>ds.monitor}" press=".onMonitor" enabled="{= !!${view>/sf/lastRun} }"/>
				</HBox>
			</VBox>
			<HBox class="repoioDsTbRight" alignItems="Center" renderType="Bare">
				<Text text="{view>/sf/titleText}" class="repoioDsTbTitle" wrapping="false"/>
				<ToggleButton text="{i18n>ds.details}" pressed="{view>/sf/details}" type="Emphasized"/>
			</HBox>
		</HBox>

		<HBox class="repoioDsBody" renderType="Bare">
			<ScrollContainer vertical="true" height="100%" class="repoioDsCanvas">
				<!-- Column headers: source · projections/settings · target -->
				<HBox class="repoioDsGrid repoioDsHead" renderType="Bare">
					<VBox class="repoioDsCell" renderType="Bare">
						<HBox alignItems="Center" class="repoioDsHeadRow">
							<Link text="{view>/sf/connLine}" press=".onConn" visible="{= !!${view>/sf/f/conn} }" wrapping="false" class="repoioDsHeadTxt"/>
							<Text text="{i18n>ds.noConn}" visible="{= !${view>/sf/f/conn} }" class="repoioDsMuted repoioDsHeadTxt"/>
							<Button icon="sap-icon://connected" type="Transparent" tooltip="{i18n>ds.pickConn}" press=".onPickConn" enabled="{= ${view>/sf/f/objects}.length === 0 }"/>
						</HBox>
						<HBox alignItems="Center" class="repoioDsHeadRow">
							<Text text="{view>/sf/f/container}" class="repoioMono repoioDsHeadTxt" wrapping="false" visible="{= !!${view>/sf/f/container} }"/>
							<Text text="{i18n>ds.noContainer}" class="repoioDsMuted repoioDsHeadTxt" visible="{= !${view>/sf/f/container} }"/>
							<Button icon="sap-icon://folder-blank" type="Transparent" tooltip="{i18n>ds.pickContainer}" press=".onPickContainer" enabled="{= !!${view>/sf/f/conn} &amp;&amp; ${view>/sf/f/objects}.length === 0 }"/>
						</HBox>
					</VBox>
					<HBox class="repoioDsCell repoioDsMidHead" alignItems="End" renderType="Bare">
						<IconTabHeader selectedKey="{view>/sf/mid}" mode="Inline" class="repoioDsTabs" backgroundDesign="Transparent">
							<items>
								<IconTabFilter key="projections" text="{view>/sf/pjTab}"/>
								<IconTabFilter key="settings" text="{i18n>ds.tab.settings}"/>
							</items>
						</IconTabHeader>
					</HBox>
					<VBox class="repoioDsCell" renderType="Bare">
						<HBox alignItems="Center" class="repoioDsHeadRow">
							<Text text="{view>/sf/repoText}" class="repoioDsHeadTxt" wrapping="false" visible="{= !!${view>/sf/repoText} }"/>
							<Text text="{i18n>ds.noTarget}" class="repoioDsMuted repoioDsHeadTxt" visible="{= !${view>/sf/repoText} }"/>
							<Button icon="sap-icon://database" type="Transparent" tooltip="{i18n>ds.pickTarget}" press=".onPickTarget" enabled="{= ${view>/sf/f/objects}.length === 0 }"/>
							<Button icon="sap-icon://action-settings" type="Transparent" tooltip="{i18n>ds.targetSettings}" press=".onTargetSettings" enabled="{= !!${view>/sf/f/repo} }"/>
						</HBox>
						<HBox alignItems="Center" class="repoioDsHeadRow">
							<Text text="{view>/sf/targetContainer}" class="repoioDsHeadTxt" wrapping="false"/>
							<core:Icon src="sap-icon://folder-blank" class="repoioDsHeadIcon"/>
						</HBox>
					</VBox>
				</HBox>

				<!-- Replication objects: one row per object across the three columns -->
				<Table id="sfObjects" items="{view>/sf/rows}" mode="SingleSelectMaster" selectionChange=".onObjSelect" fixedLayout="true"
					class="repoioDsTable" noDataText="{view>/sf/emptyText}">
					<columns>
						<Column width="31%">
							<HBox alignItems="Center" class="repoioDsColHead">
								<Text text="{view>/sf/srcObjTitle}" wrapping="false"/>
								<Button icon="sap-icon://add" type="Transparent" tooltip="{i18n>ds.addObjects}" press=".onAddObjects" enabled="{= !!${view>/sf/f/container} }"/>
								<SearchField value="{view>/sf/qSrc}" liveChange=".onRowSearch" width="9rem" class="repoioDsSearch"/>
							</HBox>
						</Column>
						<Column width="38%" hAlign="Center">
							<HBox justifyContent="SpaceAround" alignItems="Center" class="repoioDsColHead" visible="{= ${view>/sf/mid} === 'settings' }">
								<Text text="{i18n>ds.col.load}"/>
								<Text text="{i18n>ds.truncateLbl}"/>
							</HBox>
						</Column>
						<Column width="31%">
							<HBox alignItems="Center" class="repoioDsColHead">
								<Text text="{i18n>ds.objectsT}"/>
								<SearchField value="{view>/sf/qTgt}" liveChange=".onRowSearch" width="10rem" class="repoioDsSearch"/>
							</HBox>
						</Column>
					</columns>
					<items>
						<ColumnListItem>
							<HBox alignItems="Center" class="repoioDsObj">
								<core:Icon src="sap-icon://table-view" class="repoioDsObjIcon"/>
								<Text text="{view>srcLabel}" wrapping="false" class="repoioDsObjTxt"/>
								<core:Icon src="sap-icon://hint" tooltip="{view>srcInfo}" visible="{view>sel}" class="repoioDsRowAct"/>
								<Button icon="sap-icon://sys-cancel" type="Transparent" tooltip="{i18n>ds.removeObject}" press=".onRemoveRow" visible="{view>sel}" class="repoioDsRowBtn"/>
							</HBox>
							<HBox justifyContent="Center" alignItems="Center">
								<!-- Projections -->
								<HBox alignItems="Center" class="repoioDsChip" visible="{= ${view>/sf/mid} === 'projections' &amp;&amp; ${view>projection} }">
									<Text text="{view>pjName}" wrapping="false" class="repoioDsChipName"/>
									<Text text="{view>nFilters}" class="repoioDsChipNum"/>
									<core:Icon src="sap-icon://filter" class="repoioDsChipIcon"/>
									<Text text="{view>nMap}" class="repoioDsChipNum"/>
									<core:Icon src="sap-icon://combine" class="repoioDsChipIcon" color="{= ${view>missing} ? '#bb0000' : '' }" tooltip="{view>mapTip}"/>
									<Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>common.edit}" press=".onRowProjection"/>
									<Button icon="sap-icon://sys-cancel" type="Transparent" tooltip="{i18n>common.delete}" press=".onRowRemoveProjection"/>
								</HBox>
								<Link text="{i18n>ds.addProjection}" press=".onRowProjection" visible="{= ${view>/sf/mid} === 'projections' &amp;&amp; !${view>projection} &amp;&amp; ${view>sel} }"/>
								<!-- Settings -->
								<HBox justifyContent="SpaceAround" alignItems="Center" width="100%" visible="{= ${view>/sf/mid} === 'settings' }">
									<Select selectedKey="{view>load}" change=".onRowSetting" width="11rem">
										<core:Item key="initial" text="{i18n>ds.load.initial}"/>
										<core:Item key="delta" text="{i18n>ds.load.delta}" enabled="{= ${view>/sf/delta} !== 'upload' }"/>
									</Select>
									<CheckBox selected="{view>truncate}" select=".onRowSetting" tooltip="{i18n>ds.truncateWarn}"/>
								</HBox>
							</HBox>
							<HBox alignItems="Center" class="repoioDsObj">
								<core:Icon src="sap-icon://dimension" class="repoioDsObjIcon"/>
								<Text text="{view>tgtLabel}" wrapping="false" class="{= ${view>isNewTarget} ? 'repoioDsObjTxt repoioDsNew' : 'repoioDsObjTxt' }"/>
								<core:Icon src="sap-icon://error" color="#bb0000" tooltip="{view>mapTip}" visible="{view>missing}" class="repoioDsRowAct"/>
								<Button icon="sap-icon://overflow" type="Transparent" tooltip="{i18n>ds.moreOptions}" press=".onTargetOptions" class="repoioDsRowBtn repoioDsMore"/>
							</HBox>
						</ColumnListItem>
					</items>
				</Table>
			</ScrollContainer>

			<!-- Properties (Details) -->
			<ScrollContainer vertical="true" height="100%" width="22rem" visible="{view>/sf/details}" class="repoioDsProps">
				<HBox alignItems="Center" class="repoioDsPropsHead">
					<Text text="{= ${view>/sf/selIdx} > -1 ? ${i18n>ds.objPropsT} : ${i18n>ds.flowPropsT} }"/>
					<Button icon="sap-icon://decline" type="Transparent" tooltip="{i18n>common.close}" press=".onCloseDetails" class="repoioRfEndBtn"/>
				</HBox>
				<HBox alignItems="Center" class="repoioDsPropsTitle">
					<Text text="{= ${view>/sf/selIdx} > -1 ? ${view>/sf/o/source} : (${view>/sf/f/id} || ${i18n>ds.untitled}) }" class="repoioMono"/>
					<Button icon="sap-icon://validate" type="Transparent" tooltip="{i18n>ds.validate}" press=".onValidate" class="repoioRfEndBtn"/>
				</HBox>
				<!-- Flow -->
				<VBox renderType="Bare" visible="{= ${view>/sf/selIdx} === -1 }">
					<Panel headerText="{i18n>ds.sec.general}" expandable="true" expanded="true" class="repoioDsPanel">
						<Label text="{i18n>dsp.businessName}" showColon="true"/>
						<Input value="{view>/sf/name}" liveChange=".onName" valueLiveUpdate="true"/>
						<Label text="{i18n>dsp.technicalName}" showColon="true" class="sapUiTinyMarginTop"/>
						<Input value="{view>/sf/f/id}" editable="false"/>
						<Label text="{i18n>domains.col.status}" showColon="true" class="sapUiTinyMarginTop"/>
						<ObjectStatus text="{view>/sf/statusText}" state="{view>/sf/statusState}" icon="{view>/sf/statusIcon}"/>
						<Label text="{i18n>domain.owner}" showColon="true" class="sapUiTinyMarginTop"/>
						<Text text="{view>/sf/ownerText}"/>
					</Panel>
					<Panel headerText="{i18n>ds.sec.run}" expandable="true" expanded="true" class="repoioDsPanel">
						<Label text="{i18n>ds.loadFrequency}" showColon="true"/>
						<Text text="{i18n>ds.iv.upload}" visible="{= ${view>/sf/delta} === 'upload' }"/>
						<HBox alignItems="Center" visible="{= ${view>/sf/delta} !== 'upload' }">
							<StepInput value="{view>/sf/hours}" min="0" max="24" width="6rem" change=".onInterval"/>
							<Text text="{i18n>ds.hours}" class="sapUiTinyMarginBegin sapUiSmallMarginEnd"/>
							<StepInput value="{view>/sf/minutes}" min="0" max="59" step="15" width="6rem" change=".onInterval"/>
							<Text text="{i18n>ds.minutes}" class="sapUiTinyMarginBegin"/>
						</HBox>
					</Panel>
					<Panel headerText="{i18n>ds.sec.runStatus}" expandable="true" expanded="true" class="repoioDsPanel">
						<Label text="{i18n>domains.col.status}" showColon="true"/>
						<ObjectStatus text="{view>/sf/fact/last}" state="{view>/sf/fact/lastState}" icon="{view>/sf/fact/lastIcon}"/>
					</Panel>
				</VBox>
				<!-- Object -->
				<VBox renderType="Bare" visible="{= ${view>/sf/selIdx} > -1 }">
					<Panel headerText="{i18n>ds.sec.general}" expandable="true" expanded="true" class="repoioDsPanel">
						<Label text="{i18n>ds.col.srcObj}" showColon="true"/>
						<Text text="{view>/sf/o/source}" class="repoioMono"/>
						<Label text="{i18n>ds.col.tgtObj}" showColon="true" class="sapUiTinyMarginTop"/>
						<Text text="{= ${view>/sf/o/entity} + ' · ' + ${view>/sf/oEntityText} }"/>
						<Label text="{i18n>ds.deltaMethod}" showColon="true" class="sapUiTinyMarginTop"/>
						<Text text="{view>/sf/deltaText}"/>
					</Panel>
					<Panel headerText="{i18n>ds.tab.projections}" expandable="true" expanded="true" class="repoioDsPanel">
						<Text text="{view>/sf/oMapText}"/>
						<MessageStrip text="{view>/sf/oMissing}" type="Error" showIcon="true" visible="{= !!${view>/sf/oMissing} }" class="sapUiTinyMarginTop"/>
					</Panel>
					<Panel headerText="{i18n>ds.sec.runStatus}" expandable="true" expanded="true" class="repoioDsPanel">
						<Label text="{i18n>ds.initialRecs}" showColon="true"/>
						<Text text="{view>/sf/oInitial}"/>
						<Label text="{i18n>ds.deltaRecs}" showColon="true" class="sapUiTinyMarginTop"/>
						<Text text="{view>/sf/oDelta}"/>
						<Label text="{i18n>ds.rejectedRecs}" showColon="true" class="sapUiTinyMarginTop"/>
						<Text text="{view>/sf/oRejected}"/>
					</Panel>
				</VBox>
			</ScrollContainer>
		</HBox>
	</VBox>
</mvc:View>
