<mvc:View controllerName="repoio.proto.controller.Repository"
	xmlns="sap.m" xmlns:t="sap.ui.table" xmlns:trm="sap.ui.table.rowmodes" xmlns:mvc="sap.ui.core.mvc" xmlns:uxap="sap.uxap" xmlns:core="sap.ui.core" xmlns:rc="repoio.proto.control">
	<!-- Repository, laid out like an SAP S/4HANA Cloud object page with tabs (Repo.io look): header with the repository
	     facts, big status figures and overview bars; tabs General information, Attributes, Golden records (with the
	     record rating and its explanation), Data sources and Tables. Read only: model changes go through Models & rules,
	     golden records through change requests; Connection details per ADR-0006. -->
	<uxap:ObjectPageLayout id="op" useIconTabBar="true" upperCaseAnchorBar="false" showFooter="false" headerContentPinnable="true"
		toggleHeaderOnTitleClick="true" class="repoioGrOp repoioRp">
		<uxap:headerTitle>
			<uxap:ObjectPageDynamicHeaderTitle>
				<uxap:breadcrumbs>
					<Breadcrumbs currentLocationText="{view>/rp/name}">
						<Link text="{i18n>nav.domains}" press=".onToCatalog"/>
						<Link text="{view>/rp/domainText}" press=".onToDomain"/>
					</Breadcrumbs>
				</uxap:breadcrumbs>
				<uxap:heading><Title text="{view>/rp/name}" level="H1" wrapping="true"/></uxap:heading>
				<uxap:expandedContent><Text text="{view>/rp/code}" class="repoioUmMuted repoioMono"/></uxap:expandedContent>
				<uxap:snappedHeading>
					<HBox alignItems="Center" renderType="Bare">
						<Avatar src="{view>/rp/icon}" displayShape="Square" displaySize="XS" class="sapUiSmallMarginEnd"/>
						<Title text="{view>/rp/name}" level="H1" wrapping="false"/>
					</HBox>
				</uxap:snappedHeading>
				<uxap:snappedContent><GenericTag text="{view>/rp/healthText}" status="{view>/rp/healthState}" design="Full" class="repoioSitTag"/></uxap:snappedContent>
				<uxap:actions>
					<Button text="{i18n>rc.open}" type="Transparent" press=".onConnect" enabled="{view>/rp/deployed}"/>
					<Button text="{i18n>rp.openGolden}" type="Transparent" visible="{view>/rp/hasGoldenList}" press=".onOpenGolden"/>
					<Button text="{i18n>rp.openModel}" type="Transparent" visible="{view>/rp/hasModel}" press=".onOpenModel"/>
					<Button icon="sap-icon://action" type="Transparent" tooltip="{i18n>cat.copyLink}" press=".onCopyLink"/>
				</uxap:actions>
				<uxap:navigationActions>
					<Button icon="sap-icon://decline" type="Transparent" tooltip="{i18n>go.close}" press=".onToCatalog"/>
				</uxap:navigationActions>
			</uxap:ObjectPageDynamicHeaderTitle>
		</uxap:headerTitle>

		<uxap:headerContent>
			<FlexBox wrap="Wrap" alignItems="Start" class="repoioRpHead">
				<Avatar src="{view>/rp/icon}" displayShape="Square" displaySize="L" class="repoioGoAvatar"/>
				<VBox class="repoioRpPairs" renderType="Bare">
					<HBox class="repoioRpPair" renderType="Bare"><Label text="{i18n>domains.col.domain}" showColon="true"/><Link text="{view>/rp/domainText}" press=".onToDomain"/></HBox>
					<HBox class="repoioRpPair" renderType="Bare"><Label text="{i18n>repo.model}" showColon="true"/><Text text="{view>/rp/model}"/></HBox>
					<HBox class="repoioRpPair" renderType="Bare"><Label text="{i18n>repo.deployed}" showColon="true"/><Text text="{view>/rp/deployedText}" textDirection="LTR"/></HBox>
					<HBox class="repoioRpPair" alignItems="Center" renderType="Bare">
						<Label text="{i18n>repo.owners}" showColon="true"/>
						<rc:PersonGroup names="{view>/rp/ownerNames}" title="{i18n>repo.owners}" class="repoioRpOwners"/>
					</HBox>
					<HBox wrap="Wrap" renderType="Bare" items="{path: 'view>/rp/tags', templateShareable: false}" class="repoioTbChips">
						<ObjectStatus text="{view>text}" icon="{view>icon}" class="repoioClassTag repoioClassChip"/>
					</HBox>
				</VBox>
				<!-- Big figures, like "Request priority / Request status" -->
				<HBox renderType="Bare" class="repoioRpBig" items="{path: 'view>/rp/big', templateShareable: false}">
					<VBox renderType="Bare" class="repoioRpBigItem">
						<Label text="{view>label}"/>
						<!-- Fiori header KPI: a status figure carries its semantic colour and icon, plain figures stay neutral -->
						<ObjectStatus text="{view>value}" state="{= ${view>state} || 'None' }" icon="{view>icon}" class="repoioRpBigVal repoioRpBigStatus" textDirection="{view>dir}"/>
					</VBox>
				</HBox>
				<!-- Overview bars, like "Assignment status overview" -->
				<VBox renderType="Bare" class="repoioRpBar">
					<Label text="{i18n>rp.capacity}"/>
					<core:HTML content="{view>/rp/capBar}"/>
				</VBox>
				<VBox renderType="Bare" class="repoioRpBar">
					<Label text="{i18n>rp.ratingOverview}"/>
					<HBox alignItems="Center" renderType="Bare">
						<RatingIndicator value="{view>/rp/avgStars}" maxValue="5" displayOnly="true" iconSize="1rem"/>
						<Text text="{view>/rp/avgText}" class="sapUiTinyMarginBegin repoioUmMuted"/>
					</HBox>
					<core:HTML content="{view>/rp/ratingBar}"/>
				</VBox>
			</FlexBox>
		</uxap:headerContent>

		<uxap:sections>
			<!-- General information -->
			<uxap:ObjectPageSection id="secGeneral" title="{i18n>rp.tab.general}" titleUppercase="false">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>rp.tab.general}" titleUppercase="false" showTitle="false">
						<FlexBox wrap="Wrap" class="repoioRpModel" renderType="Bare">
							<VBox class="repoioRpBlock" renderType="Bare">
								<Title text="{i18n>repo.sub.assigned}" level="H4" class="repoioGoSubTitle"/>
								<VBox items="{path: 'view>/rp/modelFacts', templateShareable: false}" renderType="Bare" class="repoioRpKv">
									<HBox class="repoioRpKvRow" renderType="Bare">
										<Label text="{view>label}" class="repoioRpKvLbl"/>
										<Text text="{view>value}" textDirection="{view>dir}" visible="{= !${view>person} }"/>
										<rc:PersonLink name="{view>person}" showName="true" visible="{= !!${view>person} }"/>
									</HBox>
								</VBox>
							</VBox>
							<VBox class="repoioRpBlock" renderType="Bare">
								<Title text="{i18n>repo.sub.matching}" level="H4" class="repoioGoSubTitle"/>
								<MessageStrip text="{i18n>rp.noModel}" type="Information" showIcon="true" visible="{= !${view>/rp/hasModel} }">
									<link><Link text="{i18n>rp.createModel}" press=".onOpenModel"/></link>
								</MessageStrip>
								<VBox visible="{view>/rp/hasModel}" items="{path: 'view>/rp/matchFacts', templateShareable: false}" renderType="Bare" class="repoioRpKv">
									<HBox class="repoioRpKvRow" renderType="Bare">
										<Label text="{view>label}" class="repoioRpKvLbl"/>
										<Text text="{view>value}" textDirection="{view>dir}"/>
									</HBox>
								</VBox>
							</VBox>
						</FlexBox>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>

			<!-- Attributes -->
			<uxap:ObjectPageSection id="secAttrs" title="{view>/rp/attrsTab}" titleUppercase="false">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{view>/rp/attrsTab}" titleUppercase="false" showTitle="false">
						<t:Table rows="{view>/rp/attrs}" selectionMode="None" enableColumnReordering="true" class="repoioGrid repoioGridCard" noData="{i18n>rp.noAttrs}">
							<t:rowMode><trm:Fixed rowCount="{= Math.max(1, Math.min(${view>/rp/attrs}.length, 15)) }" rowContentHeight="46"/></t:rowMode>
							<t:extension>
								<OverflowToolbar style="Clear">
																	<Title text="{view>/rp/attrsTitle}" level="H3" titleStyle="H5"/>
																	<ToolbarSpacer/>
																	<SearchField value="{view>/rp/aq}" liveChange=".onAttrSearch" placeholder="{i18n>lin.find}" width="14rem"/>
																	<Button text="{i18n>repo.requestChange}" type="Transparent" press=".onRequestModel"/>
																</OverflowToolbar>
							</t:extension>
							<t:columns>
								<t:Column minWidth="120">
									<t:label><Label text="{i18n>repo.attr}"/></t:label>
									<t:template><VBox renderType="Bare">
																			<HBox alignItems="Center" renderType="Bare">
																				<Text text="{view>label}" class="repoioGrName"/>
																				<ObjectStatus text="{i18n>rp.derived}" state="Information" inverted="true" visible="{view>derived}" class="repoioTbChip"/>
																			</HBox>
																			<Text text="{view>col}" class="repoioMono repoioUmMuted" textDirection="LTR"/>
																		</VBox></t:template>
								</t:Column>
								<t:Column width="8rem">
									<t:label><Label text="{i18n>repo.type}"/></t:label>
									<t:template><Text text="{view>kindText}"/></t:template>
								</t:Column>
								<t:Column minWidth="120">
									<t:label><Label text="{i18n>repo.matchRole}"/></t:label>
									<t:template><Text text="{view>role}"><customData><core:CustomData key="rc" value="{= ${view>role} === '—' ? 'muted' : 'none' }" writeToDom="true"/></customData></Text></t:template>
								</t:Column>
								<t:Column minWidth="120">
									<t:label><Label text="{i18n>repo.survivorship}"/></t:label>
									<t:template><Text text="{view>surv}"><customData><core:CustomData key="rc" value="{= ${view>surv} === '—' ? 'muted' : 'none' }" writeToDom="true"/></customData></Text></t:template>
								</t:Column>
							</t:columns>
						</t:Table>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>

			<!-- Golden records, like "Matching resources" -->
			<uxap:ObjectPageSection id="secGolden" title="{view>/rp/goldenTab}" titleUppercase="false">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>repo.sec.golden}" titleUppercase="false">
						<VBox renderType="Bare">
							<MessageStrip text="{i18n>rp.ratingNote}" type="Information" showIcon="true" showCloseButton="true" class="sapUiSmallMarginBottom"
								visible="{view>/rp/deployed}"/>
							<t:Table rows="{view>/rp/golden}" selectionMode="MultiToggle" enableColumnReordering="true" class="repoioGrid repoioGridCard" noData="{view>/rp/goldenEmpty}">
								<t:rowMode><trm:Fixed rowCount="{= Math.max(1, Math.min(${view>/rp/golden}.length, 15)) }" rowContentHeight="46"/></t:rowMode>
								<t:extension>
									<OverflowToolbar style="Clear">
																			<Title text="{view>/rp/goldenTitle}" level="H3" titleStyle="H5"/>
																			<ToolbarSpacer/>
																			<SearchField value="{view>/rp/gq}" liveChange=".onGoldenFilter" placeholder="{i18n>repo.goldenSearch}" width="14rem"/>
																			<SegmentedButton selectedKey="{view>/rp/gf}" selectionChange=".onGoldenFilter">
																				<items>
																					<SegmentedButtonItem key="all" text="{view>/rp/gc/all}"/>
																					<SegmentedButtonItem key="attn" text="{view>/rp/gc/attn}"/>
																				</items>
																			</SegmentedButton>
																			<Select selectedKey="{view>/rp/gsort}" change=".onGoldenFilter" width="11rem">
																				<core:Item key="rating" text="{i18n>rp.sort.rating}"/>
																				<core:Item key="quality" text="{i18n>rp.sort.quality}"/>
																				<core:Item key="name" text="{i18n>rp.sort.name}"/>
																			</Select>
																		</OverflowToolbar>
								</t:extension>
								<t:columns>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>hub.c.name}"/></t:label>
										<t:template><HBox alignItems="Center" renderType="Bare">
																					<Avatar src="{view>avatar}" displaySize="XS" displayShape="Circle" backgroundColor="Accent6" class="sapUiSmallMarginEnd"/>
																					<VBox renderType="Bare">
																						<Link text="{view>name}" press=".onGolden" enabled="{view>open}" wrapping="false"/>
																						<Text text="{view>id} · {view>sub}" class="repoioUmMuted" wrapping="false"/>
																					</VBox>
																				</HBox></t:template>
									</t:Column>
									<t:Column width="9.5rem" hAlign="Center">
										<t:label><Label text="{i18n>domains.col.quality}"/></t:label>
										<t:template><GenericTag text="{i18n>tag.dq}" status="{view>qualityState}" design="StatusIconHidden" class="repoioKpiTag"><value><ObjectNumber number="{view>qNum}" unit="%" state="{view>qualityState}" emphasized="false"/></value></GenericTag></t:template>
									</t:Column>
									<t:Column width="8rem" hAlign="End">
										<t:label><Label text="{i18n>repo.matchProb}"/></t:label>
										<t:template><Text text="{view>probText}" textDirection="LTR"/></t:template>
									</t:Column>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>repo.contributing}"/></t:label>
										<t:template><Text text="{view>srcText}"/></t:template>
									</t:Column>
									<t:Column width="10rem">
										<t:label><Label text="{i18n>gr.c.rating}"/></t:label>
										<t:template><HBox alignItems="Center" renderType="Bare" class="repoioRtCell">
																					<RatingIndicator value="{view>stars}" maxValue="5" displayOnly="true" iconSize="0.875rem" tooltip="{view>ratingTip}"/>
																					<Button icon="sap-icon://hint" type="Transparent" tooltip="{i18n>rt.why}" press=".onRating" class="repoioRtBtn"/>
																				</HBox></t:template>
									</t:Column>
									<t:Column width="9rem">
										<t:label><Label text="{i18n>domains.col.status}"/></t:label>
										<t:template><HBox renderType="Bare">
																					<GenericTag text="{view>stateText}" status="{view>state}" design="Full" visible="{= ${view>state} === 'Warning' || ${view>state} === 'Error' }" class="repoioSitTag"/>
																					<ObjectStatus text="{view>stateText}" state="{view>state}" icon="{view>stateIcon}" visible="{= ${view>state} !== 'Warning' &amp;&amp; ${view>state} !== 'Error' }"/>
																				</HBox></t:template>
									</t:Column>
									<t:Column width="14rem" hAlign="End">
										<t:label><Label text="{i18n>api.col.actions}" class="sapUiInvisibleText"/></t:label>
										<t:template><HBox justifyContent="End" renderType="Bare" class="repoioRpActs">
																					<Button text="{i18n>rp.a.open}" press=".onGolden" enabled="{view>open}"/>
																					<Button text="{i18n>rp.a.request}" press=".onRequestRecord"/>
																				</HBox></t:template>
									</t:Column>
								</t:columns>
							</t:Table>
						</VBox>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>

			<!-- Data sources -->
			<uxap:ObjectPageSection id="secSources" title="{view>/rp/sourcesTab}" titleUppercase="false">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>repo.sec.sources}" titleUppercase="false" showTitle="false">
						<t:Table rows="{view>/rp/sources}" selectionMode="None" enableColumnReordering="true" class="repoioGrid repoioGridCard" noData="{i18n>cds.none}">
							<t:extension>
								<OverflowToolbar style="Clear">
									<Title text="{view>/rp/sourcesTitle}" level="H3" titleStyle="H6"/>
									<ToolbarSpacer/>
									<Button text="{i18n>cds.button}" icon="sap-icon://add" type="Transparent" press=".onAddSource"/>
								</OverflowToolbar>
							</t:extension>
							<t:rowMode><trm:Fixed rowCount="{= Math.max(1, Math.min(${view>/rp/sources}.length, 15)) }" rowContentHeight="46"/></t:rowMode>
							<t:columns>
								<t:Column minWidth="120">
									<t:label><Label text="{i18n>repo.source}"/></t:label>
									<t:template><VBox renderType="Bare">
																			<HBox alignItems="Center" renderType="Bare">
																				<core:Icon src="sap-icon://connected" class="sapUiTinyMarginEnd" decorative="true"/>
																				<Text text="{view>name}" class="repoioGrName"/>
																			</HBox>
																			<Text text="{view>host}" class="repoioMono repoioUmMuted" textDirection="LTR"/>
																		</VBox></t:template>
								</t:Column>
								<t:Column minWidth="120">
									<t:label><Label text="{i18n>repo.connector}"/></t:label>
									<t:template><Text text="{view>type}"/></t:template>
								</t:Column>
								<t:Column width="5rem" hAlign="Center">
									<t:label><Label text="{i18n>rp.prio}"/></t:label>
									<t:template><ObjectNumber number="{view>priority}" emphasized="true"/></t:template>
								</t:Column>
								<t:Column minWidth="120" hAlign="End">
									<t:label><Label text="{i18n>repo.tables}"/></t:label>
									<t:template><Text text="{view>tables}" textDirection="LTR"/></t:template>
								</t:Column>
								<t:Column minWidth="120" hAlign="End">
									<t:label><Label text="{i18n>repo.rows}"/></t:label>
									<t:template><Text text="{view>rowsText}" textDirection="LTR"/></t:template>
								</t:Column>
								<t:Column minWidth="120" hAlign="Center">
									<t:label><Label text="{i18n>domains.col.quality}"/></t:label>
									<t:template><HBox renderType="Bare"><Text text="—" visible="{= ${view>qNum} === '—' }"/><GenericTag visible="{= ${view>qNum} !== '—' }" text="{i18n>tag.dq}" status="{view>qualityState}" design="StatusIconHidden" class="repoioKpiTag"><value><ObjectNumber number="{view>qNum}" unit="%" state="{view>qualityState}" emphasized="false"/></value></GenericTag></HBox></t:template>
								</t:Column>
								<t:Column minWidth="120">
									<t:label><Label text="{i18n>repo.contributes}"/></t:label>
									<t:template><Text text="{view>contribText}"/></t:template>
								</t:Column>
								<t:Column minWidth="120">
									<t:label><Label text="{i18n>repo.lastSync}"/></t:label>
									<t:template><Text text="{view>sync}" textDirection="LTR"/></t:template>
								</t:Column>
								<t:Column minWidth="120">
									<t:label><Label text="{i18n>domains.col.status}"/></t:label>
									<t:template><ObjectStatus text="{view>stateText}" state="{view>state}" icon="{view>stateIcon}"/></t:template>
								</t:Column>
							</t:columns>
						</t:Table>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>

			<!-- Tables -->
			<uxap:ObjectPageSection id="secTables" title="{view>/rp/tablesTab}" titleUppercase="false">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>rp.sec.tables}" titleUppercase="false" showTitle="false">
						<t:Table rows="{view>/rp/tables}" selectionMode="None" enableColumnReordering="true" class="repoioGrid repoioGridCard">
							<t:rowMode><trm:Fixed rowCount="{= Math.max(1, Math.min(${view>/rp/tables}.length, 15)) }" rowContentHeight="46"/></t:rowMode>
							<t:rowActionTemplate><t:RowAction><t:RowActionItem type="Navigation" press=".onTable"/></t:RowAction></t:rowActionTemplate>
							<t:columns>
								<t:Column minWidth="120">
									<t:label><Label text="{i18n>src.table}"/></t:label>
									<t:template><HBox alignItems="Center" renderType="Bare">
																			<core:Icon src="sap-icon://table-view" class="sapUiTinyMarginEnd" decorative="true"/>
																			<VBox renderType="Bare">
																				<Link text="{view>name}" press=".onTable"/>
																				<Text text="{view>path}" class="repoioMono repoioUmMuted" textDirection="LTR"/>
																			</VBox>
																		</HBox></t:template>
								</t:Column>
								<t:Column minWidth="120">
									<t:label><Label text="{i18n>repo.source}"/></t:label>
									<t:template><Text text="{view>sourceName}"/></t:template>
								</t:Column>
								<t:Column minWidth="120" hAlign="End">
									<t:label><Label text="{i18n>repo.rows}"/></t:label>
									<t:template><Text text="{view>rowsText}" textDirection="LTR"/></t:template>
								</t:Column>
								<t:Column minWidth="120" hAlign="End">
									<t:label><Label text="{i18n>src.columns}"/></t:label>
									<t:template><Text text="{view>cols}" textDirection="LTR"/></t:template>
								</t:Column>
								<t:Column minWidth="120" hAlign="Center">
									<t:label><Label text="{i18n>domains.col.quality}"/></t:label>
									<t:template><GenericTag text="{i18n>tag.dq}" status="{view>qualityState}" design="StatusIconHidden" class="repoioKpiTag"><value><ObjectNumber number="{view>qNum}" unit="%" state="{view>qualityState}" emphasized="false"/></value></GenericTag></t:template>
								</t:Column>
								<t:Column minWidth="120">
									<t:label><Label text="{i18n>src.profiled}"/></t:label>
									<t:template><Text text="{view>profiled}" textDirection="LTR"/></t:template>
								</t:Column>
							</t:columns>
						</t:Table>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
		</uxap:sections>
	</uxap:ObjectPageLayout>
</mvc:View>
