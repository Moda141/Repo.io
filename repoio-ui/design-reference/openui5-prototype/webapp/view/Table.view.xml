<mvc:View controllerName="repoio.proto.controller.Table"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:uxap="sap.uxap" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table" xmlns:rc="repoio.proto.control">
	<uxap:ObjectPageLayout id="page" useIconTabBar="true" showTitleInHeaderContent="true" upperCaseAnchorBar="false" headerContentPinnable="true">
		<uxap:headerTitle>
			<uxap:ObjectPageDynamicHeaderTitle>
				<uxap:breadcrumbs>
					<Breadcrumbs currentLocationText="{view>/table/schema} / {view>/table/name}">
						<Link text="{i18n>nav.domains}" press=".onToDomains"/>
						<Link text="{view>/table/domainName}" press=".onToDomain"/>
						<Link text="{view>/table/repoName}" press=".onToRepo"/>
						<Link text="{view>/table/sourceName}" press=".onToSource"/>
					</Breadcrumbs>
				</uxap:breadcrumbs>
				<uxap:expandedHeading><Title text="{view>/table/name}" level="H1"/></uxap:expandedHeading>
				<uxap:snappedHeading><Title text="{view>/table/name}" level="H1"/></uxap:snappedHeading>
				<uxap:expandedContent><Text text="{i18n>src.table} · {view>/table/sourceName} / {view>/table/schema}"/></uxap:expandedContent>
				<uxap:actions>
					<Button icon="sap-icon://save" type="Transparent" tooltip="{i18n>common.save}"/>
					<Button icon="sap-icon://upload-to-cloud" type="Transparent" tooltip="{i18n>dsp.deploy}"/>
					<Button icon="sap-icon://undo" type="Transparent" tooltip="{i18n>dsp.undo}"/>
					<Button icon="sap-icon://redo" type="Transparent" tooltip="{i18n>dsp.redo}"/>
					<ToolbarSeparator/>
					<Button icon="sap-icon://table-view" type="Transparent" tooltip="{i18n>dsp.dataPreview}" press=".onGoSection" app:sec="secSample" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"/>
					<Button icon="sap-icon://org-chart" type="Transparent" tooltip="{i18n>dsp.impact}" press=".onGoSection" app:sec="secLineage" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"/>
					<Button text="{i18n>tbl.runDq}"/>
					<Button text="{i18n>repo.requestChange}" press=".onRequestChange"/>
				</uxap:actions>
			</uxap:ObjectPageDynamicHeaderTitle>
		</uxap:headerTitle>
		<uxap:headerContent>
			<FlexBox wrap="Wrap" alignItems="Start">
				<Avatar src="sap-icon://table-view" displaySize="M" backgroundColor="Accent6" class="sapUiSmallMarginEnd"/>
				<VBox class="sapUiMediumMarginEnd" width="22rem">
					<HBox alignItems="Center" class="sapUiTinyMarginBottom"><Label text="{i18n>domain.owner}:" class="sapUiTinyMarginEnd"/><rc:PersonLink name="{view>/info/owner}"/></HBox>
					<HBox alignItems="Center"><Label text="{i18n>tbl.steward}:" class="sapUiTinyMarginEnd"/><rc:PersonLink name="{view>/info/steward}"/></HBox>
					<HBox items="{view>/info/tags}" class="sapUiTinyMarginTop">
						<GenericTag text="{view>}" design="StatusIconHidden" status="Information" class="sapUiTinyMarginEnd"/>
					</HBox>
					<ObjectAttribute title="{i18n>src.usedIn}" text="{view>/table/usedInText}" class="sapUiTinyMarginTop"/>
				</VBox>
				<VBox class="sapUiMediumMarginEnd">
					<Label text="{i18n>repo.rows}"/>
					<ObjectNumber number="{path: 'view>/table/rows', formatter: '.fmt.num'}" class="sapMObjectNumberLarge"/>
				</VBox>
				<VBox class="sapUiMediumMarginEnd">
					<Label text="{i18n>src.columns}"/>
					<ObjectNumber number="{view>/table/cols}" class="sapMObjectNumberLarge"/>
				</VBox>
				<VBox class="sapUiMediumMarginEnd">
					<Label text="{i18n>tbl.dqScore}"/>
					<ObjectNumber number="{path: 'view>/table/quality', formatter: '.fmt.pct'}" state="{view>/table/qualityState}" class="sapMObjectNumberLarge"/>
				</VBox>
				<VBox>
					<Label text="{i18n>src.profiled}"/>
					<Text text="{view>/table/profiled}" class="sapUiTinyMarginTop"/>
				</VBox>
			</FlexBox>
		</uxap:headerContent>
		<uxap:sections>
			<!-- Description -->
			<uxap:ObjectPageSection id="secDesc" title="{i18n>dsp.tableTab}" titleUppercase="false">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>dsp.general}" titleUppercase="false">
						<form:SimpleForm editable="true" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">
							<core:Title text="{i18n>dsp.general}"/>
							<Label text="{i18n>dsp.businessName}" required="true"/><Input value="{view>/table/name}"/>
							<Label text="{i18n>dsp.technicalName}"/><Input value="{view>/table/techName}" editable="false"/>
							<Label text="{i18n>dsp.semantic}"/><Select selectedKey="dimension"><core:Item key="dimension" text="{i18n>dsp.sem.dimension}"/><core:Item key="fact" text="{i18n>dsp.sem.fact}"/><core:Item key="relational" text="{i18n>dsp.sem.relational}"/></Select>
							<Label text="{i18n>dsp.deployStatus}"/><ObjectStatus text="{i18n>status.deployed}" state="Success" icon="sap-icon://sys-enter-2"/>
							<Label text="{i18n>tbl.sec.desc}"/><TextArea value="{view>/info/desc}" rows="3" growing="true"/>
							<core:Title text="{i18n>tbl.ownership}"/>
							<Label text="{i18n>domain.owner}"/><rc:PersonLink name="{view>/info/owner}"/>
							<Label text="{i18n>tbl.steward}"/><rc:PersonLink name="{view>/info/steward}"/>
							<Label text="{i18n>domains.col.domain}"/><Link text="{view>/table/domainName}" press=".onToDomain"/>
							<Label text="{i18n>repo.repository}"/><Link text="{view>/table/repoName}" press=".onToRepo"/>
							<Label text="{i18n>src.dataSource}"/><Link text="{view>/table/sourceName}" press=".onToSource"/>
							<Label text="Schema"/><Text text="{view>/table/schema}"/>
							<core:Title text="{i18n>tbl.classification}"/>
							<Label text="{i18n>tbl.terms}"/><Text text="{view>/info/termsText}"/>
							<Label text="{i18n>tbl.tags}"/><Text text="{view>/info/tagsText}"/>
							<Label text="{i18n>tbl.sensitivity}"/><ObjectStatus text="{view>/info/sensitivity}" state="Warning" icon="sap-icon://locked"/>
							<Label text="{i18n>tbl.retention}"/><Text text="{view>/info/retention}"/>
						</form:SimpleForm>
					</uxap:ObjectPageSubSection>
					<uxap:ObjectPageSubSection title="{i18n>src.columns}" titleUppercase="false">
						<Table items="{view>/info/columns}" popinLayout="GridSmall" mode="MultiSelect">
							<headerToolbar>
								<OverflowToolbar>
									<Title text="{i18n>src.columns} ({view>/info/columns/length})" level="H3"/>
									<ToolbarSpacer/>
									<Button text="{i18n>tbl.linkTerm}" type="Transparent"/>
								</OverflowToolbar>
							</headerToolbar>
							<columns>
								<Column width="4.5rem" hAlign="Center"><Text text="{i18n>dsp.key}"/></Column>
								<Column width="20%"><Text text="{i18n>tbl.column}"/></Column>
								<Column><Text text="{i18n>dsp.dataType}"/></Column>
								<Column hAlign="Center"><Text text="{i18n>dsp.notNull}"/></Column>
								<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>tbl.term}"/></Column>
								<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>domains.col.repos}"/></Column>
								<Column minScreenWidth="Desktop" demandPopin="true" width="24%"><Text text="{i18n>tbl.modelAttrs}"/></Column>
								<Column hAlign="End"><Text text="{i18n>tbl.empty}"/></Column>
							</columns>
							<items>
								<ColumnListItem>
									<core:Icon src="{= ${view>name} === 'CustomerID' ? 'sap-icon://key' : '' }" color="Critical"/>
									<ObjectIdentifier title="{view>name}" text="{view>desc}"/>
									<Text text="{view>dataType}"/>
									<CheckBox selected="{view>required}" editable="false"/>
									<Text text="{= ${view>term} || ${i18n>tbl.notLinked} }"/>
									<Text text="{view>reposText}"/>
									<Text text="{view>attrsText}"/>
									<ObjectNumber number="{path: 'view>nullPct', formatter: '.fmt.pct'}" state="{view>nullState}"/>
								</ColumnListItem>
							</items>
						</Table>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>

			<!-- Sample data: Grid Table -->
			<uxap:ObjectPageSection id="secSample" title="{i18n>dsp.dataPreview}" titleUppercase="false">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>dsp.dataPreview}" titleUppercase="false" showTitle="false">
						<t:Table id="sampleTable" rows="{view>/info/sample}" selectionMode="MultiToggle" visibleRowCount="8" enableColumnReordering="true"
							columns="{path: 'view>/info/columns', factory: '.columnFactory'}" ariaLabelledBy="sampleTitle">
							<t:extension>
								<OverflowToolbar style="Clear">
									<Title id="sampleTitle" text="{i18n>tbl.sampleTitle}" level="H3"/>
									<ToolbarSpacer/>
									<Text text="{i18n>tbl.sampleNote}" class="repoioMuted"/>
								</OverflowToolbar>
							</t:extension>
						</t:Table>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>

			<!-- Data quality review -->
			<uxap:ObjectPageSection id="secDq" title="{i18n>tbl.sec.dq}" titleUppercase="false">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>tbl.dqSummary}" titleUppercase="false">
						<VBox>
							<FlexBox wrap="Wrap" alignItems="Start">
								<VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
									<Label text="{i18n>tbl.dqScore}"/>
									<ObjectNumber number="{path: 'view>/info/score', formatter: '.fmt.pct'}" state="{view>/info/scoreState}" class="sapMObjectNumberLarge"/>
								</VBox>
								<VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
									<Label text="{i18n>home.target}"/>
									<ObjectNumber number="{view>/info/target}" unit="%" class="sapMObjectNumberLarge"/>
								</VBox>
								<VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
									<Label text="{i18n>home.deviation}"/>
									<ObjectNumber number="{view>/info/deviation}" state="Error" class="sapMObjectNumberLarge"/>
								</VBox>
								<VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
									<Label text="{i18n>tbl.sinceYesterday}"/>
									<ObjectNumber number="{view>/info/delta}" state="Success" class="sapMObjectNumberLarge"/>
								</VBox>
								<VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
									<Label text="{i18n>tbl.failedTests}"/>
									<ObjectNumber number="{view>/info/failed}" unit="{i18n>common.of} {view>/info/tests/length}" state="Error" class="sapMObjectNumberLarge"/>
								</VBox>
							</FlexBox>
							<rc:EChart id="trendChart" height="12rem" width="40rem" ariaLabel="{i18n>tbl.trend}"/>
							<MessageStrip text="{i18n>tbl.formula}" type="Information" showIcon="true" class="sapUiSmallMarginTop"/>
							<MessageStrip text="{i18n>tbl.opportunity}" type="Warning" showIcon="true" class="sapUiSmallMarginTop"/>
						</VBox>
					</uxap:ObjectPageSubSection>
					<uxap:ObjectPageSubSection title="{i18n>tbl.dims}" titleUppercase="false">
						<Table items="{view>/info/dims}" popinLayout="GridSmall">
							<columns>
								<Column width="30%"><Text text="{i18n>tbl.dim}"/></Column>
								<Column hAlign="End"><Text text="{i18n>tbl.weight}"/></Column>
								<Column hAlign="End"><Text text="{i18n>tbl.score}"/></Column>
								<Column minScreenWidth="Tablet" demandPopin="true" width="20%"><Text text="{i18n>tbl.vsTarget}"/></Column>
								<Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>tbl.contribution}"/></Column>
								<Column hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>tbl.tests}"/></Column>
							</columns>
							<items>
								<ColumnListItem>
									<ObjectIdentifier title="{view>label}" text="{view>desc}"/>
									<ObjectNumber number="{view>weight}" unit="%"/>
									<ObjectNumber number="{path: 'view>value', formatter: '.fmt.pct'}" state="{view>state}"/>
									<ProgressIndicator percentValue="{view>value}" displayValue="{path: 'view>value', formatter: '.fmt.pct'}" state="{view>state}" displayOnly="true" height="0.75rem"/>
									<ObjectNumber number="{view>contribution}" unit="/ {view>weight}"/>
									<ObjectNumber number="{view>tests}"/>
								</ColumnListItem>
							</items>
						</Table>
					</uxap:ObjectPageSubSection>
					<uxap:ObjectPageSubSection title="{i18n>tbl.testsTitle}" titleUppercase="false">
						<Table id="testsTable" items="{view>/info/tests}" popinLayout="GridSmall" mode="MultiSelect" noDataText="{i18n>tbl.noTests}">
							<headerToolbar>
								<OverflowToolbar>
									<SegmentedButton selectionChange=".onTestFilter" selectedKey="all">
										<items>
											<SegmentedButtonItem key="all" text="{i18n>common.all}"/>
											<SegmentedButtonItem key="neg" text="{i18n>result.neg}"/>
											<SegmentedButtonItem key="crit" text="{i18n>result.crit}"/>
											<SegmentedButtonItem key="pos" text="{i18n>result.pos}"/>
										</items>
									</SegmentedButton>
									<ToolbarSpacer/>
									<Button text="{i18n>tbl.addRule}" type="Transparent"/>
									<Button text="{i18n>tbl.runAll}" type="Transparent"/>
								</OverflowToolbar>
							</headerToolbar>
							<columns>
								<Column width="34%"><Text text="{i18n>tbl.rule}"/></Column>
								<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>tbl.column}"/></Column>
								<Column><Text text="{i18n>src.result}"/></Column>
								<Column hAlign="End"><Text text="{i18n>tbl.failedRows}"/></Column>
								<Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>tbl.failedPct}"/></Column>
								<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>tbl.lastRun}"/></Column>
							</columns>
							<items>
								<ColumnListItem>
									<Text text="{view>rule}"/>
									<Text text="{view>column}"/>
									<ObjectStatus text="{path: 'view>stateKey', formatter: '.resultText'}" state="{view>state}" icon="{= ${view>stateKey} === 'pos' ? 'sap-icon://sys-enter-2' : ${view>stateKey} === 'neg' ? 'sap-icon://error' : 'sap-icon://alert' }"/>
									<ObjectNumber number="{path: 'view>failed', formatter: '.fmt.num'}"/>
									<ObjectNumber number="{view>failedPct}"/>
									<Text text="{view>date}"/>
								</ColumnListItem>
							</items>
						</Table>
					</uxap:ObjectPageSubSection>
					<uxap:ObjectPageSubSection title="{i18n>tbl.completeness}" titleUppercase="false">
						<Table items="{path: 'view>/info/columns', sorter: {path: 'nullPct', descending: true}}" popinLayout="GridSmall">
							<columns>
								<Column width="26%"><Text text="{i18n>tbl.column}"/></Column>
								<Column><Text text="{i18n>repo.type}"/></Column>
								<Column><Text text="{i18n>repo.required}"/></Column>
								<Column hAlign="End"><Text text="{i18n>tbl.empty}"/></Column>
								<Column minScreenWidth="Tablet" demandPopin="true" width="28%"><Text text="{i18n>tbl.complete}"/></Column>
							</columns>
							<items>
								<ColumnListItem>
									<ObjectIdentifier title="{view>name}" text="{view>desc}"/>
									<GenericTag text="{view>type}" design="StatusIconHidden"/>
									<Text text="{= ${view>required} ? ${i18n>common.yes} : ${i18n>common.no} }"/>
									<ObjectNumber number="{path: 'view>nullPct', formatter: '.fmt.pct'}" state="{view>nullState}"/>
									<ProgressIndicator percentValue="{view>completeness}" displayValue="{path: 'view>completeness', formatter: '.fmt.pct'}" state="{view>nullState}" displayOnly="true" height="0.75rem"/>
								</ColumnListItem>
							</items>
						</Table>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>

			<!-- Lineage -->
			<uxap:ObjectPageSection id="secLineage" title="{i18n>dsp.impact}" titleUppercase="false">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title="{i18n>dsp.impact}" titleUppercase="false">
						<VBox>
							<rc:LineageGraph id="lineage" columns="{view>/info/lineage}" edges="{view>/info/edges}" typeLabels="{view>/info/lineageTypes}" nodeSelect=".onLineageNode"/>
							<Text text="{i18n>tbl.lineageNote}" class="repoioMuted"/>
						</VBox>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
		</uxap:sections>
	</uxap:ObjectPageLayout>
</mvc:View>
