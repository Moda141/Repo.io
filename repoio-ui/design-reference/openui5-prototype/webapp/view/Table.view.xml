<mvc:View controllerName="repoio.proto.controller.Table"
	xmlns="sap.m" xmlns:t="sap.ui.table" xmlns:trm="sap.ui.table.rowmodes" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:rc="repoio.proto.control" height="100%">
	<!-- Source table, laid out like the SAP Datasphere Data Builder table editor (Repo.io look): grouped toolbar, title,
	     tabs (General, Columns, Associations, Business purpose, Data quality, Dependent objects) and a data preview
	     docked at the bottom (Data / Errors). Read only: the source system owns the table; descriptions and terms are
	     changed through a request, quality checks run as a Great Expectations job. -->
	<VBox height="100%" renderType="Bare" class="repoioTb">
		<HBox class="repoioDsTb" alignItems="Start" renderType="Bare">
			<Button icon="sap-icon://nav-back" type="Transparent" tooltip="{i18n>common.back}" press=".onBack" class="repoioDsBack"/>
			<VBox class="repoioDsTbGrp" renderType="Bare">
				<Text text="{i18n>ds.tb.general}" class="repoioDsTbLbl"/>
				<HBox>
					<Button icon="sap-icon://chain-link" type="Transparent" tooltip="{i18n>cat.copyLink}" press=".onCopyLink"/>
					<Button icon="sap-icon://excel-attachment" type="Transparent" tooltip="{i18n>tb.exportCols}" press=".onExport"/>
				</HBox>
			</VBox>
			<VBox class="repoioDsTbGrp" renderType="Bare">
				<Text text="{i18n>tb.tb.view}" class="repoioDsTbLbl"/>
				<HBox>
					<ToggleButton icon="sap-icon://table-view" type="Transparent" tooltip="{i18n>tb.preview}" pressed="{view>/tb/preview}"/>
				</HBox>
			</VBox>
			<VBox class="repoioDsTbGrp" renderType="Bare">
				<Text text="{i18n>ds.tb.tools}" class="repoioDsTbLbl"/>
				<HBox>
					<Button icon="sap-icon://quality-issue" type="Transparent" tooltip="{i18n>tbl.runDq}" press=".onRunDq"/>
					<Button icon="sap-icon://request" type="Transparent" tooltip="{i18n>tb.requestChange}" press=".onRequest"/>
				</HBox>
			</VBox>
			<HBox class="repoioDsTbRight" alignItems="Center" renderType="Bare">
				<ObjectStatus text="{view>/tb/storageText}" icon="{view>/tb/storageIcon}" class="sapUiSmallMarginEnd"/>
				<GenericTag text="{i18n>domains.col.quality}" status="{view>/tb/qualityState}" design="StatusIconHidden" class="repoioKpiTag"><value><ObjectNumber number="{view>/tb/qNum}" unit="%" state="{view>/tb/qualityState}" emphasized="false"/></value></GenericTag>
			</HBox>
		</HBox>

		<ScrollContainer vertical="true" horizontal="false" height="100%" class="repoioTbMain">
			<VBox renderType="Bare" class="repoioTbHead">
				<Breadcrumbs currentLocationText="{view>/tb/name}" class="repoioTbCrumbs">
					<Link text="{i18n>nav.domains}" press=".onToCatalog"/>
					<Link text="{view>/tb/sourceName}" press=".onToSource"/>
					<Link text="{view>/tb/schema}" press=".onToSource"/>
				</Breadcrumbs>
				<HBox alignItems="Center" renderType="Bare">
					<core:Icon src="sap-icon://table-view" size="1.25rem" class="repoioTbIco" decorative="true"/>
					<Title text="{view>/tb/name}" level="H1" titleStyle="H3" wrapping="true"/>
				</HBox>
			</VBox>
			<IconTabBar id="tbTabs" selectedKey="{view>/tb/tab}" expandable="false" headerBackgroundDesign="Solid" backgroundDesign="Transparent"
				applyContentPadding="false" class="repoioTbTabs">
				<items>
					<!-- General -->
					<IconTabFilter key="general" text="{i18n>tb.tab.general}">
						<VBox class="repoioTbCard" renderType="Bare">
							<FlexBox wrap="Wrap" class="repoioTbFields" renderType="Bare" items="{path: 'view>/tb/general', templateShareable: false}">
								<VBox class="repoioTbField" renderType="Bare">
									<Label text="{view>label}"/>
									<Text text="{view>value}" textDirection="{view>dir}" visible="{= ${view>type} === 'text' }" class="{= ${view>mono} ? 'repoioMono' : '' }"/>
									<Switch state="{view>on}" enabled="false" visible="{= ${view>type} === 'switch' }" customTextOn=" " customTextOff=" "/>
									<rc:PersonLink name="{view>value}" visible="{= ${view>type} === 'person' }"/>
								</VBox>
							</FlexBox>
						</VBox>
					</IconTabFilter>

					<!-- Columns -->
					<IconTabFilter key="columns" text="{view>/tb/colsTab}">
						<VBox class="repoioTbCard" renderType="Bare">
							<t:Table rows="{view>/tb/columns}" selectionMode="None" enableColumnReordering="true" class="repoioGrid repoioGridCard" noData="{i18n>lin.noColumns}">
								<t:rowMode><trm:Fixed rowCount="{= Math.max(1, Math.min(${view>/tb/columns}.length, 15)) }" rowContentHeight="46"/></t:rowMode>
								<t:extension>
									<OverflowToolbar style="Clear">
																			<Title text="{view>/tb/colsTab}" level="H2" titleStyle="H5"/>
																			<ToolbarSpacer/>
																			<SearchField value="{view>/tb/cq}" liveChange=".onColSearch" placeholder="{i18n>lin.find}" width="14rem"/>
																		</OverflowToolbar>
								</t:extension>
								<t:columns>
									<t:Column width="2.5rem" hAlign="Center">
										<t:label><Label text=""/></t:label>
										<t:template><core:Icon src="sap-icon://key" visible="{view>key}" tooltip="{i18n>tb.key}" class="repoioTbKey"/></t:template>
									</t:Column>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>tb.c.name}"/></t:label>
										<t:template><VBox renderType="Bare">
																					<HBox alignItems="Center" renderType="Bare">
																						<Text text="{view>label}" class="repoioGrName"/>
																						<GenericTag text="{i18n>tb.pii}" status="Warning" design="Full" visible="{view>pii}" class="repoioSitTag"/>
																					</HBox>
																					<Text text="{view>name}" class="repoioMono repoioUmMuted" textDirection="LTR"/>
																				</VBox></t:template>
									</t:Column>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>tb.c.type}"/></t:label>
										<t:template><Text text="{view>type}" class="repoioMono" textDirection="LTR"/></t:template>
									</t:Column>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>tb.c.notNull}"/></t:label>
										<t:template><Text text="{= ${view>notNull} ? ${i18n>common.yes} : ${i18n>common.no} }"/></t:template>
									</t:Column>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>tbl.term}"/></t:label>
										<t:template><Text text="{= ${view>termText} || ${i18n>tbl.notLinked} }" class="{= ${view>termText} ? '' : 'repoioUmMuted' }"/></t:template>
									</t:Column>
									<t:Column minWidth="120" hAlign="End">
										<t:label><Label text="{i18n>tbl.empty}"/></t:label>
										<t:template><GenericTag text="{i18n>tag.empty}" status="{view>nullState}" design="StatusIconHidden" class="repoioKpiTag"><value><ObjectNumber number="{view>nullNum}" unit="%" state="{view>nullState}" emphasized="false"/></value></GenericTag></t:template>
									</t:Column>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>src.usedIn}"/></t:label>
										<t:template><Text text="{view>usedText}"/></t:template>
									</t:Column>
								</t:columns>
							</t:Table>
						</VBox>
					</IconTabFilter>

					<!-- Associations -->
					<IconTabFilter key="assoc" text="{view>/tb/assocTab}">
						<VBox class="repoioTbCard" renderType="Bare">
							<t:Table rows="{view>/tb/associations}" selectionMode="None" enableColumnReordering="true" class="repoioGrid repoioGridCard" noData="{i18n>tb.noAssoc}">
								<t:rowMode><trm:Fixed rowCount="{= Math.max(1, Math.min(${view>/tb/associations}.length, 15)) }"/></t:rowMode>
								<t:columns>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>tb.a.name}"/></t:label>
										<t:template><Text text="{view>name}" class="repoioMono" textDirection="LTR"/></t:template>
									</t:Column>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>tb.a.target}"/></t:label>
										<t:template><HBox alignItems="Center" renderType="Bare">
																					<core:Icon src="sap-icon://table-view" class="sapUiTinyMarginEnd" decorative="true"/>
																					<Link text="{view>targetName}" press=".onAssoc"/>
																				</HBox></t:template>
									</t:Column>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>tb.a.on}"/></t:label>
										<t:template><Text text="{view>on}" class="repoioMono" textDirection="LTR"/></t:template>
									</t:Column>
								</t:columns>
							</t:Table>
						</VBox>
					</IconTabFilter>

					<!-- Business purpose -->
					<IconTabFilter key="purpose" text="{i18n>tb.tab.purpose}">
						<VBox class="repoioTbCard" renderType="Bare">
							<Label text="{i18n>tbl.sec.desc}"/>
							<Text text="{view>/tb/desc}" class="repoioTbDesc"/>
							<Text text="{view>/tb/descUpdated}" class="repoioUmMuted sapUiSmallMarginBottom"/>
							<FlexBox wrap="Wrap" class="repoioTbFields" renderType="Bare">
								<VBox class="repoioTbField" renderType="Bare">
									<Label text="{i18n>tbl.terms}"/>
									<HBox wrap="Wrap" renderType="Bare" class="repoioTbChips" items="{path: 'view>/tb/terms', templateShareable: false}">
										<ObjectStatus text="{view>text}" state="Information" icon="sap-icon://course-book" inverted="true" class="repoioTbChip"/>
									</HBox>
									<Text text="{i18n>tbl.notLinked}" visible="{= ${view>/tb/terms}.length === 0 }" class="repoioUmMuted"/>
								</VBox>
								<VBox class="repoioTbField" renderType="Bare">
									<Label text="{i18n>tbl.sensitivity}"/>
									<ObjectStatus text="{view>/tb/sensText}" state="{view>/tb/sensState}" icon="sap-icon://shield"/>
								</VBox>
								<VBox class="repoioTbField" renderType="Bare">
									<Label text="{i18n>tbl.retention}"/>
									<Text text="{view>/tb/retention}"/>
								</VBox>
								<VBox class="repoioTbField" renderType="Bare">
									<Label text="{i18n>domain.owner}"/>
									<rc:PersonLink name="{view>/tb/owner}"/>
								</VBox>
								<VBox class="repoioTbField" renderType="Bare">
									<Label text="{i18n>tbl.steward}"/>
									<rc:PersonLink name="{view>/tb/steward}"/>
								</VBox>
							</FlexBox>
							<MessageStrip text="{i18n>tb.purposeNote}" type="Information" showIcon="true" class="sapUiSmallMarginTop"/>
						</VBox>
					</IconTabFilter>

					<!-- Data quality -->
					<IconTabFilter key="dq" text="{i18n>tbl.sec.dq}">
						<VBox class="repoioTbCard" renderType="Bare">
							<FlexBox wrap="Wrap" class="repoioTbKpis" renderType="Bare" items="{path: 'view>/tb/kpis', templateShareable: false}">
								<VBox class="repoioTbKpi" renderType="Bare">
									<Label text="{view>label}"/>
									<ObjectNumber number="{view>value}" unit="{view>unit}" state="{view>state}" emphasized="true" class="sapMObjectNumberLarge" textDirection="LTR"/>
								</VBox>
							</FlexBox>
							<rc:EChart id="tbTrend" height="9rem" ariaLabel="{i18n>tbl.trend}"/>
							<Text text="{i18n>tbl.formula}" class="repoioUmMuted sapUiSmallMarginBottom"/>
						</VBox>
						<VBox class="repoioTbCard" renderType="Bare">
							<Title text="{i18n>tbl.dims}" level="H3" titleStyle="H5" class="sapUiSmallMarginBottom"/>
							<VBox renderType="Bare" items="{path: 'view>/tb/dims', templateShareable: false}" class="repoioTbDims">
								<HBox alignItems="Center" class="repoioTbDim" renderType="Bare">
									<VBox class="repoioTbDimName" renderType="Bare">
										<Text text="{view>label}" class="repoioGrName"/>
										<Text text="{view>weightText}" class="repoioUmMuted"/>
									</VBox>
									<core:HTML content="{view>bar}"/>
									<GenericTag text="{i18n>tag.score}" status="{view>state}" design="StatusIconHidden" class="repoioKpiTag repoioTbDimVal"><value><ObjectNumber number="{view>num}" unit="%" state="{view>state}" emphasized="false"/></value></GenericTag>
								</HBox>
							</VBox>
						</VBox>
						<VBox class="repoioTbCard" renderType="Bare">
							<t:Table rows="{view>/tb/tests}" selectionMode="None" enableColumnReordering="true" class="repoioGrid repoioGridCard" noData="{i18n>tbl.noTests}">
								<t:rowMode><trm:Fixed rowCount="{= Math.max(1, Math.min(${view>/tb/tests}.length, 15)) }"/></t:rowMode>
								<t:extension>
									<OverflowToolbar style="Clear">
																			<Title text="{view>/tb/testsTitle}" level="H3" titleStyle="H5"/>
																			<ToolbarSpacer/>
																			<SegmentedButton selectedKey="{view>/tb/tf}" selectionChange=".onTestFilter">
																				<items>
																					<SegmentedButtonItem key="all" text="{view>/tb/tc/all}"/>
																					<SegmentedButtonItem key="fail" text="{view>/tb/tc/fail}"/>
																					<SegmentedButtonItem key="warn" text="{view>/tb/tc/warn}"/>
																					<SegmentedButtonItem key="pass" text="{view>/tb/tc/pass}"/>
																				</items>
																			</SegmentedButton>
																		</OverflowToolbar>
								</t:extension>
								<t:columns>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>tbl.rule}"/></t:label>
										<t:template><Text text="{view>rule}" class="repoioGrName"/></t:template>
									</t:Column>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>tbl.column}"/></t:label>
										<t:template><Text text="{view>column}" class="repoioMono" textDirection="LTR"/></t:template>
									</t:Column>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>tb.result}"/></t:label>
										<t:template><GenericTag text="{view>resultText}" status="{view>state}" design="Full" class="repoioSitTag"/></t:template>
									</t:Column>
									<t:Column minWidth="120" hAlign="End">
										<t:label><Label text="{i18n>tbl.failedRows}"/></t:label>
										<t:template><Text text="{view>failedText}" textDirection="LTR"/></t:template>
									</t:Column>
									<t:Column minWidth="120" hAlign="End">
										<t:label><Label text="{i18n>tbl.failedPct}"/></t:label>
										<t:template><Text text="{view>pctText}" textDirection="LTR"/></t:template>
									</t:Column>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>tbl.lastRun}"/></t:label>
										<t:template><Text text="{view>date}" textDirection="LTR"/></t:template>
									</t:Column>
								</t:columns>
							</t:Table>
						</VBox>
					</IconTabFilter>

					<!-- Dependent objects -->
					<IconTabFilter key="deps" text="{view>/tb/depsTab}">
						<VBox class="repoioTbCard" renderType="Bare">
							<t:Table rows="{view>/tb/deps}" selectionMode="None" enableColumnReordering="true" class="repoioGrid repoioGridCard" noData="{i18n>tb.noDeps}">
								<t:rowMode><trm:Fixed rowCount="{= Math.max(1, Math.min(${view>/tb/deps}.length, 15)) }"/></t:rowMode>
								<t:columns>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>repo.repository}"/></t:label>
										<t:template><HBox alignItems="Center" renderType="Bare">
																					<core:Icon src="sap-icon://badge" class="sapUiTinyMarginEnd" decorative="true"/>
																					<Link text="{view>name}" press=".onDep"/>
																				</HBox></t:template>
									</t:Column>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>domains.col.domain}"/></t:label>
										<t:template><Text text="{view>domain}"/></t:template>
									</t:Column>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>repo.model}"/></t:label>
										<t:template><Text text="{view>model}"/></t:template>
									</t:Column>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>tb.d.cols}"/></t:label>
										<t:template><Text text="{view>colsText}" class="repoioMono" textDirection="LTR"/></t:template>
									</t:Column>
									<t:Column minWidth="120">
										<t:label><Label text="{i18n>domains.col.status}"/></t:label>
										<t:template><ObjectStatus text="{view>statusText}" state="{view>state}"/></t:template>
									</t:Column>
								</t:columns>
							</t:Table>
						</VBox>
					</IconTabFilter>
				</items>
			</IconTabBar>
		</ScrollContainer>

		<!-- Data preview docked at the bottom -->
		<VBox visible="{view>/tb/preview}" renderType="Bare" class="repoioTbPrev">
			<customData><core:CustomData key="max" value="{= ${view>/tb/max} ? 'on' : 'off' }" writeToDom="true"/></customData>
			<HBox alignItems="Center" class="repoioTbPrevBar" renderType="Bare">
				<IconTabHeader selectedKey="{view>/tb/pv}" mode="Inline" backgroundDesign="Transparent" class="repoioTbPrevTabs">
					<items>
						<IconTabFilter key="data" text="{view>/tb/dataTab}"/>
						<IconTabFilter key="errors" text="{view>/tb/errTab}"/>
					</items>
				</IconTabHeader>
				<HBox class="repoioTbPrevActs" renderType="Bare">
					<Text text="{i18n>tbl.sampleNote}" class="repoioUmMuted sapUiSmallMarginEnd"/>
					<Button icon="{= ${view>/tb/max} ? 'sap-icon://exit-full-screen' : 'sap-icon://full-screen' }" type="Transparent"
						tooltip="{= ${view>/tb/max} ? ${i18n>tb.restore} : ${i18n>tb.maximize} }" press=".onMax"/>
					<Button icon="sap-icon://decline" type="Transparent" tooltip="{i18n>go.close}" press=".onClosePreview"/>
				</HBox>
			</HBox>
			<VBox renderType="Bare" class="repoioTbPrevBody">
				<VBox id="tbDataBox" renderType="Bare" height="100%" visible="{= ${view>/tb/pv} === 'data' }" class="repoioTbGridBox"/>
				<VBox id="tbErrBox" renderType="Bare" height="100%" visible="{= ${view>/tb/pv} === 'errors' }" class="repoioTbGridBox"/>
			</VBox>
		</VBox>
	</VBox>
</mvc:View>
