<mvc:View controllerName="repoio.proto.controller.WorkflowDesigner"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:rc="repoio.proto.control"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<!-- New workflow (J7) — Repo.io flow designer (ADR-0002): card nodes on a canvas, properties on the side.
	     The flow compiles to BPMN 2.0 for Flowable; the engine, versions and audit do not change. -->
	<Page id="page" showHeader="false" enableScrolling="false" class="repoioOntoPage repoioWfPage">
		<VBox class="repoioOnto" renderType="Bare" height="100%">
			<OverflowToolbar class="repoioOntoHeader" design="Transparent" height="3.25rem">
				<core:Icon src="sap-icon://process" class="repoioOntoHeaderIcon" decorative="true"/>
				<Link text="{i18n>wf.crumb}" press=".onWorkflows"/>
				<Text text="/" class="repoioWfSlash"/>
				<Link text="{view>/wf/name}" press=".onShowWorkflow" class="repoioWfTitleLink"/>
				<ObjectStatus text="{view>/wf/statusText}" state="{= ${view>/wf/state} === 'published' ? 'Success' : ${view>/wf/state} === 'review' ? 'Warning' : 'Information' }" inverted="true"/>
				<ObjectStatus visible="{view>/wf/dirty}" text="{i18n>wf.unsaved}" icon="sap-icon://edit" state="Warning"/>
				<ToolbarSpacer/>
				<SegmentedButton selectedKey="{path: 'view>/wf/mode', mode: 'OneWay'}" selectionChange=".onMode" class="repoioWfMode">
					<items>
						<SegmentedButtonItem key="design" text="{i18n>fd.mode.design}" icon="sap-icon://edit"/>
						<SegmentedButtonItem key="runs" text="{i18n>fd.mode.runs}" icon="sap-icon://line-chart" enabled="{view>/wf/hasPublished}"/>
					</items>
				</SegmentedButton>
				<ToolbarSeparator/>
				<Button icon="sap-icon://undo" type="Transparent" tooltip="{i18n>wf.undo}" press=".onUndo" enabled="{= ${view>/wf/canUndo} &amp;&amp; !${view>/wf/readOnly} }"/>
				<Button icon="sap-icon://redo" type="Transparent" tooltip="{i18n>wf.redo}" press=".onRedo" enabled="{= ${view>/wf/canRedo} &amp;&amp; !${view>/wf/readOnly} }"/>
				<MenuButton text="{i18n>fd.new}" icon="sap-icon://add-document" type="Transparent" visible="{= ${view>/wf/mode} === 'design' }">
					<menu>
						<Menu itemSelected=".onCopyFrom">
							<MenuItem text="{i18n>fd.blank}" icon="sap-icon://document" press=".onNewBlank"/>
							<MenuItem text="{i18n>fd.copyFrom}" icon="sap-icon://copy" startsSection="true" items="{view>/wf/catalog}">
								<items><MenuItem text="{view>text}" icon="sap-icon://process" app:key="{view>key}"/></items>
							</MenuItem>
						</Menu>
					</menu>
				</MenuButton>
				<ToolbarSeparator/>
				<Button text="{i18n>wf.save}" icon="sap-icon://save" type="Transparent" press=".onSave" enabled="{= !${view>/wf/readOnly} }"/>
				<Button id="validateBtn" text="{= ${view>/wf/issueCount} ? ${i18n>onto.validate} + ' (' + ${view>/wf/issueCount} + ')' : ${i18n>onto.validate} }" icon="sap-icon://validate"
					type="{= ${view>/wf/issueCount} ? 'Negative' : 'Transparent' }" press=".onValidate"/>
				<Button text="{i18n>fd.test.btn}" icon="sap-icon://media-play" type="Transparent" press=".onTestRun" visible="{= ${view>/wf/mode} === 'design' }"/>
				<Button text="{i18n>fd.cmp.btn}" icon="sap-icon://compare" type="Transparent" press=".onCompare" visible="{= ${view>/wf/mode} === 'design' }"/>
				<Button text="{i18n>wf.exportBpmn}" icon="sap-icon://download" type="Transparent" press=".onExport"/>
				<Button text="{i18n>fd.submit}" type="Emphasized" press=".onPublish" enabled="{= !${view>/wf/readOnly} }" visible="{= ${view>/wf/mode} === 'design' }"/>
				<ToggleButton icon="sap-icon://detail-view" tooltip="{i18n>wf.details}" pressed="{view>/wf/showProps}" type="Transparent"/>
			</OverflowToolbar>
			<MessageStrip visible="{= ${view>/wf/mode} === 'design' &amp;&amp; (${view>/wf/state} === 'published' || ${view>/wf/state} === 'retired') }" type="Information" showIcon="true"
				class="repoioOntoStrip" text="{view>/wf/roText}">
				<link><Link text="{i18n>wf.newVersion}" press=".onNewVersion"/></link>
			</MessageStrip>
			<HBox visible="{= ${view>/wf/mode} === 'design' &amp;&amp; ${view>/wf/state} === 'review' }" renderType="Bare" alignItems="Center" class="repoioOntoStrip repoioWfReview">
				<MessageStrip type="Warning" showIcon="true" text="{view>/wf/roText}" class="repoioWfReviewText"/>
				<Button text="{i18n>fd.approveAs}" icon="sap-icon://accept" type="Accept" press=".onApprovePublish" class="sapUiTinyMarginBegin"/>
				<Button text="{i18n>fd.rejectAs}" icon="sap-icon://decline" type="Reject" press=".onRejectPublish" class="sapUiTinyMarginBegin"/>
			</HBox>
			<MessageStrip visible="{= ${view>/wf/mode} === 'runs' }" type="Information" showIcon="true" class="repoioOntoStrip" text="{i18n>fd.runs.strip}"/>
			<MessageStrip visible="{= ${view>/wf/test/active} || ${view>/wf/compare/active} }" type="{= ${view>/wf/test/active} ? 'Success' : 'Warning' }" showIcon="true"
				class="repoioOntoStrip" text="{= ${view>/wf/test/active} ? ${i18n>fd.test.strip} : ${i18n>fd.cmp.strip} }">
				<link><Link text="{i18n>fd.clear}" press=".onClearOverlay"/></link>
			</MessageStrip>

			<HBox class="repoioOntoBody" renderType="Bare">
				<!-- Canvas -->
				<rc:FlowCanvas id="canvas" flow="{view>/wf/canvas}" rtl="{view>/wf/rtl}" readOnly="{view>/wf/readOnly}" class="repoioWfCanvas"
					ariaLabel="{i18n>fd.canvasAria}" insertLabel="{i18n>fd.addStep}" zoomInLabel="{i18n>onto.zoomIn}" zoomOutLabel="{i18n>onto.zoomOut}" fitLabel="{i18n>onto.fit}"
					select=".onCanvasSelect" insert=".onInsert" remove=".onRemove"/>

				<!-- Properties -->
				<VBox class="repoioOntoDetail repoioWfProps" renderType="Bare" visible="{view>/wf/showProps}">
					<customData><core:CustomData key="wide" value="{= ${view>/wf/sel/type} === 'writeBack' || ${view>/wf/sel/type} === 'test' ? 'yes' : 'no' }" writeToDom="true"/></customData>
					<HBox class="repoioOntoDetailHead" renderType="Bare" alignItems="Center">
						<core:Icon src="sap-icon://action-settings" color="#ffffff" decorative="true"/>
						<Text text="{i18n>wf.properties}" class="repoioOntoDetailKind"/>
						<Button icon="sap-icon://decline" type="Transparent" tooltip="{i18n>common.close}" press=".onCloseProps" class="repoioOntoDetailClose"/>
					</HBox>
					<ScrollContainer vertical="true" horizontal="false" class="repoioOntoDetailScroll">
						<VBox renderType="Bare" class="repoioWfPropsBody">
							<HBox renderType="Bare" alignItems="Center" class="repoioWfPropsTitle">
								<core:Icon src="{view>/wf/sel/icon}" decorative="true" class="rfPropIcon"/>
								<VBox renderType="Bare">
									<Title text="{view>/wf/sel/title}" level="H2" titleStyle="H5" wrapping="true"/>
									<Text text="{view>/wf/sel/typeText}" class="repoioHint"/>
								</VBox>
							</HBox>
							<MessageStrip visible="{= !!${view>/wf/sel/issues} }" text="{view>/wf/sel/issues}" type="Error" showIcon="true" class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop"/>

							<!-- Workflow (nothing selected) -->
							<VBox renderType="Bare" visible="{= ${view>/wf/sel/type} === 'process' }">
								<Panel headerText="{i18n>wf.general}" expandable="true" expanded="true" class="repoioWfPanel">
									<Label text="{i18n>wf.name}" required="true"/>
									<Input value="{view>/wf/name}" change=".onNodeName" editable="{= !${view>/wf/readOnly} }"/>
									<Label text="{i18n>dsp.technicalName}" class="sapUiSmallMarginTop"/>
									<Text text="{view>/wf/tech}" class="repoioMono"/>
									<Label text="{i18n>wf.domain}" class="sapUiSmallMarginTop"/>
									<Text text="{view>/wf/domainText}"/>
									<Text text="{i18n>fd.domainHint}" class="repoioHint"/>
									<Label text="{i18n>domain.owner}" class="sapUiSmallMarginTop"/>
									<rc:PersonLink name="{view>/wf/owner}"/>
									<Text text="{i18n>fd.publishHint}" class="repoioHint sapUiTinyMarginTop"/>
								</Panel>
								<Panel headerText="{i18n>wf.steps}" expandable="true" expanded="true" class="repoioWfPanel">
									<List items="{view>/wf/steps}" showSeparators="Inner" itemPress=".onStepPress" class="repoioWfSteps">
										<StandardListItem type="Active" title="{view>title}" description="{view>type}" icon="{view>icon}" app:id="{view>id}"
											highlight="{= ${view>bad} ? 'Error' : 'None' }"/>
									</List>
								</Panel>
								<Panel headerText="{i18n>wf.versions}" expandable="true" expanded="false" class="repoioWfPanel">
									<List items="{view>/wf/versions}" showSeparators="Inner">
										<StandardListItem title="v{view>v}" description="{view>date}" info="{view>stateText}"
											infoState="{= ${view>state} === 'published' ? 'Success' : ${view>state} === 'review' ? 'Warning' : 'Information' }"/>
									</List>
								</Panel>
							</VBox>

							<!-- Name (every step) -->
							<Panel headerText="{i18n>wf.general}" expandable="true" expanded="true" class="repoioWfPanel"
								visible="{= ${view>/wf/sel/type} !== 'process' &amp;&amp; ${view>/wf/sel/type} !== 'begin' &amp;&amp; ${view>/wf/sel/type} !== 'test' &amp;&amp; ${view>/wf/sel/type} !== 'compare' &amp;&amp; ${view>/wf/sel/type} !== 'runs' }">
								<Label text="{i18n>wf.name}"/>
								<Input value="{view>/wf/sel/name}" placeholder="{view>/wf/sel/title}" change=".onNodeName" editable="{= !${view>/wf/readOnly} }"/>
								<Label text="{i18n>dsp.technicalName}" class="sapUiSmallMarginTop"/>
								<Text text="{view>/wf/sel/id}" class="repoioMono"/>
							</Panel>

							<!-- Begin -->
							<VBox renderType="Bare" visible="{= ${view>/wf/sel/type} === 'begin' }" class="sapUiSmallMargin">
								<Text text="{i18n>fd.beginHint}"/>
							</VBox>

							<!-- Template -->
							<Panel headerText="{i18n>fd.n.template}" visible="{= ${view>/wf/sel/type} === 'template' }" class="repoioWfPanel">
								<Label text="{i18n>fd.template}" required="true"/>
								<Select selectedKey="{view>/wf/sel/template}" items="{path: 'view>/wf/templates', sorter: {path: 'domainText', group: true}}" width="100%"
									forceSelection="false" change=".onTemplate" enabled="{= !${view>/wf/readOnly} }" showSecondaryValues="true"
									valueState="{= ${view>/wf/sel/template} ? 'None' : 'Warning' }">
									<core:ListItem key="{view>key}" text="{view>text}" additionalText="{view>version}"/>
								</Select>
								<Text text="{i18n>fd.templateHint}" class="repoioHint"/>
								<Label text="{i18n>fd.tplVersion}" class="sapUiSmallMarginTop" visible="{= !!${view>/wf/sel/template} }"/>
								<HBox renderType="Bare" alignItems="Center" visible="{= !!${view>/wf/sel/template} }">
									<ObjectStatus text="v{view>/wf/sel/tplVersion}" icon="sap-icon://locked" state="Information"/>
									<Text text="{i18n>fd.pinned}" class="repoioHint sapUiTinyMarginBegin"/>
								</HBox>
								<MessageStrip visible="{= !!${view>/wf/sel/newer} }" type="Warning" showIcon="true" class="sapUiTinyMarginTop"
									text="{path: 'view>/wf/sel/newer', formatter: '.newerText'}">
									<link><Link text="{i18n>fd.up.review}" press=".onTemplateUpgrade"/></link>
								</MessageStrip>
								<Title text="{i18n>fd.fields}" level="H3" titleStyle="H6" class="sapUiSmallMarginTop"/>
								<List items="{view>/wf/fields}" showSeparators="Inner" noDataText="{i18n>fd.pickTemplate}" class="repoioWfFields">
									<StandardListItem title="{view>label}" description="{view>name}" info="{= ${view>key} ? 'key' : ${view>req} ? '*' : '' }"
										icon="{= ${view>codeList} ? 'sap-icon://list' : ${view>type} === 'decimal' ? 'sap-icon://number-sign' : 'sap-icon://text' }"/>
								</List>
							</Panel>

							<!-- Approval -->
							<Panel headerText="{i18n>wf.approval}" visible="{= ${view>/wf/sel/type} === 'approval' }" class="repoioWfPanel">
								<Label text="{i18n>fd.ap.mode}"/>
								<SegmentedButton selectedKey="{path: 'view>/wf/sel/mode', mode: 'OneWay'}" selectionChange=".onApprovalMode" width="100%" enabled="{= !${view>/wf/readOnly} }"
									class="sapUiTinyMarginBottom">
									<items>
										<SegmentedButtonItem key="single" text="{i18n>fd.ap.single}"/>
										<SegmentedButtonItem key="parallel" text="{i18n>fd.ap.parallel}"/>
									</items>
								</SegmentedButton>
								<!-- Parallel groups: every group decides; the step is approved when all groups approve. -->
								<VBox renderType="Bare" visible="{= ${view>/wf/sel/mode} === 'parallel' }">
									<Text text="{i18n>fd.ap.parallelHint}" class="repoioHint"/>
									<VBox items="{view>/wf/sel/groups}" renderType="Bare">
										<HBox renderType="Bare" alignItems="Center" class="repoioWfGroup">
											<Text text="{view>n}" class="repoioWfGroupNo"/>
											<Select selectedKey="{view>who}" items="{path: 'view>/wf/who', templateShareable: false, sorter: {path: 'group', group: true}}" width="100%"
												forceSelection="false" change=".onGroupWho" enabled="{= !${view>/wf/readOnly} }" valueState="{= ${view>who} ? 'None' : 'Warning' }">
												<core:Item key="{view>key}" text="{view>text}"/>
											</Select>
											<Select selectedKey="{view>rule}" width="8rem" change=".onGroupRuleSel" enabled="{= !${view>/wf/readOnly} }">
												<core:Item key="any" text="{i18n>wf.rule.any}"/>
												<core:Item key="all" text="{i18n>wf.rule.all}"/>
											</Select>
											<Button icon="sap-icon://decline" type="Transparent" tooltip="{i18n>fd.ap.removeGroup}" press=".onRemoveGroup" enabled="{= !${view>/wf/readOnly} }"/>
										</HBox>
									</VBox>
									<Button text="{i18n>fd.ap.addGroup}" icon="sap-icon://add" type="Transparent" press=".onAddGroup" enabled="{= !${view>/wf/readOnly} }"/>
								</VBox>
								<VBox renderType="Bare" visible="{= ${view>/wf/sel/mode} !== 'parallel' }">
								<Label text="{i18n>wf.approvers}" required="true"/>
								<SegmentedButton selectedKey="{path: 'view>/wf/sel/approverType', mode: 'OneWay'}" selectionChange=".onApproverType" width="100%" enabled="{= !${view>/wf/readOnly} }">
									<items>
										<SegmentedButtonItem key="users" text="{i18n>wf.ap.users}" icon="sap-icon://person-placeholder"/>
										<SegmentedButtonItem key="team" text="{i18n>wf.ap.team}" icon="sap-icon://group"/>
									</items>
								</SegmentedButton>
								<MultiComboBox selectedKeys="{path: 'view>/wf/sel/approvers', mode: 'OneWay'}" items="{view>/wf/people}" width="100%" class="sapUiTinyMarginTop"
									visible="{= ${view>/wf/sel/approverType} !== 'team' }" selectionFinish=".onApprovers" showSecondaryValues="true"
									editable="{= !${view>/wf/readOnly} }" placeholder="{i18n>wf.ap.usersPh}"
									valueState="{= ${view>/wf/sel/hasApprovers} ? 'None' : 'Warning' }">
									<core:ListItem key="{view>key}" text="{view>text}" additionalText="{view>role}"/>
								</MultiComboBox>
								<VBox renderType="Bare" visible="{= ${view>/wf/sel/approverType} === 'team' }" class="sapUiTinyMarginTop">
									<Select selectedKey="{view>/wf/sel/approverTeam}" items="{view>/wf/teams}" width="100%" forceSelection="false" showSecondaryValues="true"
										change=".onProp" app:prop="approverTeam" enabled="{= !${view>/wf/readOnly} }"
										valueState="{= ${view>/wf/sel/approverTeam} ? 'None' : 'Warning' }">
										<core:ListItem key="{view>key}" text="{view>text}" additionalText="{view>count}"/>
									</Select>
									<HBox items="{view>/wf/sel/teamMembers}" renderType="Bare" wrap="Wrap" class="repoioWfMembers">
										<rc:PersonLink name="{view>name}"/>
									</HBox>
								</VBox>
								<Label text="{i18n>wf.rule}" class="sapUiSmallMarginTop"/>
								<SegmentedButton selectedKey="{path: 'view>/wf/sel/rule', mode: 'OneWay'}" selectionChange=".onRule" width="100%" enabled="{= !${view>/wf/readOnly} }">
									<items>
										<SegmentedButtonItem key="any" text="{= ${view>/wf/sel/approverType} === 'team' ? ${i18n>wf.rule.anyMember} : ${i18n>wf.rule.any} }"/>
										<SegmentedButtonItem key="all" text="{= ${view>/wf/sel/approverType} === 'team' ? ${i18n>wf.rule.allMembers} : ${i18n>wf.rule.all} }"/>
									</items>
								</SegmentedButton>
								</VBox>
								<Label text="{i18n>fd.sla}" class="sapUiSmallMarginTop"/>
								<Select selectedKey="{view>/wf/sel/sla}" width="100%" change=".onProp" app:prop="sla" enabled="{= !${view>/wf/readOnly} }">
									<core:Item key="PT8H" text="{i18n>fd.sla.PT8H}"/>
									<core:Item key="P1D" text="{i18n>fd.sla.P1D}"/>
									<core:Item key="P2D" text="{i18n>fd.sla.P2D}"/>
									<core:Item key="P3D" text="{i18n>fd.sla.P3D}"/>
									<core:Item key="P5D" text="{i18n>fd.sla.P5D}"/>
								</Select>
								<Label text="{i18n>fd.escalate}" class="sapUiSmallMarginTop"/>
								<Select selectedKey="{view>/wf/sel/escalateTo}" items="{path: 'view>/wf/who', sorter: {path: 'group', group: true}}" width="100%"
									change=".onProp" app:prop="escalateTo" enabled="{= !${view>/wf/readOnly} }">
									<core:Item key="{view>key}" text="{view>text}"/>
								</Select>
								<Text text="{i18n>fd.slaHint}" class="repoioHint"/>
							</Panel>
							<Panel headerText="{i18n>fd.ap.controls}" visible="{= ${view>/wf/sel/type} === 'approval' }" class="repoioWfPanel">
								<CheckBox text="{i18n>fd.ap.allowReturn}" selected="{path: 'view>/wf/sel/allowReturn', mode: 'OneWay'}" select=".onProp" app:prop="allowReturn"
									enabled="{= !${view>/wf/readOnly} }"/>
								<HBox renderType="Bare" alignItems="Center" visible="{view>/wf/sel/allowReturn}" class="repoioWfIndent">
									<Label text="{i18n>fd.ap.maxReturns}" class="sapUiTinyMarginEnd"/>
									<StepInput value="{view>/wf/sel/maxReturns}" min="1" max="5" width="7rem" change=".onPropNum" app:prop="maxReturns" editable="{= !${view>/wf/readOnly} }"/>
								</HBox>
								<Text text="{i18n>fd.ap.returnHint}" class="repoioHint repoioWfIndent" visible="{view>/wf/sel/allowReturn}"/>
								<CheckBox text="{i18n>fd.ap.sod}" selected="{path: 'view>/wf/sel/sod', mode: 'OneWay'}" select=".onProp" app:prop="sod" enabled="{= !${view>/wf/readOnly} }"
									class="sapUiTinyMarginTop"/>
								<Text text="{i18n>fd.ap.sodHint}" class="repoioHint repoioWfIndent"/>
								<CheckBox text="{i18n>fd.ap.delegate}" selected="{path: 'view>/wf/sel/delegate', mode: 'OneWay'}" select=".onProp" app:prop="delegate"
									enabled="{= !${view>/wf/readOnly} }" class="sapUiTinyMarginTop"/>
								<Text text="{i18n>fd.ap.delegateHint}" class="repoioHint repoioWfIndent"/>
								<MessageStrip visible="{= !!${view>/wf/sel/awayNote} &amp;&amp; !!${view>/wf/sel/delegate} }" text="{view>/wf/sel/awayNote}" type="Information"
									showIcon="true" class="sapUiTinyMarginTop"/>
							</Panel>

							<!-- Notification -->
							<Panel headerText="{i18n>fd.n.notification}" visible="{= ${view>/wf/sel/type} === 'notification' }" class="repoioWfPanel">
								<Label text="{i18n>fd.channels}" required="true"/>
								<HBox renderType="Bare" class="repoioWfPair">
									<CheckBox text="{i18n>fd.ch.inApp}" selected="{view>/wf/sel/inApp}" select=".onChannel" enabled="{= !${view>/wf/readOnly} }"/>
									<CheckBox text="{i18n>fd.ch.email}" selected="{view>/wf/sel/email}" select=".onChannel" enabled="{= !${view>/wf/readOnly} }"/>
								</HBox>
								<Label text="{i18n>fd.to}" required="true" class="sapUiSmallMarginTop"/>
								<MultiComboBox selectedKeys="{path: 'view>/wf/sel/recipients', mode: 'OneWay'}" items="{path: 'view>/wf/sel/recipientOptions', sorter: {path: 'group', group: true}}"
									width="100%" selectionFinish=".onRecipients" editable="{= !${view>/wf/readOnly} }">
									<core:Item key="{view>key}" text="{view>text}"/>
								</MultiComboBox>
								<Label text="{i18n>fd.msgLang}" class="sapUiSmallMarginTop"/>
								<SegmentedButton selectedKey="{view>/wf/msgLang}" width="100%">
									<items>
										<SegmentedButtonItem key="ar" text="{i18n>fd.msg.ar}"/>
										<SegmentedButtonItem key="en" text="{i18n>fd.msg.en}"/>
									</items>
								</SegmentedButton>
								<VBox renderType="Bare" visible="{= ${view>/wf/msgLang} === 'ar' }" class="repoioWfMsgAr">
									<Label text="{i18n>fd.subject}" class="sapUiSmallMarginTop" visible="{= !!${view>/wf/sel/email} }"/>
									<Input value="{view>/wf/sel/subjectAr}" change=".onProp" app:prop="subjectAr" visible="{= !!${view>/wf/sel/email} }" editable="{= !${view>/wf/readOnly} }"
										textDirection="RTL"/>
									<Label text="{i18n>fd.message}" required="true" class="sapUiSmallMarginTop"/>
									<TextArea value="{view>/wf/sel/messageAr}" rows="4" width="100%" growing="true" change=".onProp" app:prop="messageAr" editable="{= !${view>/wf/readOnly} }"
										textDirection="RTL" valueState="{= ${view>/wf/sel/messageAr} ? 'None' : 'Warning' }"/>
								</VBox>
								<VBox renderType="Bare" visible="{= ${view>/wf/msgLang} === 'en' }" class="repoioWfMsgEn">
									<Label text="{i18n>fd.subject}" class="sapUiSmallMarginTop" visible="{= !!${view>/wf/sel/email} }"/>
									<Input value="{view>/wf/sel/subjectEn}" change=".onProp" app:prop="subjectEn" visible="{= !!${view>/wf/sel/email} }" editable="{= !${view>/wf/readOnly} }"
										textDirection="LTR"/>
									<Label text="{i18n>fd.message}" required="true" class="sapUiSmallMarginTop"/>
									<TextArea value="{view>/wf/sel/messageEn}" rows="4" width="100%" growing="true" change=".onProp" app:prop="messageEn" editable="{= !${view>/wf/readOnly} }"
										textDirection="LTR" valueState="{= ${view>/wf/sel/messageEn} ? 'None' : 'Warning' }"/>
								</VBox>
								<HBox items="{view>/wf/vars}" renderType="Bare" wrap="Wrap" class="repoioWfChips">
									<Button text="{path: 'view>key', formatter: '.varText'}" type="Transparent" press=".onInsertVar" app:var="{view>key}"
										enabled="{= !${view>/wf/readOnly} }" class="repoioWfChip"/>
								</HBox>
								<Text text="{i18n>fd.notifyHint}" class="repoioHint"/>
								<Text text="{i18n>fd.msgHint}" class="repoioHint"/>
							</Panel>

							<!-- Script -->
							<Panel headerText="{i18n>fd.n.script}" visible="{= ${view>/wf/sel/type} === 'script' }" class="repoioWfPanel">
								<Label text="{i18n>fd.language}"/>
								<SegmentedButton selectedKey="{path: 'view>/wf/sel/language', mode: 'OneWay'}" selectionChange=".onLanguage" width="100%" enabled="{= !${view>/wf/readOnly} }">
									<items>
										<SegmentedButtonItem key="python" text="{i18n>fd.lang.python}"/>
										<SegmentedButtonItem key="sql" text="{i18n>fd.lang.sql}"/>
									</items>
								</SegmentedButton>
								<Label text="{i18n>fd.templateFields}" class="sapUiSmallMarginTop"/>
								<HBox items="{view>/wf/fields}" renderType="Bare" wrap="Wrap" class="repoioWfChips">
									<Button text="{view>name}" tooltip="{view>label}" type="Transparent" press=".onInsertField" app:field="{view>name}"
										enabled="{= !${view>/wf/readOnly} }" class="repoioWfChip"/>
								</HBox>
								<rc:CodeEditor id="codeEditor" height="17rem" change=".onCode" class="sapUiTinyMarginTop"/>
								<Label text="{i18n>wf.timeout}" class="sapUiSmallMarginTop"/>
								<StepInput value="{view>/wf/sel/timeoutMin}" min="1" max="60" width="8rem" change=".onPropNum" app:prop="timeoutMin" editable="{= !${view>/wf/readOnly} }"/>
								<MessageStrip text="{= ${view>/wf/sel/language} === 'sql' ? ${i18n>fd.sqlNote} : ${i18n>fd.pyNote} }" showIcon="true" class="sapUiSmallMarginTop"/>
							</Panel>

							<!-- Validation -->
							<Panel headerText="{i18n>fd.n.validation}" visible="{= ${view>/wf/sel/type} === 'validation' }" class="repoioWfPanel">
								<Label text="{i18n>fd.rule}" required="true"/>
								<Select selectedKey="{view>/wf/sel/rule}" items="{path: 'view>/wf/rules', sorter: {path: 'engine', group: true}}" width="100%" forceSelection="false"
									change=".onValidationRule" enabled="{= !${view>/wf/readOnly} }" valueState="{= ${view>/wf/sel/rule} ? 'None' : 'Warning' }">
									<core:Item key="{view>key}" text="{view>text}"/>
								</Select>
								<Text text="{view>/wf/sel/ruleDesc}" class="repoioHint" visible="{= !!${view>/wf/sel/ruleDesc} }"/>
								<VBox renderType="Bare" visible="{= ${view>/wf/sel/ruleKind} === 'dq' }">
									<Label text="{i18n>fd.appliesTo}" class="sapUiSmallMarginTop"/>
									<Text text="{view>/wf/sel/fixedFields}" class="repoioMono" visible="{= !!${view>/wf/sel/fixedFields} }"/>
									<MultiComboBox selectedKeys="{path: 'view>/wf/sel/fields', mode: 'OneWay'}" items="{view>/wf/fields}" width="100%"
										visible="{= !${view>/wf/sel/fixedFields} }" selectionFinish=".onValidationFields" editable="{= !${view>/wf/readOnly} }" showSecondaryValues="true">
										<core:ListItem key="{view>name}" text="{view>label}" additionalText="{view>name}"/>
									</MultiComboBox>
									<Label text="{i18n>fd.onFail}" class="sapUiSmallMarginTop"/>
									<Select selectedKey="{view>/wf/sel/severity}" width="100%" change=".onProp" app:prop="severity" enabled="{= !${view>/wf/readOnly} }">
										<core:Item key="block" text="{i18n>fd.sev.block}"/>
										<core:Item key="warn" text="{i18n>fd.sev.warn}"/>
									</Select>
								</VBox>
								<VBox renderType="Bare" visible="{= ${view>/wf/sel/ruleKind} === 'match' }">
									<Label text="{i18n>fd.compareWith}" required="true" class="sapUiSmallMarginTop"/>
									<Select selectedKey="{view>/wf/sel/source}" items="{view>/wf/sel/sources}" width="100%" change=".onProp" app:prop="source" enabled="{= !${view>/wf/readOnly} }">
										<core:Item key="{view>key}" text="{view>text}"/>
									</Select>
									<Label text="{i18n>fd.threshold}: {view>/wf/sel/thresholdPct}%" class="sapUiSmallMarginTop"/>
									<Slider value="{path: 'view>/wf/sel/thresholdPct', mode: 'OneWay'}" min="50" max="99" step="1" width="100%" change=".onThreshold"
										enabled="{= !${view>/wf/readOnly} }"/>
									<Text text="{i18n>fd.matchHint}" class="repoioHint"/>
								</VBox>
								<Text text="{i18n>fd.validationNote}" class="repoioHint sapUiSmallMarginTop"/>
							</Panel>

							<!-- Write-back -->
							<Panel headerText="{i18n>fd.n.writeBack}" visible="{= ${view>/wf/sel/type} === 'writeBack' }" class="repoioWfPanel">
								<Label text="{i18n>fd.sourceSystem}" required="true"/>
								<Select selectedKey="{view>/wf/sel/connection}" items="{view>/wf/connections}" width="100%" forceSelection="false" change=".onConnection"
									enabled="{= !${view>/wf/readOnly} }" valueState="{= ${view>/wf/sel/connection} ? 'None' : 'Warning' }">
									<core:Item key="{view>key}" text="{view>text}"/>
								</Select>
								<Label text="{i18n>wf.entity}" class="sapUiSmallMarginTop"/>
								<Text text="{view>/wf/domainText}"/>
								<MessageStrip visible="{= !!${view>/wf/sel/noAllowlist} }" text="{i18n>fd.v.noAllowlist}" type="Warning" showIcon="true" class="sapUiTinyMarginTop"/>
								<Label text="{i18n>wf.conflict}" class="sapUiSmallMarginTop"/>
								<Select selectedKey="{view>/wf/sel/conflict}" width="100%" change=".onProp" app:prop="conflict" enabled="{= !${view>/wf/readOnly} }">
									<core:Item key="review" text="{i18n>wf.conflict.review}"/>
									<core:Item key="fail" text="{i18n>wf.conflict.fail}"/>
								</Select>
								<Label text="{i18n>wf.retries}" class="sapUiSmallMarginTop"/>
								<StepInput value="{view>/wf/sel/retries}" min="0" max="10" width="8rem" change=".onPropNum" app:prop="retries" editable="{= !${view>/wf/readOnly} }"/>
								<MessageStrip text="{i18n>wf.wbNote}" showIcon="true" class="sapUiSmallMarginTop"/>
							</Panel>

							<!-- Write-back: Mapping (Datasphere-style, in the side panel) -->
							<Panel headerText="{i18n>wf.mapping} ({view>/wf/sel/mappedCount} / {view>/wf/sel/targetCount})" expandable="true" expanded="true"
								visible="{= ${view>/wf/sel/type} === 'writeBack' }" class="repoioWfPanel repoioWfMapPanel">
								<Text text="{i18n>fd.pickConnection}" class="repoioHint" visible="{= !${view>/wf/sel/connection} }"/>
								<rc:FieldMapper id="mapper" visible="{= ${view>/wf/sel/targetCount} > 0 }"
									source="{view>/wf/fields}" target="{view>/wf/sel/targetFields}" mapping="{path: 'view>/wf/sel/mapping', mode: 'OneWay'}"
									texts="{view>/wf/sel/mapTexts}" editable="{= !${view>/wf/readOnly} }" change=".onMapping" transform=".onTransform"/>
								<Text text="{i18n>fd.map.strip}" class="repoioHint sapUiTinyMarginTop" visible="{= ${view>/wf/sel/targetCount} > 0 }"/>
							</Panel>

							<!-- Condition -->
							<Panel headerText="{i18n>fd.n.condition}" visible="{= ${view>/wf/sel/type} === 'condition' }" class="repoioWfPanel">
								<Label text="{i18n>fd.cond.field}" required="true"/>
								<Select selectedKey="{view>/wf/sel/field}" items="{path: 'view>/wf/sel/condFields', sorter: {path: 'group', group: true}}" width="100%" forceSelection="false"
									change=".onCondField" enabled="{= !${view>/wf/readOnly} }" showSecondaryValues="true">
									<core:ListItem key="{view>key}" text="{view>text}" additionalText="{view>extra}"/>
								</Select>
								<Label text="{i18n>fd.cond.op}" class="sapUiSmallMarginTop"/>
								<Select selectedKey="{view>/wf/sel/op}" width="100%" change=".onProp" app:prop="op" enabled="{= !${view>/wf/readOnly} }">
									<core:Item key="eq" text="{i18n>fd.op.eq}"/>
									<core:Item key="ne" text="{i18n>fd.op.ne}"/>
									<core:Item key="gt" text="{i18n>fd.op.gt}"/>
									<core:Item key="lt" text="{i18n>fd.op.lt}"/>
									<core:Item key="empty" text="{i18n>fd.op.empty}"/>
									<core:Item key="notEmpty" text="{i18n>fd.op.notEmpty}"/>
								</Select>
								<Label text="{i18n>fd.cond.value}" class="sapUiSmallMarginTop"
									visible="{= ${view>/wf/sel/op} !== 'empty' &amp;&amp; ${view>/wf/sel/op} !== 'notEmpty' }"/>
								<Input value="{view>/wf/sel/value}" change=".onProp" app:prop="value" editable="{= !${view>/wf/readOnly} }"
									visible="{= ${view>/wf/sel/op} !== 'empty' &amp;&amp; ${view>/wf/sel/op} !== 'notEmpty' }"/>
								<Text text="{view>/wf/sel/valueHint}" class="repoioHint" visible="{= !!${view>/wf/sel/valueHint} }"/>
								<Text text="{i18n>fd.condHint}" class="repoioHint"/>
							</Panel>

							<!-- End -->
							<Panel headerText="{i18n>fd.n.end}" visible="{= ${view>/wf/sel/type} === 'end' }" class="repoioWfPanel">
								<Label text="{i18n>wf.outcome}"/>
								<Select selectedKey="{view>/wf/sel/outcome}" width="100%" change=".onProp" app:prop="outcome" enabled="{= !${view>/wf/readOnly} }">
									<core:Item key="completed" text="{i18n>fd.out.completed}"/>
									<core:Item key="rejected" text="{i18n>fd.out.rejected}"/>
									<core:Item key="cancelled" text="{i18n>fd.out.cancelled}"/>
								</Select>
							</Panel>

							<!-- Test run results -->
							<VBox renderType="Bare" visible="{= ${view>/wf/sel/type} === 'test' }">
								<Panel headerText="{i18n>fd.test.path}" class="repoioWfPanel">
									<Text text="{i18n>fd.rcp.requester}: {view>/wf/test/requester}" class="repoioHint"/>
									<List items="{view>/wf/test/rows}" showSeparators="Inner" itemPress=".onTestRowPress" class="repoioWfRunList">
										<CustomListItem type="Active" app:id="{view>id}" highlight="{view>state}">
											<HBox renderType="Bare" class="repoioWfRunRow">
												<core:Icon src="{view>icon}" decorative="true" class="repoioWfRunIcon"/>
												<VBox renderType="Bare">
													<Text text="{view>title}" class="repoioWfRunTitle"/>
													<Text text="{view>text}" class="repoioHint"/>
													<Text text="{view>details}" class="repoioMono repoioWfRunMsg" visible="{= !!${view>details} }"/>
													<Text text="{view>msgAr}" textDirection="RTL" class="repoioWfRunMsg" visible="{= !!${view>msgAr} }"/>
													<Text text="{view>msgEn}" textDirection="LTR" class="repoioWfRunMsg" visible="{= !!${view>msgEn} }"/>
												</VBox>
											</HBox>
										</CustomListItem>
									</List>
								</Panel>
								<Panel headerText="{i18n>fd.test.payloadTitle}" visible="{view>/wf/test/hasPayload}" class="repoioWfPanel">
									<Table items="{view>/wf/test/payload}" class="repoioWfPayload">
										<columns>
											<Column><Text text="{i18n>fd.test.target}"/></Column>
											<Column><Text text="{i18n>fd.test.value}"/></Column>
											<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>fd.test.from}"/></Column>
										</columns>
										<items>
											<ColumnListItem highlight="{= ${view>warn} ? 'Warning' : 'None' }">
												<cells>
													<Text text="{view>target}" class="repoioMono"/>
													<VBox renderType="Bare">
														<Text text="{view>value}" class="repoioMono"/>
														<Text text="{view>note}" class="repoioHint" visible="{= !!${view>note} }"/>
													</VBox>
													<Text text="{view>from}" class="repoioMono"/>
												</cells>
											</ColumnListItem>
										</items>
									</Table>
									<Text text="{i18n>fd.test.payloadHint}" class="repoioHint"/>
								</Panel>
								<Button text="{i18n>fd.clear}" icon="sap-icon://clear-all" press=".onClearOverlay" class="sapUiSmallMargin"/>
							</VBox>

							<!-- Compare -->
							<VBox renderType="Bare" visible="{= ${view>/wf/sel/type} === 'compare' }">
								<Panel headerText="{i18n>fd.cmp.changes}" class="repoioWfPanel">
									<List items="{view>/wf/compare/rows}" showSeparators="Inner" itemPress=".onCompareRowPress" noDataText="{i18n>fd.cmp.noChanges}">
										<CustomListItem type="Active" app:id="{view>id}" highlight="{view>state}">
											<HBox renderType="Bare" class="repoioWfRunRow">
												<core:Icon src="{view>icon}" decorative="true" class="repoioWfRunIcon"/>
												<VBox renderType="Bare">
													<HBox renderType="Bare" alignItems="Center">
														<Text text="{view>title}" class="repoioWfRunTitle"/>
														<ObjectStatus text="{view>kind}" state="{view>state}" class="sapUiTinyMarginBegin"/>
													</HBox>
													<Text text="{view>details}" class="repoioMono repoioWfRunMsg" visible="{= !!${view>details} }"/>
												</VBox>
											</HBox>
										</CustomListItem>
									</List>
								</Panel>
								<Button text="{i18n>fd.clear}" icon="sap-icon://clear-all" press=".onClearOverlay" class="sapUiSmallMargin"/>
							</VBox>

							<!-- Runs of the published version -->
							<VBox renderType="Bare" visible="{= ${view>/wf/sel/type} === 'runs' }">
								<Panel headerText="{i18n>fd.runs.last30}" class="repoioWfPanel">
									<List items="{view>/wf/runs/rows}" showSeparators="Inner">
										<StandardListItem title="{view>title}" description="{view>text}" icon="{view>icon}" wrapping="true"/>
									</List>
								</Panel>
								<Panel headerText="{i18n>fd.runs.waitingList}" visible="{view>/wf/runs/hasWaiting}" class="repoioWfPanel">
									<List items="{view>/wf/runs/waiting}" showSeparators="Inner">
										<StandardListItem title="{view>cr}" description="{view>who}" info="{view>age}" infoState="{= ${view>late} ? 'Error' : 'None' }"
											icon="sap-icon://request"/>
									</List>
								</Panel>
								<Text text="{i18n>fd.runs.hint}" class="repoioHint sapUiSmallMargin"/>
							</VBox>

							<Button text="{i18n>fd.removeStep}" icon="sap-icon://delete" type="Reject" press=".onRemoveSel" class="sapUiSmallMargin"
								visible="{= !!${view>/wf/sel/removable} &amp;&amp; !${view>/wf/readOnly} }"/>
						</VBox>
					</ScrollContainer>
				</VBox>
			</HBox>
		</VBox>
	</Page>
</mvc:View>
