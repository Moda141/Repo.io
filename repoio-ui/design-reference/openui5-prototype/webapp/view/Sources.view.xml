<mvc:View controllerName="repoio.proto.controller.Sources"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:uxap="sap.uxap" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core">
	<!-- Multi Instance floorplan: one tab per open data source, each an Object Page. -->
	<Page id="page" showHeader="false" enableScrolling="false">
		<TabContainer id="tabs" items="{view>/sources/open}" showAddNewButton="true" addNewButtonPress=".onAddTab"
			itemClose=".onCloseTab" itemSelect=".onSelectTab" class="sapUiResponsiveContentPadding">
			<items>
				<TabContainerItem key="{view>id}" name="{view>name}" additionalText="{view>type}">
					<content>
						<uxap:ObjectPageLayout showTitleInHeaderContent="true" upperCaseAnchorBar="false" headerContentPinnable="true" height="100%">
							<uxap:headerTitle>
								<uxap:ObjectPageDynamicHeaderTitle>
									<uxap:breadcrumbs>
										<Breadcrumbs currentLocationText="{view>name}">
											<Link text="{i18n>nav.domains}" press=".onToDomains"/>
											<Link text="{view>/sources/domainName}" press=".onToDomain"/>
											<Link text="{view>/sources/repoName}" press=".onToRepo"/>
										</Breadcrumbs>
									</uxap:breadcrumbs>
									<uxap:expandedHeading><Title text="{view>name}" level="H1"/></uxap:expandedHeading>
									<uxap:snappedHeading><Title text="{view>name}" level="H1"/></uxap:snappedHeading>
									<uxap:expandedContent><Text text="{i18n>src.dataSource} · {view>host}"/></uxap:expandedContent>
									<uxap:actions>
										<Button text="{i18n>common.edit}" type="Emphasized"/>
										<Button text="{i18n>src.syncNow}"/>
									</uxap:actions>
								</uxap:ObjectPageDynamicHeaderTitle>
							</uxap:headerTitle>
							<uxap:headerContent>
								<FlexBox wrap="Wrap" alignItems="Start">
									<Avatar src="sap-icon://database" displaySize="M" backgroundColor="Accent6" class="sapUiSmallMarginEnd"/>
									<VBox class="sapUiMediumMarginEnd" width="20rem">
										<ObjectAttribute title="{i18n>repo.connector}" text="{view>type}"/>
										<ObjectAttribute title="{i18n>src.host}" text="{view>host}"/>
										<ObjectAttribute title="{i18n>src.usedBy}" text="{view>repos/length} {i18n>domains.col.repos}"/>
									</VBox>
									<VBox class="sapUiMediumMarginEnd">
										<Label text="{i18n>domains.col.status}"/>
										<ObjectStatus text="{view>stateText}" state="{view>state}" class="sapMObjectStatusLarge"/>
									</VBox>
									<VBox class="sapUiMediumMarginEnd">
										<Label text="{i18n>repo.lastSync}"/>
										<Text text="{view>sync}" class="sapUiTinyMarginTop"/>
									</VBox>
									<VBox class="sapUiMediumMarginEnd">
										<Label text="{i18n>repo.tables}"/>
										<ObjectNumber number="{view>tables/length}" class="sapMObjectNumberLarge"/>
									</VBox>
									<VBox class="sapUiMediumMarginEnd">
										<Label text="{i18n>src.tableQuality}"/>
										<ObjectNumber number="{path: 'view>quality', formatter: '.fmt.pct'}" state="{view>qualityState}" class="sapMObjectNumberLarge"/>
									</VBox>
									<VBox>
										<Label text="{i18n>src.totalRows}"/>
										<ObjectNumber number="{path: 'view>rows', formatter: '.fmt.num'}" class="sapMObjectNumberLarge"/>
									</VBox>
								</FlexBox>
							</uxap:headerContent>
							<uxap:sections>
								<uxap:ObjectPageSection title="{i18n>src.sec.general}" titleUppercase="false">
									<uxap:subSections>
										<uxap:ObjectPageSubSection title="{i18n>src.sec.general}" titleUppercase="false" showTitle="false">
											<form:SimpleForm editable="false" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">
												<core:Title text="{i18n>src.connection}"/>
												<Label text="{i18n>src.id}"/><Text text="{view>id}"/>
												<Label text="{i18n>src.auth}"/><Text text="{view>auth}"/>
												<Label text="{i18n>src.schedule}"/><Text text="{view>schedule}"/>
												<Label text="{i18n>repo.lastSync}"/><Text text="{view>sync}"/>
												<core:Title text="{i18n>src.setup}"/>
												<Label text="{i18n>domain.owner}"/><Text text="{view>owner}"/>
												<Label text="{i18n>src.schemas}"/><Text text="{view>schemas}"/>
												<Label text="{i18n>src.reposUsing}"/><Text text="{path: 'view>repos', formatter: '.fmt.joinNames'}"/>
												<Label text="{i18n>src.secret}"/><Text text="{i18n>src.secretText}"/>
											</form:SimpleForm>
										</uxap:ObjectPageSubSection>
									</uxap:subSections>
								</uxap:ObjectPageSection>
								<uxap:ObjectPageSection title="{i18n>src.sec.repos}" titleUppercase="false">
									<uxap:subSections>
										<uxap:ObjectPageSubSection title="{i18n>src.sec.repos}" titleUppercase="false" showTitle="false">
											<Table items="{path: 'view>repos', templateShareable: false}" popinLayout="GridSmall">
												<headerToolbar>
													<OverflowToolbar>
														<Title text="{i18n>src.sec.repos} ({view>repos/length})" level="H3"/>
														<ToolbarSpacer/>
														<Text text="{i18n>src.reposHint}" class="repoioMuted"/>
													</OverflowToolbar>
												</headerToolbar>
												<columns>
													<Column width="22%"><Text text="{i18n>repo.repository}"/></Column>
													<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>domains.col.domain}"/></Column>
													<Column><Text text="{i18n>repo.model}"/></Column>
													<Column hAlign="End"><Text text="{i18n>repo.priority}"/></Column>
													<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>src.tablesUsed}"/></Column>
													<Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>src.attrsMapped}"/></Column>
													<Column><Text text="{i18n>domains.col.status}"/></Column>
												</columns>
												<items>
													<ColumnListItem type="Navigation" press=".onRepoPress">
														<ObjectIdentifier title="{view>name}" text="{view>code}"/>
														<Text text="{view>domainName}"/>
														<Text text="{view>model}"/>
														<Text text="{= ${view>priority} ? ${view>priority} + ' / ' + ${view>priorityOf} : '—' }"/>
														<Text text="{= ${view>tables} || '—' }"/>
														<Text text="{view>attrsMapped} / {view>attrsTotal}"/>
														<ObjectStatus text="{path: 'view>healthKey', formatter: '.healthText'}" state="{view>healthState}"/>
													</ColumnListItem>
												</items>
											</Table>
										</uxap:ObjectPageSubSection>
									</uxap:subSections>
								</uxap:ObjectPageSection>
								<uxap:ObjectPageSection title="{i18n>src.sec.tables}" titleUppercase="false">
									<uxap:subSections>
										<uxap:ObjectPageSubSection title="{i18n>src.sec.tables}" titleUppercase="false" showTitle="false">
											<Table items="{path: 'view>tables', templateShareable: false, sorter: {path: 'schema', group: true}}" popinLayout="GridSmall" mode="MultiSelect">
												<headerToolbar>
													<OverflowToolbar>
														<Title text="{i18n>repo.tables} ({view>tables/length})" level="H3"/>
														<ToolbarSpacer/>
														<Button text="{i18n>src.addTable}" type="Transparent"/>
													</OverflowToolbar>
												</headerToolbar>
												<columns>
													<Column width="26%"><Text text="{i18n>src.table}"/></Column>
													<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>src.usedIn}"/></Column>
													<Column hAlign="End"><Text text="{i18n>repo.rows}"/></Column>
													<Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>src.columns}"/></Column>
													<Column hAlign="End"><Text text="{i18n>domains.col.quality}"/></Column>
													<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>src.profiled}"/></Column>
												</columns>
												<items>
													<ColumnListItem type="Navigation" press=".onTablePress">
														<ObjectIdentifier title="{view>name}" text="Schema: {view>schema}"/>
														<Text text="{= ${view>usedIn}.length ? ${path: 'view>usedIn', formatter: '.fmt.joinNames'} : ${i18n>src.notUsed} }"/>
														<ObjectNumber number="{path: 'view>rows', formatter: '.fmt.num'}"/>
														<ObjectNumber number="{view>cols}"/>
														<ObjectNumber number="{path: 'view>quality', formatter: '.fmt.pct'}" state="{view>qualityState}"/>
														<Text text="{view>profiled}"/>
													</ColumnListItem>
												</items>
											</Table>
										</uxap:ObjectPageSubSection>
									</uxap:subSections>
								</uxap:ObjectPageSection>
								<uxap:ObjectPageSection title="{i18n>src.sec.sync}" titleUppercase="false">
									<uxap:subSections>
										<uxap:ObjectPageSubSection title="{i18n>src.sec.sync}" titleUppercase="false" showTitle="false">
											<Table items="{path: 'view>runs', templateShareable: false}" popinLayout="GridSmall">
												<headerToolbar><OverflowToolbar><Title text="{i18n>src.runs} ({view>runs/length})" level="H3"/></OverflowToolbar></headerToolbar>
												<columns>
													<Column><Text text="{i18n>src.run}"/></Column>
													<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>src.start}"/></Column>
													<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>src.duration}"/></Column>
													<Column hAlign="End"><Text text="{i18n>src.processed}"/></Column>
													<Column><Text text="{i18n>src.result}"/></Column>
												</columns>
												<items>
													<ColumnListItem>
														<Text text="{view>id}"/>
														<Text text="{view>start}"/>
														<Text text="{view>duration}"/>
														<ObjectNumber number="{path: 'view>rows', formatter: '.fmt.num'}"/>
														<ObjectStatus text="{path: 'view>stateKey', formatter: '.resultText'}" state="{view>state}"/>
													</ColumnListItem>
												</items>
											</Table>
										</uxap:ObjectPageSubSection>
									</uxap:subSections>
								</uxap:ObjectPageSection>
							</uxap:sections>
						</uxap:ObjectPageLayout>
					</content>
				</TabContainerItem>
			</items>
		</TabContainer>
	</Page>
</mvc:View>
