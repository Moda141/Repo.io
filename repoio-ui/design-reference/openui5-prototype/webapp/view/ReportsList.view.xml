<mvc:View controllerName="repoio.proto.controller.ReportsList"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns:rc="repoio.proto.control"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" height="100%">
	<!-- Reports list: the same Repository Explorer layout as the workflows list. -->
	<VBox height="100%" renderType="Bare" class="repoioExplorer">
		<OverflowToolbar class="repoioExTop">
			<Title text="{i18n>nav.reports}" level="H1" titleStyle="H4"/>
			<ToolbarSpacer/>
			<SearchField value="{view>/rl/q}" liveChange=".onSearch" search=".onSearch" width="32rem" placeholder="{view>/rl/searchPh}">
				<layoutData><OverflowToolbarLayoutData priority="NeverOverflow" shrinkable="true" minWidth="12rem"/></layoutData>
			</SearchField>
		</OverflowToolbar>
		<OverflowToolbar class="repoioExBar">
			<ToggleButton icon="sap-icon://filter" pressed="{view>/rl/showFilters}" tooltip="{i18n>cat.filters}" type="Emphasized"/>
			<ToolbarSpacer/>
			<MenuButton icon="sap-icon://add" type="Transparent" tooltip="{i18n>rl.new}">
				<menu>
					<Menu>
						<MenuItem text="{i18n>rl.newStory}" icon="sap-icon://business-objects-experience" press=".onNewStory"/>
						<MenuItem text="{i18n>rl.newAlp}" icon="sap-icon://table-chart" press=".onNewAlp"/>
						<MenuItem text="{i18n>wl.newCopy}" icon="sap-icon://copy" press=".onNewCopy" enabled="{= ${view>/rl/selected} === 1 }"/>
					</Menu>
				</menu>
			</MenuButton>
			<Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>rl.editStudio}" enabled="{= ${view>/rl/selected} === 1 }" press=".onEdit"/>
			<Button icon="sap-icon://email" type="Transparent" tooltip="{i18n>rl.broadcast}" enabled="{view>/rl/canBroadcast}" press=".onBroadcast"/>
			<Button icon="sap-icon://download" type="Transparent" tooltip="{i18n>common.export}" enabled="{= ${view>/rl/selected} === 1 }" press=".onExport"/>
			<Button icon="sap-icon://locked" type="Transparent" tooltip="{i18n>wl.retire}" enabled="{view>/rl/canRetire}" press=".onRetire"/>
			<Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>common.delete}" enabled="{view>/rl/canDelete}" press=".onDelete"/>
		</OverflowToolbar>
		<HBox class="repoioExBody" renderType="Bare">
			<ScrollContainer vertical="true" height="100%" width="15rem" visible="{view>/rl/showFilters}" class="repoioFacetPanel">
				<Title text="{i18n>wl.collection}" level="H3" class="repoioFacetGroup"/>
				<List items="{view>/rl/collections}" mode="SingleSelectMaster" selectionChange=".onCollection" showSeparators="None" class="repoioFacetList">
					<StandardListItem title="{view>text}" icon="{view>icon}" selected="{view>selected}"/>
				</List>
				<HBox alignItems="Center" justifyContent="SpaceBetween" class="repoioFacetHead">
					<Title text="{i18n>wl.filterBy}" level="H3" titleStyle="H5"/>
					<Button icon="sap-icon://clear-filter" type="Transparent" tooltip="{i18n>cat.clearAll}" enabled="{= ${view>/rl/active} > 0 }" press=".onClearFacets"/>
				</HBox>
				<VBox items="{view>/rl/facets}" renderType="Bare">
					<VBox renderType="Bare">
						<Title text="{view>title}" level="H4" class="repoioFacetGroup"/>
						<List items="{path: 'view>values', templateShareable: false}" mode="MultiSelect" includeItemNavigation="false" selectionChange=".onFacetChange"
							showSeparators="None" class="repoioFacetList" app:facet="{view>key}">
							<StandardListItem title="{view>text}" icon="{view>icon}" counter="{view>count}" selected="{view>selected}"/>
						</List>
					</VBox>
				</VBox>
			</ScrollContainer>

			<VBox class="repoioExMain" renderType="Bare">
				<HBox alignItems="Center" class="repoioExScope">
					<Label text="{i18n>wl.searchIn}" class="repoioExScopeLbl"/>
					<core:Icon src="{view>/rl/collIcon}" class="repoioExScopeIcon"/>
					<Text text="{view>/rl/scopeText}"/>
				</HBox>
				<ScrollContainer vertical="true" horizontal="true" height="100%" class="repoioExScroll">
					<Table id="rlTable" items="{view>/rl/rows}" mode="MultiSelect" selectionChange=".onSelect" sticky="ColumnHeaders"
						class="repoioDenseTable" fixedLayout="false" noDataText="{i18n>rl.noData}" popinLayout="GridSmall">
						<columns>
							<Column><Text text="{i18n>dsp.businessName}"/></Column>
							<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>dsp.technicalName}"/></Column>
							<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>rl.col.type}"/></Column>
							<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>wl.col.domain}"/></Column>
							<Column minScreenWidth="1600px"><Text text="{i18n>rl.col.source}"/></Column>
							<Column><Text text="{i18n>domains.col.status}"/></Column>
							<Column minScreenWidth="Desktop" demandPopin="true" hAlign="End"><Text text="{i18n>rl.col.views}"/></Column>
							<Column minScreenWidth="Desktop" demandPopin="true" hAlign="End"><Text text="{i18n>rl.col.broadcasts}"/></Column>
							<Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center"><Text text="{i18n>domain.owner}"/></Column>
							<Column minScreenWidth="1700px"><Text text="{i18n>dsp.changedOn}"/></Column>
							<Column hAlign="End" width="2.5rem"><Text text="{i18n>cat.tab.fav}" class="sapUiInvisibleText"/></Column>
						</columns>
						<items>
							<ColumnListItem>
								<HBox alignItems="Center">
									<core:Icon src="{view>typeIcon}" class="repoioExRowIcon"/>
									<Link text="{view>title}" press=".onOpen" wrapping="false"/>
								</HBox>
								<Text text="{view>id}" class="repoioMono" wrapping="false"/>
								<Text text="{view>typeText}" wrapping="false"/>
								<HBox alignItems="Center">
									<core:Icon src="{view>domIcon}" class="repoioExRowIcon"/>
									<Text text="{view>domText}" wrapping="false"/>
								</HBox>
								<Text text="{view>source}" class="repoioMono" wrapping="false"/>
								<ObjectStatus text="{view>statusText}" state="{view>statusState}" icon="{view>statusIcon}"/>
								<Text text="{view>views}"/>
								<Text text="{view>bc}"/>
								<rc:PersonLink name="{view>owner}"/>
								<Text text="{view>changed}" wrapping="false" textDirection="LTR"/>
								<Button icon="{= ${view>fav} ? 'sap-icon://favorite' : 'sap-icon://unfavorite' }" type="Transparent"
									tooltip="{= ${view>fav} ? ${i18n>cat.unfav} : ${i18n>cat.fav} }" press=".onFav" class="repoioCatStar"/>
							</ColumnListItem>
						</items>
					</Table>
					<rc:Pager total="{view>/rl/count}" page="{view>/rl/page}" pageSize="{view>/rl/size}" change=".onPage"/>
				</ScrollContainer>
			</VBox>
		</HBox>
	</VBox>
</mvc:View>
