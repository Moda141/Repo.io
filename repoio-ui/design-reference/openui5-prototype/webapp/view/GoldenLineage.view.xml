<mvc:View controllerName="repoio.proto.controller.GoldenLineage"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:f="sap.f" xmlns:core="sap.ui.core" xmlns:rc="repoio.proto.control">
	<!-- J2: a customer's column lineage, full screen: sources → pipeline → golden record → consumers, with the customer's own
	     values on the columns. Lineage comes from the catalog (OpenLineage events); the page only draws it. -->
	<f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="false" fitContent="true" class="repoioEdge repoioGlPage">
		<f:title>
			<f:DynamicPageTitle>
				<f:breadcrumbs>
					<Breadcrumbs currentLocationText="{i18n>go.s.lineage}">
						<Link text="{i18n>nav.goldenRecords}" press=".onList"/>
						<Link text="{view>/gl/name}" press=".onRecord"/>
					</Breadcrumbs>
				</f:breadcrumbs>
				<f:heading>
					<Title text="{view>/gl/title}" level="H1"/>
				</f:heading>
				<f:actions>
					<Button text="{i18n>gl.back}" type="Transparent" press=".onRecord"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<FlexBox wrap="Wrap" alignItems="End" class="repoioGlBar">
					<VBox>
						<Label text="{i18n>gl.column}" labelFor="glCol"/>
						<Select id="glCol" selectedKey="{view>/gl/col}" items="{view>/gl/cols}" width="16rem" change=".onCol" forceSelection="false">
							<core:ListItem key="{view>key}" text="{view>text}" additionalText="{view>value}"/>
						</Select>
					</VBox>
					<Text text="{i18n>gl.hint}" class="repoioUmMuted repoioGlHint"/>
				</FlexBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<rc:ColumnLineage id="glLineage" height="100%" select=".onSelect" nodePress=".onNode"/>
		</f:content>
	</f:DynamicPage>
</mvc:View>
