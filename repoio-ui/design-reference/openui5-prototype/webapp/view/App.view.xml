<mvc:View
	controllerName="repoio.proto.controller.App"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:tnt="sap.tnt"
	displayBlock="true"
	height="100%">
	<!-- The side navigation starts collapsed (icons only); the menu button opens it -->
	<tnt:ToolPage id="toolPage" sideExpanded="false">
		<tnt:header>
			<tnt:ToolHeader id="toolHeader">
				<Button id="menuButton" icon="sap-icon://menu2" type="Transparent" press=".onToggleSide"
					tooltip="{i18n>shell.menu}" ariaLabel="{i18n>shell.menu}">
					<layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
				</Button>
				<!-- Back to the page this one was opened from (shown only when there is one) -->
				<Button id="backBtn" icon="sap-icon://nav-back" type="Transparent" press=".onBack" visible="{view>/shell/canBack}"
					tooltip="{view>/shell/backTip}" ariaLabel="{view>/shell/backTip}">
					<layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
				</Button>
				<Image src="img/logo.png" height="1.75rem" alt="Repo.io" press=".onHome" class="repoioLogo" decorative="false"/>
				<SearchField id="navSearch" width="22rem" class="repoioNavSearch" placeholder="{i18n>shell.navSearch}"
					liveChange=".onNavSearch" search=".onNavSearch" ariaLabel="{i18n>shell.navSearch}">
					<layoutData><OverflowToolbarLayoutData priority="Low" shrinkable="true" minWidth="10rem"/></layoutData>
				</SearchField>
				<ToolbarSpacer/>
				<Text text="{i18n>shell.prototype}" class="repoioProtoBadge">
					<layoutData><OverflowToolbarLayoutData priority="Low"/></layoutData>
				</Text>
				<Button id="inboxBtn" icon="sap-icon://inbox" text="4" type="Transparent" tooltip="{i18n>shell.inbox}"
					ariaLabel="{i18n>shell.inbox}" press=".onInbox"/>
				<Button id="bellBtn" icon="sap-icon://bell" type="Transparent" tooltip="{i18n>shell.notifications}" ariaLabel="{i18n>shell.notifications}" press=".onNotifications"/>
				<!-- Help: guided tours (platform tour for the user's roles, the current page's tour, preview as another role) and the user guide -->
				<MenuButton id="helpBtn" icon="sap-icon://sys-help" type="Transparent" tooltip="{i18n>help.title}" ariaLabel="{i18n>help.title}">
					<menu>
						<Menu itemSelected=".onHelp">
							<MenuItem key="platform" text="{i18n>help.platform}" icon="sap-icon://travel-request"/>
							<MenuItem key="page" text="{i18n>help.page}" icon="sap-icon://hint" enabled="{view>/shell/pageTour}"/>
							<MenuItem text="{i18n>help.preview}" icon="sap-icon://role" startsSection="true">
								<items>
									<MenuItem key="as:steward" text="{i18n>help.as.steward}"/>
									<MenuItem key="as:author" text="{i18n>help.as.author}"/>
									<MenuItem key="as:admin" text="{i18n>help.as.admin}"/>
									<MenuItem key="as:viewer" text="{i18n>help.as.viewer}"/>
								</items>
							</MenuItem>
							<MenuItem key="guide" text="{i18n>help.guide}" icon="sap-icon://course-book" startsSection="true"/>
						</Menu>
					</menu>
				</MenuButton>
				<MenuButton id="langBtn" text="{i18n>shell.languageBtn}" icon="sap-icon://world" type="Transparent" tooltip="{i18n>shell.languageTip}">
					<menu>
						<Menu id="langMenu" itemSelected=".onLanguage">
							<MenuItem key="en" text="English"/>
							<MenuItem key="ar" text="العربية"/>
						</Menu>
					</menu>
				</MenuButton>
				<Avatar id="userAvatar" initials="MM" displaySize="XS" tooltip="{i18n>shell.user}" ariaLabel="{i18n>shell.user}" press=".onUser" class="repoioUserAvatar"/>
			</tnt:ToolHeader>
		</tnt:header>
		<tnt:sideContent>
			<tnt:SideNavigation id="sideNavigation" itemSelect=".onNavSelect" ariaLabel="{i18n>appTitle}">
				<tnt:NavigationList id="navList"/>
			</tnt:SideNavigation>
		</tnt:sideContent>
		<tnt:mainContents>
			<!-- autoFocus off: UI5 otherwise focuses the first title or breadcrumb on every navigation, which shows a focus ring as if it were selected. Keyboard users start with Tab. -->
			<NavContainer id="pageContainer" autoFocus="false"/>
		</tnt:mainContents>
	</tnt:ToolPage>
</mvc:View>
