<mvc:View controllerName="repoio.proto.controller.DomainOverview"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:core="sap.ui.core" xmlns:rc="repoio.proto.control">
	<!-- Domain overview (SAP Fiori Overview Page pattern): variant and filter bar over a grid of cards. Analytic cards
	     carry one KPI in a numeric header with a "By ..." switch and a chart; list cards link to the repositories and to
	     the work pages of this domain. Read only: every figure comes from the domain, repository and stewardship APIs. -->
	<f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="true" class="repoioEdge repoioDo">
		<f:title>
			<f:DynamicPageTitle>
				<f:breadcrumbs>
					<Breadcrumbs currentLocationText="{view>/do/name}">
						<Link text="{i18n>nav.domains}" press=".onToCatalog"/>
					</Breadcrumbs>
				</f:breadcrumbs>
				<f:heading>
					<HBox alignItems="Center" renderType="Bare">
						<core:Icon src="{view>/do/icon}" class="repoioDoIcon" decorative="true"/>
						<Title text="{view>/do/name}" level="H2" wrapping="false"/>
						<MenuButton text="{i18n>do.variant.standard}" type="Transparent" class="repoioGrVariant repoioDoVariant">
							<menu><Menu><MenuItem text="{i18n>do.variant.standard}" icon="sap-icon://accept"/></Menu></menu>
						</MenuButton>
					</HBox>
				</f:heading>
				<f:expandedContent>
					<HBox alignItems="Center" wrap="Wrap" renderType="Bare" class="repoioPersonLine">
						<Text text="{view>/do/summary}" class="repoioUmMuted"/>
						<Text text="·" class="repoioUmMuted repoioPersonSep"/>
						<Text text="{i18n>do.owner}" class="repoioUmMuted"/>
						<rc:PersonLink name="{view>/do/owner}" showName="true"/>
					</HBox>
				</f:expandedContent>
				<f:snappedContent>
					<Text text="{view>/do/filterText}" class="repoioUmMuted"/>
				</f:snappedContent>
				<f:actions>
					<Button text="{i18n>crepo.button}" icon="sap-icon://add" type="Emphasized" press=".onCreateRepo"/>
					<Button icon="sap-icon://action" type="Transparent" tooltip="{i18n>gr.share}" press=".onShare"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<FlexBox wrap="Wrap" alignItems="End" class="repoioGrFilters">
					<VBox class="repoioGrFilter">
						<Label text="{i18n>gr.f.repo}" labelFor="doRepo"/>
						<MultiComboBox id="doRepo" selectedKeys="{view>/do/f/repos}" items="{view>/do/repoOpts}" width="100%" selectionFinish=".onFilter"
							placeholder="{i18n>common.all}">
							<core:Item key="{view>key}" text="{view>text}"/>
						</MultiComboBox>
					</VBox>
					<VBox class="repoioGrFilter">
						<Label text="{i18n>do.f.source}" labelFor="doSrc"/>
						<MultiComboBox id="doSrc" selectedKeys="{view>/do/f/sources}" items="{view>/do/srcOpts}" width="100%" selectionFinish=".onFilter"
							placeholder="{i18n>common.all}">
							<core:Item key="{view>key}" text="{view>text}"/>
						</MultiComboBox>
					</VBox>
					<Button text="{i18n>do.clear}" type="Transparent" press=".onClear" enabled="{view>/do/hasFilter}" class="repoioDoClear"/>
				</FlexBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox renderType="Bare">
				<!-- The domain has no repository yet: an empty state instead of empty cards -->
				<IllustratedMessage illustrationType="sapIllus-NoData" title="{i18n>do.empty.title}" description="{i18n>do.empty.desc}"
					visible="{= !${view>/do/hasRepos} }"/>
				<!-- Cards flow in rows of equal width and keep their natural height (Overview Page card layout) -->
				<FlexBox id="doGrid" visible="{view>/do/hasRepos}" wrap="Wrap" alignItems="Start" renderType="Bare" class="repoioDoGrid">
					<items>
						<!-- Analytic cards: header KPI, a "By ..." switch, and the chart -->
						<f:Card class="repoioDoCard">
							<f:header>
								<card:NumericHeader title="{i18n>do.c.golden}" subtitle="{view>/do/c/golden/sub}" number="{view>/do/c/golden/num}" scale="{view>/do/c/golden/scale}"
									details="{i18n>do.c.goldenDetails}" state="Neutral" press=".onCardGolden"/>
							</f:header>
							<f:content>
								<VBox renderType="Bare" class="repoioDoBody">
									<Select selectedKey="{view>/do/c/golden/by}" change=".onBy" width="11rem" class="repoioDoBy" ariaLabelledBy="doGoldenBy">
										<core:Item key="repo" text="{i18n>do.by.repo}"/>
										<core:Item key="source" text="{i18n>do.by.sourceRows}"/>
									</Select>
									<core:InvisibleText id="doGoldenBy" text="{i18n>do.c.golden}"/>
									<Label text="{view>/do/c/golden/chartTitle}" class="repoioDoChartTitle"/>
									<rc:EChart option="{view>/do/c/golden/option}" width="100%" height="9.5rem" ariaLabel="{i18n>do.c.golden}"/>
								</VBox>
							</f:content>
						</f:Card>
						<f:Card class="repoioDoCard">
							<f:header>
								<card:NumericHeader title="{i18n>do.c.quality}" subtitle="{view>/do/c/quality/sub}" number="{view>/do/c/quality/num}" unitOfMeasurement="%"
									details="{view>/do/c/quality/details}" state="{view>/do/c/quality/state}" trend="{view>/do/c/quality/trend}">
									<card:sideIndicators>
										<card:NumericSideIndicator title="{i18n>do.target}" number="{view>/do/c/quality/target}" unit="%"/>
										<card:NumericSideIndicator title="{i18n>do.gap}" number="{view>/do/c/quality/gap}" unit="%"/>
									</card:sideIndicators>
								</card:NumericHeader>
							</f:header>
							<f:content>
								<VBox renderType="Bare" class="repoioDoBody">
									<Select selectedKey="{view>/do/c/quality/by}" change=".onBy" width="11rem" class="repoioDoBy">
										<core:Item key="repo" text="{i18n>do.by.repo}"/>
										<core:Item key="source" text="{i18n>do.by.source}"/>
									</Select>
									<Label text="{view>/do/c/quality/chartTitle}" class="repoioDoChartTitle"/>
									<rc:EChart option="{view>/do/c/quality/option}" width="100%" height="9.5rem" ariaLabel="{i18n>do.c.quality}"/>
								</VBox>
							</f:content>
						</f:Card>
						<f:Card class="repoioDoCard">
							<f:header>
								<card:NumericHeader title="{i18n>do.c.match}" subtitle="{view>/do/c/match/sub}" number="{view>/do/c/match/num}"
									details="{view>/do/c/match/details}" state="{view>/do/c/match/state}" press=".onCardMatch"/>
							</f:header>
							<f:content>
								<VBox renderType="Bare" class="repoioDoBody">
									<Select selectedKey="{view>/do/c/match/by}" change=".onBy" width="11rem" class="repoioDoBy">
										<core:Item key="repo" text="{i18n>do.by.repo}"/>
										<core:Item key="kind" text="{i18n>do.by.kind}"/>
									</Select>
									<Label text="{view>/do/c/match/chartTitle}" class="repoioDoChartTitle"/>
									<rc:EChart option="{view>/do/c/match/option}" width="100%" height="9.5rem" ariaLabel="{i18n>do.c.match}"/>
								</VBox>
							</f:content>
						</f:Card>
						<f:Card class="repoioDoCard">
							<f:header>
								<card:NumericHeader title="{i18n>do.c.quarantine}" subtitle="{view>/do/c/qa/sub}" number="{view>/do/c/qa/num}"
									details="{view>/do/c/qa/details}" state="{view>/do/c/qa/state}" press=".onCardQuarantine"/>
							</f:header>
							<f:content>
								<VBox renderType="Bare" class="repoioDoBody">
									<Select selectedKey="{view>/do/c/qa/by}" change=".onBy" width="11rem" class="repoioDoBy">
										<core:Item key="rule" text="{i18n>do.by.rule}"/>
										<core:Item key="source" text="{i18n>do.by.source}"/>
									</Select>
									<Label text="{view>/do/c/qa/chartTitle}" class="repoioDoChartTitle"/>
									<rc:EChart option="{view>/do/c/qa/option}" width="100%" height="9.5rem" ariaLabel="{i18n>do.c.quarantine}"/>
								</VBox>
							</f:content>
						</f:Card>

						<!-- List card: every repository name opens the repository page -->
						<f:Card class="repoioDoCard">
							<f:header>
								<card:Header title="{i18n>do.c.repos}" subtitle="{view>/do/reposSub}" iconSrc="sap-icon://database"/>
							</f:header>
							<f:content>
								<List items="{view>/do/repos}" showSeparators="Inner" class="repoioDoList" noDataText="{i18n>do.noRepos}">
									<CustomListItem>
										<VBox renderType="Bare" class="repoioDoItem">
											<HBox justifyContent="SpaceBetween" alignItems="Center" renderType="Bare">
												<Link text="{view>name}" press=".onRepo" wrapping="false" emphasized="true"/>
												<ObjectStatus text="{view>healthText}" state="{view>healthState}" icon="{view>healthIcon}"/>
											</HBox>
											<Text text="{view>meta}" class="repoioUmMuted" wrapping="false"/>
										</VBox>
									</CustomListItem>
								</List>
							</f:content>
						</f:Card>
						<!-- Link list card: the work pages of this domain -->
						<f:Card class="repoioDoCard">
							<f:header>
								<card:Header title="{i18n>do.c.links}" subtitle="{i18n>do.c.linksSub}" iconSrc="sap-icon://chain-link"/>
							</f:header>
							<f:content>
								<List items="{view>/do/links}" showSeparators="Inner" class="repoioDoList">
									<CustomListItem>
										<HBox alignItems="Center" renderType="Bare" class="repoioDoItem">
											<core:Icon src="{view>icon}" class="repoioDoLinkIcon" decorative="true"/>
											<VBox renderType="Bare">
												<Link text="{view>text}" press=".onLink"/>
												<Text text="{view>sub}" class="repoioUmMuted"/>
											</VBox>
										</HBox>
									</CustomListItem>
								</List>
							</f:content>
						</f:Card>
						<!-- Donut: where the domain's source records come from -->
						<f:Card class="repoioDoCard">
							<f:header>
								<card:NumericHeader title="{i18n>do.c.sources}" subtitle="{i18n>do.c.sourcesSub}" number="{view>/do/c/src/num}" scale="{view>/do/c/src/scale}"
									details="{i18n>do.c.sourcesDetails}" state="Neutral"/>
							</f:header>
							<f:content>
								<VBox renderType="Bare" class="repoioDoBody">
									<rc:EChart option="{view>/do/c/src/option}" width="100%" height="12rem" ariaLabel="{i18n>do.c.sources}"/>
								</VBox>
							</f:content>
						</f:Card>
					</items>
				</FlexBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
