<mvc:View controllerName="repoio.proto.controller.Domain"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:f="sap.f" xmlns:core="sap.ui.core" xmlns:rc="repoio.proto.control">
	<!-- Spaces page pattern (reference: sap-s4hana/patterns/spaces-page.png): repositories of one domain -->
	<f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="true">
		<f:title>
			<f:DynamicPageTitle>
				<f:breadcrumbs>
					<Breadcrumbs currentLocationText="{view>/domain/name}">
						<Link text="{i18n>nav.domains}" press=".onToDomains"/>
					</Breadcrumbs>
				</f:breadcrumbs>
				<f:heading><Title text="{view>/domain/name}" level="H1"/></f:heading>
				<f:expandedContent><Text text="{i18n>domain.entity}: {view>/domain/nameEn} · {view>/domain/teamText} · {i18n>domain.owner}: {view>/domain/owner}"/></f:expandedContent>
				<f:snappedContent><Text text="{view>/domain/summary}"/></f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<FlexBox wrap="Wrap" alignItems="Start" justifyContent="SpaceBetween">
				<VBox>
					<!-- Count + status icons, as in the Spaces header -->
					<HBox alignItems="Center" class="sapUiSmallMarginBottom">
						<Label text="{i18n>domains.col.repos}" class="sapUiTinyMarginEnd"/>
						<Title text="{view>/domain/repoCount}" level="H3" class="sapUiSmallMarginEnd"/>
						<core:Icon src="sap-icon://group" color="#0a6ed1" class="sapUiTinyMarginEnd" tooltip="{i18n>repo.owners}"/>
						<Text text="{view>/domain/ownerCount}" class="sapUiSmallMarginEnd"/>
						<core:Icon src="sap-icon://sys-enter-2" color="#107e3e" class="sapUiTinyMarginEnd" tooltip="{i18n>health.healthy}"/>
						<Text text="{view>/domain/healthy}" class="sapUiSmallMarginEnd"/>
						<core:Icon src="sap-icon://alert" color="#e9730c" class="sapUiTinyMarginEnd" tooltip="{i18n>health.attention}"/>
						<Text text="{view>/domain/attention}" class="sapUiSmallMarginEnd"/>
						<core:Icon src="sap-icon://edit" color="#0a6ed1" class="sapUiTinyMarginEnd" tooltip="{i18n>status.draft}"/>
						<Text text="{view>/domain/drafts}" class="sapUiSmallMarginEnd"/>
						<core:Icon src="sap-icon://locked" color="#6a6d70" class="sapUiTinyMarginEnd" tooltip="{i18n>status.archived}"/>
						<Text text="{view>/domain/archived}"/>
					</HBox>
					<FlexBox wrap="Wrap">
					<VBox width="12rem" class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
						<Label text="{i18n>space.goldenUsed}"/>
						<ProgressIndicator percentValue="{view>/domain/capPct}" displayValue="{view>/domain/capText}" state="Information" displayOnly="true" height="1rem"/>
					</VBox>
					<VBox width="12rem" class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
						<Label text="{i18n>domain.avgQuality}"/>
						<ProgressIndicator percentValue="{= ${view>/domain/quality} || 0 }" displayValue="{path: 'view>/domain/quality', formatter: '.fmt.pct'}" state="{view>/domain/qualityState}" displayOnly="true" height="1rem"/>
					</VBox>
					<VBox width="12rem" class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
						<Label text="{i18n>space.sourcesUsed}"/>
						<ProgressIndicator percentValue="{view>/domain/srcPct}" displayValue="{view>/domain/srcText}" state="Information" displayOnly="true" height="1rem"/>
					</VBox>
					</FlexBox>
				</VBox>
					<VBox width="13rem" class="sapUiSmallMarginBottom" visible="{= ${view>/domain/repoCount} > 0 }">
						<Label text="{i18n>space.statusChart}"/>
						<rc:EChart id="statusChart" height="5.5rem" ariaLabel="{i18n>space.statusChart}"/>
					</VBox>
				</FlexBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox>
				<OverflowToolbar style="Clear" class="sapUiSmallMarginBottom">
					<Title text="{view>/domain/repoText}" level="H2"/>
					<ToolbarSpacer/>
					<Button text="{i18n>common.create}" type="Transparent" press=".onAddRepo"/>
					<Button text="{i18n>common.edit}" type="Transparent" enabled="{= ${view>/domain/selected} === 1 }"/>
					<Button text="{i18n>common.delete}" type="Transparent" enabled="{= ${view>/domain/selected} > 0 }"/>
					<Button text="{i18n>repo.publish}" type="Transparent" enabled="{= ${view>/domain/selected} > 0 }"/>
					<Button text="{i18n>repo.runMatch}" type="Transparent" enabled="{= ${view>/domain/selected} > 0 }"/>
					<Button text="{i18n>space.monitor}" type="Transparent"/>
					<SegmentedButton selectedKey="{view>/domain/mode}">
						<items>
							<SegmentedButtonItem key="cards" icon="sap-icon://grid" tooltip="{i18n>domain.cards}"/>
							<SegmentedButtonItem key="table" icon="sap-icon://list" tooltip="{i18n>domain.table}"/>
						</items>
					</SegmentedButton>
					<SearchField width="12rem" liveChange=".onSearch" placeholder="{i18n>common.search}"/>
				</OverflowToolbar>

				<IllustratedMessage visible="{= ${view>/domain/repoCount} === 0 }" illustrationType="sapIllus-NoData" illustrationSize="Dialog"
					title="{i18n>domain.emptyTitle}" description="{i18n>domain.emptyText}">
					<additionalContent><Button text="{i18n>domain.addRepo}" type="Emphasized" press=".onAddRepo"/></additionalContent>
				</IllustratedMessage>

				<!-- Space cards -->
				<f:GridContainer items="{view>/domain/repos}" visible="{= ${view>/domain/mode} === 'cards' &amp;&amp; ${view>/domain/repoCount} > 0 }">
					<f:layout><f:GridContainerSettings rowSize="5rem" columnSize="3.75rem" gap="0.75rem"/></f:layout>
					<f:items>
						<f:Card>
							<f:layoutData><f:GridContainerItemLayoutData columns="4" minRows="4"/></f:layoutData>
							<f:content>
								<VBox class="repoioSpaceCard" width="100%">
									<HBox justifyContent="SpaceBetween" alignItems="Start">
										<VBox>
											<Link text="{view>code}" press=".onRepoPress" class="repoioSpaceCode"/>
											<Label text="{view>name}"/>
										</VBox>
										<CheckBox selected="{view>selected}" select=".onCardSelect" ariaLabelledBy=""/>
									</HBox>
									<core:HTML content="&lt;div class='repoioSpaceDivider'&gt;&lt;/div&gt;"/>
									<ObjectStatus text="{path: 'view>healthKey', formatter: '.healthText'}" state="{view>healthState}"
										icon="{= ${view>healthState} === 'Success' ? 'sap-icon://sys-enter-2' : ${view>healthState} === 'Information' ? 'sap-icon://edit' : ${view>healthState} === 'None' ? 'sap-icon://locked' : 'sap-icon://alert' }"/>
									<Text text="{view>deployedText}" class="sapUiTinyMarginTop sapUiSmallMarginBottom"/>
									<Label text="{i18n>space.capacity}:"/>
									<ProgressIndicator percentValue="{view>capPct}" displayValue="{view>capText}" state="Information" displayOnly="true" height="0.875rem" class="sapUiSmallMarginBottom"/>
									<Label text="{i18n>domains.col.quality}:"/>
									<ProgressIndicator percentValue="{view>quality}" displayValue="{path: 'view>quality', formatter: '.fmt.pct'}" state="{view>qualityState}" displayOnly="true" height="0.875rem" class="sapUiSmallMarginBottom"/>
									<HBox><GenericTag text="{view>model}" design="StatusIconHidden" press=".onRepoPress"/></HBox>
									<HBox justifyContent="SpaceBetween" alignItems="Center" class="repoioSpaceFoot">
										<HBox alignItems="Center">
											<core:Icon src="sap-icon://database" class="sapUiTinyMarginEnd" tooltip="{i18n>repo.sources}"/><Text text="{view>sourceIds/length}" class="sapUiSmallMarginEnd"/>
											<core:Icon src="sap-icon://process" class="sapUiTinyMarginEnd" tooltip="{i18n>space.pipes}"/><Text text="{view>pipes}" class="sapUiSmallMarginEnd"/>
											<core:Icon src="sap-icon://group" class="sapUiTinyMarginEnd" tooltip="{i18n>repo.owners}"/><Text text="{view>owners/length}"/>
										</HBox>
										<Button text="{i18n>common.edit}" press=".onRepoPress"/>
									</HBox>
								</VBox>
							</f:content>
						</f:Card>
					</f:items>
				</f:GridContainer>

				<!-- Table view -->
				<Table id="repoTable" items="{view>/domain/repos}" mode="MultiSelect" popinLayout="GridSmall" selectionChange=".onTableSelect"
					visible="{= ${view>/domain/mode} === 'table' &amp;&amp; ${view>/domain/repoCount} > 0 }">
					<columns>
						<Column width="24%"><Text text="{i18n>repo.repository}"/></Column>
						<Column><Text text="{i18n>domains.col.status}"/></Column>
						<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>repo.model}"/></Column>
						<Column minScreenWidth="Tablet" demandPopin="true" width="16%"><Text text="{i18n>space.capacity}"/></Column>
						<Column hAlign="End"><Text text="{i18n>domains.col.quality}"/></Column>
						<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>repo.sources}"/></Column>
						<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>repo.deployed}"/></Column>
					</columns>
					<items>
						<ColumnListItem type="Navigation" press=".onRepoPress">
							<VBox><Link text="{view>code}" press=".onRepoPress" class="repoioIdLink"/><Text text="{view>name}" class="repoioMuted"/></VBox>
							<ObjectStatus text="{path: 'view>healthKey', formatter: '.healthText'}" state="{view>healthState}"/>
							<Text text="{view>model}"/>
							<ProgressIndicator percentValue="{view>capPct}" displayValue="{view>capText}" state="Information" displayOnly="true" height="0.875rem"/>
							<ObjectNumber number="{path: 'view>quality', formatter: '.fmt.pct'}" state="{view>qualityState}"/>
							<Text text="{view>sourceNames}"/>
							<Text text="{view>deployedText}"/>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
