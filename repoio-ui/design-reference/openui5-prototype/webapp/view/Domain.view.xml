<mvc:View controllerName="repoio.proto.controller.Domain"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:rc="repoio.proto.control" xmlns:f="sap.f" xmlns:core="sap.ui.core">
	<!-- SAP Datasphere "Data Builder" layout: domain selector, create tiles, all repositories -->
	<f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="true" class="repoioDsp">
		<f:title>
			<f:DynamicPageTitle>
				<f:breadcrumbs>
					<Breadcrumbs currentLocationText="{view>/domain/name}">
						<Link text="{i18n>nav.domains}" press=".onToDomains"/>
					</Breadcrumbs>
				</f:breadcrumbs>
				<f:heading>
					<HBox alignItems="Center">
						<Title text="{i18n>dsp.builder}" level="H1" class="sapUiSmallMarginEnd"/>
						<Label text="{i18n>home.filter.domain}:" class="sapUiTinyMarginEnd" labelFor="domainSelect"/>
						<Select id="domainSelect" items="{path: 'view>/domain/options', templateShareable: false}" selectedKey="{view>/domain/id}" change=".onDomainChange" width="12rem">
							<core:Item key="{view>key}" text="{view>text}"/>
						</Select>
					</HBox>
				</f:heading>
				<f:snappedContent><Text text="{view>/domain/summary}"/></f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<VBox>
					<Title text="{i18n>dsp.newTitle}" level="H5" class="sapUiTinyMarginBottom"/>
					<FlexBox wrap="Wrap" items="{path: 'view>/domain/newTiles', templateShareable: false}">
						<Button text="{view>text}" icon="{view>icon}" press=".onNewTile" width="11rem" class="repoioNewTile sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
					</FlexBox>
				</VBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox>
				<IllustratedMessage visible="{= ${view>/domain/repoCount} === 0 }" illustrationType="sapIllus-NoData" illustrationSize="Dialog"
					title="{i18n>domain.emptyTitle}" description="{i18n>domain.emptyText}">
					<additionalContent><Button text="{i18n>domain.addRepo}" type="Emphasized" press=".onAddRepo"/></additionalContent>
				</IllustratedMessage>
				<Table id="repoTable" items="{view>/domain/repos}" mode="MultiSelect" popinLayout="GridSmall" sticky="ColumnHeaders,HeaderToolbar"
					selectionChange=".onTableSelect" visible="{= ${view>/domain/repoCount} > 0 }" noDataText="{i18n>home.noMatch}">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="{view>/domain/repoText}" level="H2"/>
							<ToolbarSpacer/>
							<SearchField width="12rem" liveChange=".onSearch" placeholder="{i18n>common.search}"/>
							<Select selectedKey="{view>/domain/status}" change=".onStatus" width="9rem">
								<core:Item key="all" text="{i18n>dsp.allStatus}"/>
								<core:Item key="deployed" text="{i18n>status.deployed}"/>
								<core:Item key="draft" text="{i18n>status.draft}"/>
								<core:Item key="archived" text="{i18n>status.archived}"/>
							</Select>
							<ToolbarSeparator/>
							<Button text="{i18n>common.edit}" type="Transparent" enabled="{= ${view>/domain/selected} === 1 }" press=".onEditSelected"/>
							<Button text="{i18n>repo.publish}" type="Transparent" enabled="{= ${view>/domain/selected} > 0 }"/>
							<Button text="{i18n>dsp.share}" type="Transparent" enabled="{= ${view>/domain/selected} > 0 }"/>
							<Button text="{i18n>common.delete}" type="Transparent" enabled="{= ${view>/domain/selected} > 0 }"/>
							<Button icon="sap-icon://action-settings" type="Transparent" tooltip="{i18n>alp.settings}"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column width="22%"><Text text="{i18n>dsp.businessName}"/></Column>
						<Column minScreenWidth="Tablet" demandPopin="true" width="13rem"><Text text="{i18n>dsp.technicalName}"/></Column>
						<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>repo.model}"/></Column>
						<Column><Text text="{i18n>dsp.deployStatus}"/></Column>
						<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>dsp.health}"/></Column>
						<Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>repo.golden}"/></Column>
						<Column hAlign="End"><Text text="{i18n>domains.col.quality}"/></Column>
						<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>dsp.changedOn}"/></Column>
						<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>dsp.changedBy}"/></Column>
					</columns>
					<items>
						<ColumnListItem type="Navigation" press=".onRepoPress">
							<HBox alignItems="Center">
								<core:Icon src="sap-icon://badge" class="sapUiSmallMarginEnd" color="Default"/>
								<Link text="{view>name}" press=".onRepoPress"/>
							</HBox>
							<Text text="{view>code}" wrapping="false"/>
							<Text text="{view>model}"/>
							<ObjectStatus text="{view>deployText}" state="{view>deployState}" icon="{view>deployIcon}"/>
							<ObjectStatus text="{path: 'view>healthKey', formatter: '.healthText'}" state="{view>healthState}"/>
							<Text text="{path: 'view>golden', formatter: '.fmt.num'}"/>
							<ObjectNumber number="{path: 'view>quality', formatter: '.fmt.pct'}" state="{view>qualityState}"/>
							<Text text="{view>changedOn}"/>
							<rc:PersonLink name="{view>changedBy}"/>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
