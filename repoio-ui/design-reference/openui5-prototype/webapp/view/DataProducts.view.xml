<mvc:View controllerName="repoio.proto.controller.DataProducts"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:core="sap.ui.core" xmlns:rc="repoio.proto.control"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<!-- Data products (SAP Business Data Cloud cockpit "Catalog" pattern): one card per repository's published golden table,
	     a search bar, a filter panel with counts, cards or a list. Read only: opening a card shows the data product page,
	     "Connect" shows the repository connection details (ADR-0006). The list is filtered server-side by domain grants. -->
	<f:DynamicPage id="page" headerExpanded="true" showFooter="false" class="repoioDp repoioEdge">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="{i18n>nav.dataProducts}" level="H1"/></f:heading>
				<f:snappedContent><Text text="{view>/dp/resultText}"/></f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<VBox class="repoioDpHero" renderType="Bare">
					<Text text="{i18n>dp.subtitle}" class="repoioDpHeroText"/>
					<HBox alignItems="Center" class="repoioDpKpis" renderType="Bare" items="{view>/dp/kpis}">
						<VBox class="repoioDpKpi" renderType="Bare">
							<Label text="{view>label}"/>
							<ObjectNumber number="{view>value}" unit="{view>unit}" state="{view>state}" emphasized="true" class="sapMObjectNumberLarge" textDirection="LTR"/>
						</VBox>
					</HBox>
				</VBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox renderType="Bare">
				<OverflowToolbar style="Clear" class="repoioDpBar">
					<ToggleButton icon="sap-icon://filter" type="Transparent" pressed="{view>/dp/showFilters}" tooltip="{i18n>cat.filters}"/>
					<SearchField value="{view>/dp/q}" liveChange=".onSearch" search=".onSearch" placeholder="{i18n>dp.search}" width="22rem">
						<layoutData><OverflowToolbarLayoutData shrinkable="true" minWidth="12rem"/></layoutData>
					</SearchField>
					<Title text="{view>/dp/resultText}" level="H2" titleStyle="H6" class="sapUiSmallMarginBegin"/>
					<Link text="{i18n>cat.clearAll}" visible="{= ${view>/dp/active} > 0 }" press=".onClearFacets"/>
					<ToolbarSpacer/>
					<Label text="{i18n>dp.sortBy}" labelFor="dpSort"/>
					<Select id="dpSort" selectedKey="{view>/dp/sort}" change=".onSort" width="11rem">
						<core:Item key="name" text="{i18n>dp.sort.name}"/>
						<core:Item key="records" text="{i18n>dp.sort.records}"/>
						<core:Item key="quality" text="{i18n>dp.sort.quality}"/>
						<core:Item key="updated" text="{i18n>dp.sort.updated}"/>
					</Select>
					<SegmentedButton selectedKey="{view>/dp/mode}">
						<items>
							<SegmentedButtonItem key="cards" icon="sap-icon://grid" tooltip="{i18n>domain.cards}"/>
							<SegmentedButtonItem key="list" icon="sap-icon://list" tooltip="{i18n>domain.table}"/>
						</items>
					</SegmentedButton>
				</OverflowToolbar>

				<FlexBox alignItems="Stretch" class="repoioDpBody" renderType="Bare">
					<customData><core:CustomData key="mode" value="{view>/dp/mode}" writeToDom="true"/></customData>
					<!-- Filter panel: facet groups with counts (counts follow the other active facets). -->
					<VBox visible="{view>/dp/showFilters}" width="15rem" class="repoioFacetPanel repoioDpFacets" items="{view>/dp/facets}">
						<VBox renderType="Bare">
							<Title text="{view>title}" level="H3" class="repoioFacetGroup"/>
							<List items="{path: 'view>values', templateShareable: false}" mode="MultiSelect" includeItemNavigation="false" selectionChange=".onFacetChange"
								showSeparators="None" class="repoioFacetList" app:facet="{view>key}">
								<StandardListItem title="{view>text}" icon="{view>icon}" counter="{view>count}" selected="{view>selected}"/>
							</List>
						</VBox>
					</VBox>

					<VBox width="100%" class="repoioDpResults" renderType="Bare">
						<layoutData><FlexItemData growFactor="1" shrinkFactor="1" minWidth="0"/></layoutData>
						<IllustratedMessage visible="{= ${view>/dp/items}.length === 0 }" illustrationType="sapIllus-NoSearchResults" illustrationSize="Dialog"
							title="{i18n>cat.noResults}" description="{i18n>dp.noResultsHint}"/>

						<f:GridContainer items="{view>/dp/items}" visible="{= ${view>/dp/mode} === 'cards' &amp;&amp; ${view>/dp/items}.length > 0 }" containerQuery="true"
							class="repoioDpGrid">
							<f:layout><f:GridContainerSettings rowSize="5rem" columnSize="5rem" gap="1rem"/></f:layout>
							<f:layoutS><f:GridContainerSettings rowSize="5rem" columnSize="5rem" gap="0.5rem"/></f:layoutS>
							<f:items>
								<f:Card class="repoioDpCard">
									<f:layoutData><f:GridContainerItemLayoutData columns="4" rows="3"/></f:layoutData>
									<f:header>
										<card:Header title="{view>title}" subtitle="{view>typeLine}" iconSrc="{view>icon}" iconDisplayShape="Square"
											iconBackgroundColor="{view>color}" statusText="{view>versionText}" press=".onOpen"/>
									</f:header>
									<f:content>
										<VBox width="100%" class="repoioDpCardBody" renderType="Bare">
											<Text text="{view>desc}" maxLines="2" class="repoioDpDesc"/>
											<HBox wrap="Wrap" class="repoioDpFacts" renderType="Bare">
												<VBox class="repoioDpFact" renderType="Bare">
													<Label text="{i18n>dp.records}"/>
													<Text text="{view>goldenText}" textDirection="LTR"/>
												</VBox>
												<VBox class="repoioDpFact" renderType="Bare">
													<Label text="{i18n>dp.quality}"/>
													<ObjectStatus text="{view>qualityText}" state="{view>qualityState}" textDirection="LTR"/>
												</VBox>
												<VBox class="repoioDpFact" renderType="Bare">
													<Label text="{i18n>dp.sources}"/>
													<Text text="{view>sourceText}" maxLines="1" tooltip="{view>sourceText}"/>
												</VBox>
											</HBox>
											<HBox class="repoioDpTags" wrap="Wrap" renderType="Bare" items="{path: 'view>chips', templateShareable: false}">
												<ObjectStatus text="{view>text}" state="{view>state}" icon="{view>icon}" inverted="{view>inv}" class="repoioDpChip"/>
											</HBox>
											<HBox justifyContent="SpaceBetween" alignItems="Center" class="repoioDpFoot" renderType="Bare">
												<ObjectStatus text="{view>statusText}" state="{view>statusState}" icon="{view>statusIcon}"/>
												<HBox alignItems="Center" renderType="Bare">
													<Text text="{view>updatedText}" class="repoioDpUpdated"/>
													<Button icon="sap-icon://connected" type="Transparent" tooltip="{i18n>dp.connect}" enabled="{view>published}" press=".onConnect"/>
													<Button icon="{= ${view>fav} ? 'sap-icon://favorite' : 'sap-icon://unfavorite' }" type="Transparent"
														tooltip="{= ${view>fav} ? ${i18n>cat.unfav} : ${i18n>cat.fav} }" press=".onFav" class="repoioCatStar"/>
												</HBox>
											</HBox>
										</VBox>
									</f:content>
								</f:Card>
							</f:items>
						</f:GridContainer>

						<Table items="{view>/dp/items}" visible="{= ${view>/dp/mode} === 'list' &amp;&amp; ${view>/dp/items}.length > 0 }" popinLayout="GridSmall"
							sticky="ColumnHeaders" class="repoioDenseTable" mode="None">
							<columns>
								<Column width="28%"><Text text="{i18n>dp.col.name}"/></Column>
								<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>home.filter.domain}"/></Column>
								<Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="{i18n>dp.records}"/></Column>
								<Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="{i18n>dp.quality}"/></Column>
								<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>dp.sources}"/></Column>
								<Column><Text text="{i18n>domains.col.status}"/></Column>
								<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>dp.refreshed}"/></Column>
								<Column hAlign="End" width="6rem"><Text text=""/></Column>
							</columns>
							<items>
								<ColumnListItem type="Navigation" press=".onOpen">
									<HBox alignItems="Center" renderType="Bare">
										<Avatar src="{view>icon}" displayShape="Square" displaySize="XS" backgroundColor="{view>color}" class="sapUiSmallMarginEnd"/>
										<VBox renderType="Bare">
											<Text text="{view>title}" class="repoioGrName"/>
											<Text text="{view>versionText}" class="repoioUmMuted"/>
										</VBox>
									</HBox>
									<Text text="{view>domainText}"/>
									<Text text="{view>goldenText}" textDirection="LTR"/>
									<ObjectStatus text="{view>qualityText}" state="{view>qualityState}" textDirection="LTR"/>
									<Text text="{view>sourceText}"/>
									<ObjectStatus text="{view>statusText}" state="{view>statusState}" icon="{view>statusIcon}"/>
									<Text text="{view>updatedText}" wrapping="false"/>
									<HBox justifyContent="End" renderType="Bare">
										<Button icon="sap-icon://connected" type="Transparent" tooltip="{i18n>dp.connect}" enabled="{view>published}" press=".onConnect"/>
										<Button icon="{= ${view>fav} ? 'sap-icon://favorite' : 'sap-icon://unfavorite' }" type="Transparent"
											tooltip="{= ${view>fav} ? ${i18n>cat.unfav} : ${i18n>cat.fav} }" press=".onFav" class="repoioCatStar"/>
									</HBox>
								</ColumnListItem>
							</items>
						</Table>
					</VBox>
				</FlexBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
