<mvc:View controllerName="repoio.proto.controller.Streams"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:f="sap.f" xmlns:core="sap.ui.core" xmlns:rc="repoio.proto.control">
	<!-- J10 step 1: streaming jobs (standardise → DQ → match → survivorship) with consumer lag, checkpoints,
	     throughput and the dead-letter queue. DLQ growth raises an alert here; records are never dropped silently. -->
	<f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="false" class="repoioJrPage repoioEdge">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="{i18n>st.title}" level="H1"/></f:heading>
				<f:expandedContent><Text text="{i18n>st.subtitle}"/></f:expandedContent>
				<f:actions>
					<SegmentedButton selectedKey="streams" selectionChange=".onSwitch">
						<items>
							<SegmentedButtonItem key="runs" text="{i18n>st.seg.runs}" icon="sap-icon://history"/>
							<SegmentedButtonItem key="streams" text="{i18n>st.seg.streams}" icon="sap-icon://process"/>
						</items>
					</SegmentedButton>
					<Button icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>jr.a.refresh}" press=".onRefresh"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<VBox renderType="Bare">
				<MessageStrip text="{view>/st/alertText}" type="Error" showIcon="true" visible="{= !!${view>/st/alertText} }" class="repoioStAlert">
					<link><Link text="{i18n>st.openDlq}" press=".onDlqAlert"/></link>
				</MessageStrip>
				<!-- Summary tiles -->
				<FlexBox wrap="Wrap" class="repoioStKpis" items="{view>/st/kpis}">
					<VBox class="repoioJrPanel repoioStKpi">
						<Text text="{view>label}" class="repoioStKpiLbl"/>
						<ObjectNumber number="{view>value}" unit="{view>unit}" state="{view>state}" class="repoioStKpiVal"/>
						<Text text="{view>hint}" class="repoioStKpiHint"/>
					</VBox>
				</FlexBox>
				<VBox class="repoioJrPanel repoioStChart">
					<HBox alignItems="Center" justifyContent="SpaceBetween">
						<Title text="{i18n>st.chart}" level="H3"/>
						<Text text="{i18n>st.chartHint}" class="repoioJrHint"/>
					</HBox>
					<rc:EChart id="stChart" height="9rem" ariaLabel="{i18n>st.chart}"/>
				</VBox>
				<Table id="stTable" items="{view>/st/rows}" class="repoioDenseTable repoioStTable" popinLayout="GridSmall" sticky="ColumnHeaders" noDataText="{i18n>st.none}">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="{view>/st/titleN}" level="H2"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column><Text text="{i18n>st.col.stream}"/></Column>
						<Column width="7.5rem"><Text text="{i18n>jr.col.status}"/></Column>
						<Column hAlign="End" width="9rem"><Text text="{i18n>st.col.lag}"/></Column>
						<Column minScreenWidth="Tablet" demandPopin="true" width="9rem"><Text text="{i18n>st.col.checkpoint}"/></Column>
						<Column minScreenWidth="1400px" hAlign="End" width="6rem"><Text text="{i18n>st.col.rate}"/></Column>
						<Column hAlign="End" width="8.5rem"><Text text="{i18n>st.col.dlq}"/></Column>
						<Column minScreenWidth="1400px" hAlign="Center" width="4rem"><Text text="{i18n>domain.owner}"/></Column>
						<Column hAlign="End" width="4.5rem"><Text text="{i18n>jr.col.actions}" class="sapUiInvisibleText"/></Column>
					</columns>
					<items>
						<ColumnListItem highlight="{view>highlight}">
							<VBox>
								<HBox alignItems="Center" renderType="Bare" class="repoioApiOwner">
									<Link text="{view>title}" press=".onOpenRuns" enabled="{= !!${view>job} }" wrapping="false" tooltip="{view>flowTip}"/>
									<Text text="{view>flowText}" class="repoioMono repoioStSub repoioStFlow" textDirection="LTR" wrapping="false" tooltip="{view>flowTip}"/>
								</HBox>
								<HBox items="{path: 'view>stages', templateShareable: false}" alignItems="Center" class="repoioStStages">
									<HBox alignItems="Center" class="repoioStStageWrap">
										<core:Icon src="sap-icon://navigation-right-arrow" class="repoioStArrow" visible="{= !${view>first} }" decorative="true"/>
										<Text text="{view>text}" tooltip="{view>tip}" class="repoioStStage" wrapping="false">
											<customData><core:CustomData key="st" value="{view>state}" writeToDom="true"/></customData>
										</Text>
									</HBox>
								</HBox>
							</VBox>
							<ObjectStatus text="{view>statusText}" state="{view>statusState}" icon="{view>statusIcon}" tooltip="{view>error}"/>
							<VBox alignItems="End">
								<ObjectNumber number="{view>lagText}" state="{view>lagState}" textDirection="LTR"/>
								<Text text="{view>behindText}" class="repoioStSub"/>
							</VBox>
							<Text text="{view>checkpointText}" tooltip="{view>checkpoint}"/>
							<Text text="{view>rateText}" textDirection="LTR"/>
							<VBox alignItems="End">
								<Link text="{view>dlqText}" press=".onOpenDlq" enabled="{= ${view>dlq} > 0 }" class="{= ${view>dlqAlert} ? 'repoioStDlqHot' : '' }"/>
								<Text text="{view>dlqHourText}" class="repoioStSub" visible="{= ${view>dlqHour} > 0 }"/>
							</VBox>
							<rc:PersonLink name="{view>owner}"/>
							<HBox justifyContent="End">
								<Button icon="sap-icon://history" type="Transparent" tooltip="{i18n>st.a.runs}" enabled="{= !!${view>job} }" press=".onOpenRuns"/>
							</HBox>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
