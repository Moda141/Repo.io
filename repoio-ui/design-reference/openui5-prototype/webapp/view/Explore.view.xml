<mvc:View controllerName="repoio.proto.controller.Explore"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:f="sap.f" xmlns:core="sap.ui.core">
	<!-- J2 Explore: catalog-style search (SAP Datasphere Catalog layout): search, facets, results -->
	<f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="{i18n>nav.explore}" level="H1"/></f:heading>
				<f:snappedContent><Text text="{view>/explore/resultText}"/></f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<VBox>
					<SearchField id="exploreSearch" value="{view>/explore/q}" liveChange=".onSearch" search=".onSearch" width="100%"
						placeholder="{i18n>exp.searchPh}" class="repoioBigSearch"/>
					<HBox wrap="Wrap" alignItems="Center" class="sapUiTinyMarginTop">
						<Label text="{i18n>exp.try}" class="sapUiTinyMarginEnd"/>
						<Link text="مكتبة" press=".onTry" class="sapUiSmallMarginEnd"/>
						<Link text="GR-C-000184" press=".onTry" class="sapUiSmallMarginEnd"/>
						<Link text="ISBN" press=".onTry" class="sapUiSmallMarginEnd"/>
						<Link text="مدارس" press=".onTry"/>
					</HBox>
				</VBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<FlexBox wrap="Wrap" alignItems="Start" class="repoioExplore">
				<!-- Facets -->
				<VBox width="16rem" class="repoioFacets sapUiMediumMarginEnd sapUiSmallMarginBottom">
					<HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom">
						<Title text="{i18n>exp.filters}" level="H3"/>
						<Button text="{i18n>exp.clearAll}" type="Transparent" press=".onClearFacets" enabled="{= ${view>/explore/active} > 0 }"/>
					</HBox>
					<VBox items="{path: 'view>/explore/facets', templateShareable: false}">
						<VBox class="repoioFacet">
							<Title text="{view>title}" level="H5" class="sapUiTinyMarginBottom"/>
							<List items="{path: 'view>values', templateShareable: false}" mode="MultiSelect" includeItemInSelection="true" showSeparators="None"
								selectionChange=".onFacetChange" class="repoioFacetList">
								<StandardListItem title="{view>text}" counter="{view>count}" selected="{view>selected}"/>
							</List>
						</VBox>
					</VBox>
				</VBox>

				<!-- Results -->
				<VBox class="repoioResults">
					<OverflowToolbar style="Clear">
						<Title text="{view>/explore/resultText}" level="H2"/>
						<ToolbarSpacer/>
						<Label text="{i18n>exp.sort}" labelFor="expSort"/>
						<Select id="expSort" selectedKey="{view>/explore/sort}" change=".onSort" width="11rem">
							<core:Item key="relevance" text="{i18n>exp.sort.relevance}"/>
							<core:Item key="quality" text="{i18n>exp.sort.quality}"/>
							<core:Item key="merge" text="{i18n>exp.sort.merge}"/>
							<core:Item key="name" text="{i18n>exp.sort.name}"/>
						</Select>
					</OverflowToolbar>
					<IllustratedMessage visible="{= ${view>/explore/items}.length === 0 }" illustrationType="sapIllus-NoData" illustrationSize="Dialog"
						title="{i18n>exp.noResults}" description="{i18n>exp.noResultsHint}"/>
					<List items="{view>/explore/items}" growing="true" growingThreshold="10" showSeparators="All" class="repoioResultList"
						visible="{= ${view>/explore/items}.length > 0 }">
						<CustomListItem type="Navigation" press=".onOpen">
							<HBox alignItems="Start" class="repoioResult">
								<Avatar src="{view>icon}" displaySize="S" backgroundColor="{view>iconColor}" class="sapUiSmallMarginEnd"/>
								<VBox class="repoioResultBody">
									<HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
										<Link text="{view>name}" press=".onOpen" class="repoioIdLink"/>
										<ObjectStatus text="{path: 'view>stateKey', formatter: '.goldenStateText'}" state="{view>state}"/>
									</HBox>
									<Text text="{view>id} · {view>sub}" class="repoioMuted"/>
									<HBox wrap="Wrap" alignItems="Center" class="sapUiTinyMarginTop repoioResultMeta">
										<ObjectAttribute title="{i18n>home.filter.domain}" text="{view>domainName}" class="sapUiMediumMarginEnd"/>
										<ObjectAttribute title="{i18n>repo.repository}" text="{view>repoName}" class="sapUiMediumMarginEnd"/>
										<ObjectAttribute title="{i18n>repo.sources}" text="{view>sourceNames}" class="sapUiMediumMarginEnd"/>
										<ObjectAttribute title="{i18n>domains.col.quality}" text="{path: 'view>quality', formatter: '.fmt.pct'}" class="sapUiMediumMarginEnd"/>
										<ObjectAttribute title="{i18n>repo.matchProb}" text="{path: 'view>prob', formatter: '.fmt.dec'}" class="sapUiMediumMarginEnd"/>
										<ObjectAttribute title="{i18n>repo.lastMerge}" text="{view>lastMerge}"/>
									</HBox>
								</VBox>
							</HBox>
						</CustomListItem>
					</List>
				</VBox>
			</FlexBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
