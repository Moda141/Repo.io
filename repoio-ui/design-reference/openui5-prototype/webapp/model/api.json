			"ops": [
				{
					"m": "GET",
					"p": "/customers",
					"en": "List golden customers (paged, filtered)",
					"ar": "عرض العملاء الذهبيين (صفحات وفلاتر)"
				},
				{
					"m": "GET",
					"p": "/customers/{masterId}",
					"en": "Get one golden customer",
					"ar": "جلب عميل ذهبي واحد"
				},
				{
					"m": "GET",
					"p": "/customers/{masterId}/sources",
					"en": "Source records behind a golden record",
					"ar": "سجلات المصادر وراء السجل الذهبي"
				},
				{
					"m": "GET",
					"p": "/customers/{masterId}/history",
					"en": "Change history",
					"ar": "سجل التغييرات"
				},
				{
					"m": "POST",
					"p": "/change-requests",
					"en": "Submit a change request (governed write path)",
					"ar": "تقديم طلب تغيير (مسار الكتابة المحكوم)"
				}
			]
		},
		{
			"id": "golden-vendor",
