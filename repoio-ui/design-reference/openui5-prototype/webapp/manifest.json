{
	"_version": "1.65.0",
	"sap.app": {
		"id": "repoio.proto",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				"en",
				"ar"
			],
			"fallbackLocale": "en"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "0.1.0"
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "repoio.proto.view.App",
			"type": "XML",
			"id": "app"
		},
		"dependencies": {
			"minUI5Version": "1.136.0",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {},
				"sap.tnt": {},
				"sap.f": {},
				"sap.uxap": {},
				"sap.ui.layout": {},
				"sap.ui.table": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": false
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "repoio.proto.i18n.i18n",
					"async": true,
					"supportedLocales": [
						"en",
						"ar"
					],
					"fallbackLocale": "en"
				}
			},
			"data": {
				"type": "sap.ui.model.json.JSONModel",
				"uri": "model/sample-data.json"
			},
			"nav": {
				"type": "sap.ui.model.json.JSONModel",
				"uri": "model/navigation.json"
			},
			"home": {
				"type": "sap.ui.model.json.JSONModel",
				"uri": "model/home.json"
			},
			"workflows": {
				"type": "sap.ui.model.json.JSONModel",
				"uri": "model/workflows.json"
			},
			"runs": {
				"type": "sap.ui.model.json.JSONModel",
				"uri": "model/runs.json"
			},
			"analytics": {
				"type": "sap.ui.model.json.JSONModel",
				"uri": "model/analytics.json"
			},
			"sync": {
				"type": "sap.ui.model.json.JSONModel",
				"uri": "model/sync.json"
			},
			"admin": {
				"type": "sap.ui.model.json.JSONModel",
				"uri": "model/admin.json"
			},
			"users": {
				"type": "sap.ui.model.json.JSONModel",
				"uri": "model/users.json"
			},
			"api": {
				"type": "sap.ui.model.json.JSONModel",
				"uri": "model/api.json"
			},
			"rules": {
				"type": "sap.ui.model.json.JSONModel",
				"uri": "model/rules.json"
			},
			"apidocs": {
				"type": "sap.ui.model.json.JSONModel",
				"uri": "model/apidocs.json"
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"type": "View",
				"viewType": "XML",
				"path": "repoio.proto.view",
				"controlId": "pageContainer",
				"controlAggregation": "pages",
				"async": true,
				"bypassed": {
					"target": "placeholder"
				}
			},
			"routes": [
				{
					"name": "home",
					"pattern": "",
					"target": "home"
				},
				{
					"name": "domains",
					"pattern": "domains/:item:",
					"target": "domains"
				},
				{
					"name": "connections",
					"pattern": "connections/:conn:",
					"target": "connections"
				},
				{
					"name": "ontology",
					"pattern": "ontology",
					"target": "ontology"
				},
				{
					"name": "workflows",
					"pattern": "workflows",
					"target": "workflows"
				},
				{
					"name": "workflow",
					"pattern": "workflows/new",
					"target": "workflow"
				},
				{
					"name": "jobs",
					"pattern": "jobs/runs",
					"target": "jobs"
				},
				{
					"name": "streams",
					"pattern": "jobs/streams",
					"target": "streams"
				},
				{
					"name": "jobRun",
					"pattern": "jobs/runs/{runId}",
					"target": "jobRun"
				},
				{
					"name": "reports",
					"pattern": "analytics/reports",
					"target": "reports"
				},
				{
					"name": "report",
					"pattern": "analytics/reports/{id}",
					"target": "report"
				},
				{
					"name": "studio",
					"pattern": "analytics/studio/{id}/:mode:",
					"target": "studio"
				},
				{
					"name": "broadcasts",
					"pattern": "analytics/broadcasts:?query:",
					"target": "broadcasts"
				},
				{
					"name": "dataSync",
					"pattern": "integration/sync",
					"target": "dataSync"
				},
				{
					"name": "dataSyncFlow",
					"pattern": "integration/sync/{id}",
					"target": "dataSyncFlow"
				},
				{
					"name": "apiReference",
					"pattern": "integration/api/reference/:api:",
					"target": "apiReference"
				},
				{
					"name": "apiManagement",
					"pattern": "integration/api",
					"target": "apiManagement"
				},
				{
					"name": "users",
					"pattern": "admin/users/:user:",
					"target": "users"
				},
				{
					"name": "roles",
					"pattern": "admin/roles/:role:",
					"target": "roles"
				},
				{
					"name": "system",
					"pattern": "admin/system/:section:",
					"target": "system"
				},
				{
					"name": "announcements",
					"pattern": "admin/announcements/:id:",
					"target": "announcements"
				},
				{
					"name": "audit",
					"pattern": "admin/audit:?query:",
					"target": "audit"
				},
				{
					"name": "models",
					"pattern": "stewardship/models/:model:",
					"target": "models"
				},
				{
					"name": "page",
					"pattern": "page/{key}",
					"target": "placeholder"
				}
			],
			"targets": {
				"home": {
					"id": "home",
					"name": "Home",
					"level": 1
				},
				"domains": {
					"id": "domains",
					"name": "Domains",
					"level": 2
				},
				"models": {
					"id": "models",
					"name": "ModelsRules",
					"level": 2
				},
				"placeholder": {
					"id": "placeholder",
					"name": "Placeholder",
					"level": 2
				},
				"workflow": {
					"id": "workflow",
					"name": "WorkflowDesigner",
					"level": 2
				},
				"ontology": {
					"id": "ontology",
					"name": "Ontology",
					"level": 2
				},
				"connections": {
					"id": "connections",
					"name": "Connections",
					"level": 1
				},
				"workflows": {
					"id": "workflows",
					"name": "WorkflowsList",
					"level": 2
				},
				"jobs": {
					"id": "jobs",
					"name": "JobRuns",
					"level": 2
				},
				"streams": {
					"id": "streams",
					"name": "Streams",
					"level": 2
				},
				"jobRun": {
					"id": "jobRun",
					"name": "JobRun",
					"level": 3
				},
				"reports": {
					"id": "reports",
					"name": "ReportsList",
					"level": 2
				},
				"report": {
					"id": "report",
					"name": "Report",
					"level": 3
				},
				"studio": {
					"id": "studio",
					"name": "Studio",
					"level": 3
				},
				"broadcasts": {
					"id": "broadcasts",
					"name": "Broadcasts",
					"level": 2
				},
				"dataSync": {
					"id": "dataSync",
					"name": "DataSyncList",
					"level": 2
				},
				"dataSyncFlow": {
					"id": "dataSyncFlow",
					"name": "DataSync",
					"level": 3
				},
				"system": {
					"id": "system",
					"name": "SystemConfig",
					"level": 2
				},
				"announcements": {
					"id": "announcements",
					"name": "Announcements",
					"level": 2
				},
				"audit": {
					"id": "audit",
					"name": "AuditLog",
					"level": 2
				},
				"users": {
					"id": "users",
					"name": "UserManagement",
					"level": 2
				},
				"roles": {
					"id": "roles",
					"name": "RolesAccess",
					"level": 2
				},
				"apiManagement": {
					"id": "apiManagement",
					"name": "ApiManagement",
					"level": 2
				},
				"apiReference": {
					"id": "apiReference",
					"name": "ApiReference",
					"level": 3
				}
			}
		}
	}
}
