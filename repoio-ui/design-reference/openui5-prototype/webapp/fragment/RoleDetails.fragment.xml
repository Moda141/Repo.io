<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form" xmlns:rc="repoio.proto.control">
	<!-- Business role: General · Domain grants · Assigned users · Assigned org units (SAP IBP Maintain Business Roles) -->
	<Dialog id="raDlg" contentWidth="50rem" contentHeight="32rem" showHeader="false" class="repoioUmDlg repoioUmUserDlg">
		<content>
			<VBox renderType="Bare" class="repoioUmUserHead">
				<HBox alignItems="Center" renderType="Bare">
					<Avatar src="{view>/ra/d/icon}" displaySize="M" displayShape="Square" backgroundColor="Accent6"/>
					<VBox renderType="Bare" class="repoioUmUserWho">
						<Title text="{view>/ra/d/text}" level="H2"/>
						<HBox renderType="Bare" alignItems="Center" class="repoioRaIdRow">
							<Text text="{view>/ra/d/id}" class="repoioMono repoioUmMuted"/>
							<ObjectStatus text="{view>/ra/d/typeText}" state="{view>/ra/d/typeState}" class="sapUiSmallMarginBegin"/>
						</HBox>
					</VBox>
					<VBox renderType="Bare" alignItems="End" class="repoioUmUserLink">
						<ObjectStatus text="{view>/ra/d/assignText}" icon="{view>/ra/d/assignIcon}" state="{view>/ra/d/assignState}" inverted="true"/>
						<HBox renderType="Bare" class="repoioRaHeadBtns">
							<Button text="{i18n>ra.copy}" icon="sap-icon://copy" type="Transparent" press=".onCopyRole"/>
							<Button text="{i18n>common.delete}" icon="sap-icon://delete" type="Transparent" press=".onDeleteRole" visible="{= !${view>/ra/d/delivered} }" enabled="{= ${view>/ra/d/users}.length === 0 }" tooltip="{view>/ra/d/deleteTip}"/>
						</HBox>
					</VBox>
				</HBox>
			</VBox>
			<IconTabBar selectedKey="{view>/ra/d/tab}" expandable="false" headerMode="Inline" applyContentPadding="false" class="repoioUmUserTabs">
				<items>
					<IconTabFilter key="general" text="{i18n>um.ud.general}">
						<f:SimpleForm editable="false" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" labelSpanS="12" columnsL="1" columnsM="1" class="repoioUmForm">
							<Label text="{i18n>ra.col.desc}"/><Text text="{view>/ra/d/desc}"/>
							<Label text="{i18n>um.col.domains}"/><Text text="{view>/ra/d/domainsText}"/>
							<Label text="{i18n>ra.col.assignable}"/><Text text="{view>/ra/d/assignNote}"/>
							<Label text="{i18n>ra.col.users}"/><Text text="{view>/ra/d/usersText}"/>
						</f:SimpleForm>
					</IconTabFilter>
					<IconTabFilter key="perms" text="{i18n>ra.tab.perms}" count="{view>/ra/d/permCount}">
						<MessageStrip text="{i18n>ra.perm.delivered}" type="Information" showIcon="true" visible="{view>/ra/d/delivered}" class="sapUiSmallMargin"/>
						<VBox items="{view>/ra/d/pgroups}" renderType="Bare" class="repoioRaPerms">
							<VBox renderType="Bare" class="repoioRaPermGroup">
								<Title text="{view>title}" level="H5"/>
								<VBox items="{path: 'view>perms', templateShareable: false}" renderType="Bare">
									<HBox alignItems="Center" renderType="Bare">
										<CheckBox text="{view>text}" selected="{view>on}" enabled="{= !${view>/ra/d/delivered} }" select=".onPerm"/>
										<core:Icon src="sap-icon://locked" visible="{view>sensitive}" tooltip="{i18n>ra.perm.sensitiveTip}" class="repoioUmLock"/>
									</HBox>
								</VBox>
							</VBox>
						</VBox>
					</IconTabFilter>
					<IconTabFilter key="domains" text="{i18n>ra.tab.domains}" count="{view>/ra/d/domCount}">
						<VBox class="sapUiSmallMargin" renderType="Bare">
							<Text text="{i18n>ra.dom.hint}" class="repoioUmMuted sapUiTinyMarginBottom"/>
							<MessageStrip text="{i18n>ra.perm.delivered}" type="Information" showIcon="true" visible="{view>/ra/d/delivered}" class="sapUiTinyMarginBottom"/>
							<CheckBox text="{i18n>ra.allDomains}" selected="{view>/ra/d/all}" select=".onDomainsAll" enabled="{= !${view>/ra/d/delivered} }"/>
							<VBox items="{view>/ra/d/domains}" renderType="Bare" class="repoioRaDoms">
								<CheckBox text="{view>text}" selected="{view>on}" enabled="{= !${view>/ra/d/all} &amp;&amp; !${view>/ra/d/delivered} }" select=".onDomain"/>
							</VBox>
						</VBox>
					</IconTabFilter>
					<IconTabFilter key="users" text="{i18n>ra.tab.users}" count="{= ${view>/ra/d/users}.length }">
						<Table items="{view>/ra/d/users}" class="repoioDenseTable" noDataText="{i18n>ra.noUsers}">
							<headerToolbar>
								<OverflowToolbar>
									<Text text="{i18n>ra.users.hint}" class="repoioUmMuted"/>
									<ToolbarSpacer/>
									<Button text="{i18n>ra.addUsers}" icon="sap-icon://add" type="Transparent" press=".onAddUsers"/>
								</OverflowToolbar>
							</headerToolbar>
							<columns>
								<Column><Text text="{i18n>um.col.user}"/></Column>
								<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>um.col.unit}"/></Column>
								<Column width="14rem"><Text text="{i18n>um.col.via}"/></Column>
								<Column width="3rem" hAlign="End"><Text text="{i18n>common.delete}" class="sapUiInvisibleText"/></Column>
							</columns>
							<items>
								<ColumnListItem>
									<HBox alignItems="Center" renderType="Bare" class="repoioUmWho">
										<rc:PersonLink name="{view>name}"/>
										<Link text="{view>nameText}" press=".onUser" wrapping="false" class="repoioUmName"/>
									</HBox>
									<HBox alignItems="Center" renderType="Bare">
										<Text text="{view>unitText}" wrapping="false"/>
										<ObjectStatus text="{view>statusText}" state="{view>statusState}" visible="{view>blocked}" class="sapUiTinyMarginBegin"/>
									</HBox>
									<ObjectStatus text="{view>viaText}" state="{view>viaState}" icon="{view>viaIcon}"/>
									<Button icon="sap-icon://decline" type="Transparent" tooltip="{i18n>um.ud.removeRole}" press=".onRemoveUser" visible="{= ${view>type} === 'direct' }"/>
								</ColumnListItem>
							</items>
						</Table>
					</IconTabFilter>
					<IconTabFilter key="units" text="{i18n>ra.tab.units}" count="{= ${view>/ra/d/units}.length }">
						<MessageStrip text="{i18n>ra.units.sensitive}" type="Warning" showIcon="true" visible="{view>/ra/d/sensitive}" class="sapUiSmallMargin"/>
						<Table items="{view>/ra/d/units}" class="repoioDenseTable" noDataText="{i18n>ra.noUnits}" visible="{= !${view>/ra/d/sensitive} }">
							<headerToolbar>
								<OverflowToolbar>
									<Text text="{i18n>ra.units.hint}" class="repoioUmMuted"/>
									<ToolbarSpacer/>
									<Button text="{i18n>ra.addUnits}" icon="sap-icon://add" type="Transparent" press=".onAddUnits"/>
								</OverflowToolbar>
							</headerToolbar>
							<columns>
								<Column><Text text="{i18n>ra.col.unit}"/></Column>
								<Column width="9rem"><Text text="{i18n>ra.col.type}"/></Column>
								<Column width="7rem" hAlign="End"><Text text="{i18n>ra.col.people}"/></Column>
								<Column width="3rem" hAlign="End"><Text text="{i18n>common.delete}" class="sapUiInvisibleText"/></Column>
							</columns>
							<items>
								<ColumnListItem>
									<HBox alignItems="Center" renderType="Bare">
										<core:Icon src="{view>icon}" class="repoioExRowIcon"/>
										<Link text="{view>text}" press=".onUnit" wrapping="false" tooltip="{view>path}"/>
									</HBox>
									<Text text="{view>typeText}"/>
									<Text text="{view>people}"/>
									<Button icon="sap-icon://decline" type="Transparent" tooltip="{i18n>ra.removeUnit}" press=".onRemoveUnit"/>
								</ColumnListItem>
							</items>
						</Table>
					</IconTabFilter>
					<IconTabFilter key="history" text="{i18n>um.ud.history}">
						<List items="{view>/ra/d/history}" noDataText="{i18n>um.ud.noHistory}" showSeparators="Inner" class="repoioUmHist">
							<StandardListItem title="{view>text}" description="{view>meta}" icon="{view>icon}" wrapping="true"/>
						</List>
					</IconTabFilter>
				</items>
			</IconTabBar>
		</content>
		<endButton><Button text="{i18n>common.close}" press=".onClose"/></endButton>
	</Dialog>

	<!-- Create role: blank or a copy; permissions come from the fixed catalog the server defines.
	     A role with any sensitive permission becomes user-only (never on a department or team). -->
	<Dialog id="raNewDlg" title="{view>/ra/n/title}" contentWidth="44rem" contentHeight="34rem" class="repoioUmDlg">
		<content>
			<VBox renderType="Bare" class="sapUiSmallMargin">
				<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="3" labelSpanM="3" labelSpanS="12" columnsL="1" columnsM="1">
					<Label text="{i18n>ra.n.start}"/>
					<HBox alignItems="Center" renderType="Bare" class="repoioRaStart">
						<SegmentedButton selectedKey="{view>/ra/n/mode}" selectionChange=".onNewMode">
							<items>
								<SegmentedButtonItem key="blank" text="{i18n>ra.n.blank}"/>
								<SegmentedButtonItem key="copy" text="{i18n>ra.n.copyOf}"/>
							</items>
						</SegmentedButton>
						<Select selectedKey="{view>/ra/n/from}" items="{view>/ra/n/roles}" change=".onNewFrom" enabled="{= ${view>/ra/n/mode} === 'copy' }" width="15rem" class="sapUiSmallMarginBegin">
							<core:Item key="{view>key}" text="{view>text}"/>
						</Select>
					</HBox>
					<Label text="{i18n>ra.n.nameEn}" required="true"/>
					<Input value="{view>/ra/n/en}" liveChange=".onNewName" textDirection="LTR" valueState="{view>/ra/n/vs/en}"/>
					<Label text="{i18n>ra.n.nameAr}" required="true"/>
					<Input value="{view>/ra/n/ar}" textDirection="RTL" valueState="{view>/ra/n/vs/ar}"/>
					<Label text="{i18n>ra.n.id}" required="true"/>
					<Input value="{view>/ra/n/id}" liveChange=".onNewId" textDirection="LTR" class="repoioMono" valueState="{view>/ra/n/vs/id}" valueStateText="{view>/ra/n/idMsg}"/>
					<Label text="{i18n>ra.n.descEn}"/>
					<Input value="{view>/ra/n/desc_en}" textDirection="LTR"/>
					<Label text="{i18n>ra.n.descAr}"/>
					<Input value="{view>/ra/n/desc_ar}" textDirection="RTL"/>
					<Label text="{i18n>um.col.domains}" required="true"/>
					<VBox renderType="Bare">
						<CheckBox text="{i18n>ra.allDomains}" selected="{view>/ra/n/all}"/>
						<HBox wrap="Wrap" items="{view>/ra/n/domains}" renderType="Bare" class="repoioRaNewDoms">
							<CheckBox text="{view>text}" selected="{view>on}" enabled="{= !${view>/ra/n/all} }"/>
						</HBox>
					</VBox>
				</f:SimpleForm>
				<Title text="{i18n>ra.tab.perms}" level="H4" class="sapUiSmallMarginTop sapUiTinyMarginBottom"/>
				<MessageStrip text="{i18n>ra.n.sensitive}" type="Warning" showIcon="true" visible="{view>/ra/n/sensitive}" class="sapUiTinyMarginBottom"/>
				<VBox items="{view>/ra/n/pgroups}" renderType="Bare" class="repoioRaPerms">
					<VBox renderType="Bare" class="repoioRaPermGroup">
						<Title text="{view>title}" level="H5"/>
						<VBox items="{path: 'view>perms', templateShareable: false}" renderType="Bare">
							<HBox alignItems="Center" renderType="Bare">
								<CheckBox text="{view>text}" selected="{view>on}" select=".onNewPerm"/>
								<core:Icon src="sap-icon://locked" visible="{view>sensitive}" tooltip="{i18n>ra.perm.sensitiveTip}" class="repoioUmLock"/>
							</HBox>
						</VBox>
					</VBox>
				</VBox>
			</VBox>
		</content>
		<beginButton><Button text="{i18n>ra.n.create}" type="Emphasized" press=".onNewSave"/></beginButton>
		<endButton><Button text="{i18n>common.cancel}" press=".onNewCancel"/></endButton>
	</Dialog>
</core:FragmentDefinition>
