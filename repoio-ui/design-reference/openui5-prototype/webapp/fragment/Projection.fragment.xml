<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:rc="repoio.proto.control">
	<!-- Projection of one replication object (Datasphere: one projection per object): a name, row filters,
	     and the mapping of source columns to the target entity's model fields (from the repository's model version). -->
	<Dialog id="pjDialog" title="{view>/pj/title}" contentWidth="62rem" contentHeight="34rem" resizable="true" draggable="true" verticalScrolling="false" class="repoioPjDialog">
		<subHeader>
			<Toolbar class="repoioPjHead">
				<Label text="{i18n>ds.pj.name}" labelFor="pjName" required="true"/>
				<Input id="pjName" value="{view>/pj/name}" width="16rem" class="repoioMono" valueLiveUpdate="true" liveChange=".onPjCheck"/>
				<ToolbarSpacer/>
				<core:Icon src="sap-icon://table-view"/>
				<Text text="{view>/pj/srcName}" class="repoioMono"/>
				<core:Icon src="sap-icon://arrow-right" color="#0a6ed1"/>
				<core:Icon src="sap-icon://dimension"/>
				<Text text="{view>/pj/tgtName}" class="repoioMono"/>
			</Toolbar>
		</subHeader>
		<content>
			<IconTabBar selectedKey="{view>/pj/tab}" expandable="false" headerMode="Inline" stretchContentHeight="true" applyContentPadding="false" class="repoioPjTabs">
				<items>
					<IconTabFilter key="filters" text="{i18n>ds.pj.filtersT}" count="{view>/pj/filtersCount}">
						<VBox class="repoioPjBody">
							<HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
								<Text text="{i18n>ds.pj.filtersHint}" class="repoioExSub"/>
								<Button text="{i18n>ds.pj.addFilter}" icon="sap-icon://add" type="Transparent" press=".onPjAddFilter"/>
							</HBox>
							<Table items="{view>/pj/filters}" class="repoioDenseTable" noDataText="{i18n>ds.pj.noFilters}" fixedLayout="false">
								<columns>
									<Column><Text text="{i18n>ds.pj.column}"/></Column>
									<Column width="11rem"><Text text="{i18n>ds.pj.op}"/></Column>
									<Column><Text text="{i18n>ds.pj.value}"/></Column>
									<Column width="2.5rem"/>
								</columns>
								<items>
									<ColumnListItem>
										<Select selectedKey="{view>col}" items="{path: 'view>/pj/cols', templateShareable: false}" width="100%" forceSelection="false" change=".onPjCheck">
											<core:ListItem key="{view>name}" text="{view>name}" additionalText="{view>label}"/>
										</Select>
										<Select selectedKey="{view>op}" width="100%">
											<core:Item key="eq" text="{i18n>ds.op.eq}"/>
											<core:Item key="ne" text="{i18n>ds.op.ne}"/>
											<core:Item key="in" text="{i18n>ds.op.in}"/>
											<core:Item key="notIn" text="{i18n>ds.op.notIn}"/>
										</Select>
										<Input value="{view>val}" placeholder="{i18n>ds.pj.valuePh}" textDirection="LTR" valueLiveUpdate="true" liveChange=".onPjCheck"/>
										<Button icon="sap-icon://decline" type="Transparent" press=".onPjRemoveFilter" tooltip="{i18n>common.delete}"/>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>
					</IconTabFilter>
					<IconTabFilter key="mapping" text="{i18n>ds.pj.mappingT}" count="{view>/pj/mapCount}">
						<VBox class="repoioPjBody">
							<MessageStrip text="{view>/pj/missing}" type="Error" showIcon="true" visible="{= !!${view>/pj/missing} }" class="sapUiTinyMarginBottom"/>
							<rc:FieldMapper id="pjMapper" source="{view>/pj/src}" target="{view>/pj/tgt}" mapping="{path: 'view>/pj/mapping', mode: 'OneWay'}"
								texts="{view>/pj/texts}" change=".onPjMapping" transform=".onPjTransform"/>
						</VBox>
					</IconTabFilter>
				</items>
			</IconTabBar>
		</content>
		<beginButton>
			<Button text="{i18n>common.apply}" type="Emphasized" press=".onPjApply" enabled="{view>/pj/valid}"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>common.cancel}" press=".onPjCancel"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
