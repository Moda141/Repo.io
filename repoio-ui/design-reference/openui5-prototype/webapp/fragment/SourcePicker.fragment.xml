<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<!-- Datasphere "Select Source Connection" / "Select Source Container" / "Select Target Connection":
	     a search field over a table of technical name, business name, type and description. -->
	<Dialog id="spDialog" title="{view>/sp/title}" contentWidth="48rem" contentHeight="22rem" class="repoioSpDialog" afterClose=".onSpAfterClose">
		<subHeader>
			<Toolbar>
				<SearchField value="{view>/sp/q}" liveChange=".onSpSearch" placeholder="{i18n>common.search}" width="100%"/>
			</Toolbar>
		</subHeader>
		<content>
			<Table id="spList" items="{view>/sp/rows}" mode="SingleSelectMaster" selectionChange=".onSpSelect" class="repoioDenseTable" noDataText="{i18n>ds.sp.noData}" sticky="ColumnHeaders">
				<columns>
					<Column><Text text="{i18n>dsp.technicalName}"/></Column>
					<Column><Text text="{i18n>dsp.businessName}"/></Column>
					<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>ds.sp.type}"/></Column>
					<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>ds.sp.desc}"/></Column>
				</columns>
				<items>
					<ColumnListItem>
						<HBox alignItems="Center">
							<core:Icon src="{view>icon}" class="repoioExRowIcon"/>
							<Text text="{view>id}" class="repoioSpName" wrapping="false"/>
						</HBox>
						<Text text="{view>name}" wrapping="false"/>
						<Text text="{view>type}" wrapping="false"/>
						<ObjectStatus text="{view>sub}" state="{view>state}" icon="{view>stateIcon}"/>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<beginButton>
			<Button text="{i18n>ds.sp.select}" type="Emphasized" enabled="{= !!${view>/sp/sel} }" press=".onSpConfirm"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>common.cancel}" press=".onSpCancel"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
