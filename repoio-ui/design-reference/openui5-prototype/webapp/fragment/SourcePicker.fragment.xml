<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<!-- Compact picker dialog (Datasphere "Select Source Connection", "Select Source Container", "Select Target"):
	     search + one-line rows. The rows and the confirm handler come from the controller (/sp). -->
	<Dialog id="spDialog" title="{view>/sp/title}" contentWidth="30rem" verticalScrolling="true" class="repoioSpDialog" afterClose=".onSpAfterClose">
		<subHeader>
			<Toolbar>
				<SearchField value="{view>/sp/q}" liveChange=".onSpSearch" placeholder="{i18n>common.search}" width="100%"/>
			</Toolbar>
		</subHeader>
		<content>
			<List id="spList" items="{view>/sp/rows}" mode="SingleSelectMaster" selectionChange=".onSpSelect" showSeparators="Inner" class="repoioSpList" noDataText="{i18n>ds.sp.noData}">
				<CustomListItem>
					<HBox alignItems="Center" class="repoioSpItem">
						<Image src="{view>logo}" width="1.5rem" height="1.5rem" class="repoioSpLogo" visible="{= !!${view>logo} }"/>
						<core:Icon src="{view>icon}" size="1.25rem" class="repoioSpLogo" visible="{= !${view>logo} }"/>
						<VBox class="repoioSpText">
							<Text text="{view>name}" wrapping="false" class="repoioSpName"/>
							<Text text="{view>sub}" wrapping="false" class="repoioExSub"/>
						</VBox>
						<ObjectStatus icon="{view>stateIcon}" state="{view>state}" tooltip="{view>stateText}" visible="{= !!${view>stateIcon} }"/>
					</HBox>
				</CustomListItem>
			</List>
		</content>
		<beginButton>
			<Button text="{i18n>ds.sp.select}" type="Emphasized" enabled="{= !!${view>/sp/sel} }" press=".onSpConfirm"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>common.cancel}" press=".onSpCancel"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
