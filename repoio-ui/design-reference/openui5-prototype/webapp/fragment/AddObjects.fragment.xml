<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<!-- Datasphere "Select Source Objects": Available (container tree + objects) → Next → Selection
	     (location, status) → Add Selection. -->
	<Dialog id="aoDialog" title="{i18n>ds.ao.title}" contentWidth="56rem" contentHeight="26rem" class="repoioSpDialog repoioAoDialog" verticalScrolling="false">
		<subHeader>
			<Toolbar>
				<Text text="{view>/ao/searchIn}" class="repoioExSub"/>
				<ToolbarSpacer/>
				<SegmentedButton selectedKey="{= ${view>/ao/step} === 2 ? 'sel' : 'avail' }" selectionChange=".onAoTab">
					<items>
						<SegmentedButtonItem key="avail" text="{i18n>ds.ao.available}"/>
						<SegmentedButtonItem key="sel" text="{view>/ao/selectionText}"/>
					</items>
				</SegmentedButton>
			</Toolbar>
		</subHeader>
		<content>
			<NavContainer id="aoNav" height="100%">
				<Page id="aoPick" showHeader="false">
					<HBox height="100%" renderType="Bare" class="repoioAoSplit">
						<VBox class="repoioAoTree" renderType="Bare">
							<SearchField value="{view>/ao/q}" liveChange=".onAoSearch" placeholder="{view>/ao/searchPh}" width="100%"/>
							<List mode="SingleSelectMaster" showSeparators="None" class="repoioAoTreeList">
								<StandardListItem title="{view>/ao/container}" icon="sap-icon://folder-blank" selected="true"/>
							</List>
						</VBox>
						<VBox class="repoioAoObjs" renderType="Bare">
							<Text text="{view>/ao/countText}" class="repoioExSub repoioAoCount"/>
							<Table id="aoTable" items="{view>/ao/rows}" mode="MultiSelect" selectionChange=".onAoSelect" class="repoioDenseTable" noDataText="{i18n>ds.t.noMoreObjects}">
								<columns>
									<Column><Text text="{i18n>dsp.technicalName}"/></Column>
									<Column width="9rem"><Text text="{i18n>ds.sp.type}"/></Column>
									<Column width="6rem" hAlign="End"><Text text="{i18n>ds.colsT}"/></Column>
								</columns>
								<items>
									<ColumnListItem>
										<HBox alignItems="Center"><core:Icon src="sap-icon://table-view" class="repoioExRowIcon"/><Text text="{view>name}"/></HBox>
										<Text text="{view>type}"/>
										<Text text="{view>cols}"/>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>
					</HBox>
				</Page>
				<Page id="aoReview" showHeader="false">
					<Table items="{view>/ao/picked}" class="repoioDenseTable">
						<columns>
							<Column><Text text="{i18n>dsp.technicalName}"/></Column>
							<Column width="8rem"><Text text="{i18n>ds.sp.type}"/></Column>
							<Column><Text text="{i18n>ds.ao.location}"/></Column>
							<Column><Text text="{i18n>ds.col.tgtObj}"/></Column>
							<Column width="7rem"><Text text="{i18n>domains.col.status}"/></Column>
						</columns>
						<items>
							<ColumnListItem>
								<Text text="{view>name}"/>
								<Text text="{view>type}"/>
								<Text text="{view>location}" class="repoioMono" wrapping="false"/>
								<Text text="{view>target}"/>
								<ObjectStatus text="{i18n>ds.ao.ready}" state="Success" inverted="true"/>
							</ColumnListItem>
						</items>
					</Table>
				</Page>
			</NavContainer>
		</content>
		<buttons>
			<Button text="{i18n>ds.ao.next}" type="Emphasized" press=".onAoNext" visible="{= ${view>/ao/step} === 1 }" enabled="{= ${view>/ao/count} > 0 }"/>
			<Button text="{i18n>ds.ao.add}" type="Emphasized" press=".onAoAdd" visible="{= ${view>/ao/step} === 2 }"/>
			<Button text="{i18n>common.cancel}" press=".onAoCancel"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>
