<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.nahdetmisr.repoio</groupId>
  <artifactId>platform</artifactId>
  <name>Repoio-Platform</name>
  <description>
    Repo.io is a Master Data Management platform for customer, vendor and product
    golden records. Built on the OpenMetadata foundation.
  </description>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <url>https://github.com/Moda141/Repo.io</url>

  <modules>
    <module>repoio-spec</module>
    <module>repoio-sdk</module>
    <module>common</module>
    <module>docker/rdf-store</module>
    <module>repoio-shaded-deps</module>
    <module>repoio-service</module>
    <module>repoio-k8s-operator</module>
    <module>repoio-integration-tests</module>
    <module>repoio-mcp</module>
    <module>repoio-ui-core-components</module>
    <module>repoio-ui</module>
    <module>repoio-dist</module>
    <module>repoio-clients</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
</project>
